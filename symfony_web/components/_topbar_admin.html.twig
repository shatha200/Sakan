<header class="sakan-topbar">
  <div class="topbar-search">
    <i class="fa-solid fa-magnifying-glass" style="color: var(--text-muted)"></i>
    <input type="text" placeholder="Rechercher (biens, utilisateurs...)">
  </div>
  
  <div class="topbar-actions">
    <button class="icon-btn">
      <i class="fa-solid fa-bell"></i>
      <span style="position: absolute; top: -5px; right: -5px; background: var(--danger); width: 8px; height: 8px; border-radius: 50%;"></span>
    </button>
    
    <div class="user-profile">
      <img src="https://i.pravatar.cc/150?img=1" alt="Avatar Admin">
      <span>Sami Ben Ali <i class="fa-solid fa-caret-down" style="font-size: 12px; margin-left: 4px;"></i></span>
    </div>
  </div>
</header>
