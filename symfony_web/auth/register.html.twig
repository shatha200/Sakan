<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sakan — Créer un compte</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <link rel="stylesheet" href="../../css_web/sakan-global.css">
  <link rel="stylesheet" href="../../css_web/sakan-auth.css">
</head>
<body>
  <div class="auth-wrapper">
    <!-- GAUCHE -->
    <div class="auth-left">
      <div class="brand-title">
        <i class="fa-solid fa-house" style="color: var(--primary); font-size: 28px;"></i> Sakan
      </div>
      
      <h1 class="auth-title">Créer un compte</h1>
      <p class="muted">Tous les champs marqués * sont obligatoires.</p>
      
      <form class="auth-form-card" id="registerForm">
        
        <div class="role-toggle">
          <button type="button" class="role-btn active" onclick="setRole('LOCATAIRE', this)">
            <i class="fa-solid fa-key"></i> Locataire
          </button>
          <button type="button" class="role-btn" onclick="setRole('OWNER', this)">
            <i class="fa-solid fa-building"></i> Propriétaire
          </button>
        </div>
        <input type="hidden" id="role" value="LOCATAIRE">

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
          <div class="auth-input-wrapper">
            <input type="text" id="prenom" placeholder="Prénom*" required>
          </div>
          <div class="auth-input-wrapper">
            <input type="text" id="nom" placeholder="Nom*" required>
          </div>
        </div>
        
        <div class="auth-input-wrapper">
          <i class="fa-solid fa-envelope input-icon"></i>
          <input type="email" id="email" placeholder="Email*" required>
        </div>

        <div class="auth-input-wrapper">
          <i class="fa-solid fa-phone input-icon"></i>
          <input type="text" id="telephone" placeholder="+216 XX XXX XXX" required>
        </div>
        
        <div class="auth-input-wrapper">
          <i class="fa-solid fa-lock input-icon"></i>
          <input type="password" id="password" placeholder="Mot de passe*" required>
          <i class="fa-solid fa-eye input-icon" style="cursor: pointer; margin-right: 0; margin-left: 12px;"></i>
        </div>

        <div class="auth-input-wrapper">
          <i class="fa-solid fa-lock input-icon"></i>
          <input type="password" id="passwordConfirm" placeholder="Confirmer Mot de passe*" required>
          <i class="fa-solid fa-eye input-icon" style="cursor: pointer; margin-right: 0; margin-left: 12px;"></i>
        </div>
        
        <label style="display: flex; align-items: start; gap: 8px; font-weight: 500; font-size: 14px; cursor: pointer; margin-top: 8px;">
          <input type="checkbox" required style="margin-top: 4px;"> 
          <span>J'accepte les <a href="#">conditions générales</a> et la <a href="#">politique de confidentialité</a></span>
        </label>
        
        <button type="submit" class="btn-sakan-primary">Créer mon compte &rarr;</button>
        
        <div class="auth-divider">ou</div>
        
        <button type="button" class="btn-google">
          <svg viewBox="0 0 24 24" width="20" height="20" xmlns="http://www.w3.org/2000/svg">
            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
          </svg>
          Continuer avec Google
        </button>
        
        <p style="text-align: center; margin-top: 20px; font-weight: 500;">
          Déjà un compte ? <a href="login.html">Se connecter</a>
        </p>
      </form>
    </div>
    
    <!-- DROITE -->
    <div class="auth-right">
      <h1 class="hero-title">Rejoignez la communauté</h1>
      <p class="hero-subtitle">Location longue durée & colocation en toute confiance</p>
      
      <svg width="240" height="240" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" style="opacity: 0.8;">
        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
        <polyline points="9 22 9 12 15 12 15 22"></polyline>
      </svg>
    </div>
  </div>

  <script>
    function setRole(role, btnElement) {
      document.getElementById('role').value = role;
      document.querySelectorAll('.role-btn').forEach(btn => btn.classList.remove('active'));
      btnElement.classList.add('active');
    }

    document.getElementById('registerForm').addEventListener('submit', function(e) {
      e.preventDefault();
      window.location.href = '../locataire/catalogue.html';
    });
  </script>
</body>
</html>
