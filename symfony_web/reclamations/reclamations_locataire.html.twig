<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Sakan — Service Client</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <link rel="stylesheet" href="../../css_web/sakan-global.css">
  <link rel="stylesheet" href="../../css_web/sakan-locataire.css">
  <link rel="stylesheet" href="../../css_web/sakan-components.css">
</head>
<body>
<div class="sakan-layout">

  <!-- SIDEBAR -->
  <nav class="sakan-sidebar" id="sidebar-locataire">
    <div class="sidebar-logo">
      <i class="fa-solid fa-house"></i> <span class="logo-text">Sakan</span>
    </div>
    <ul class="sidebar-menu">
      <li><a href="../locataire/catalogue.html"><i class="fa-solid fa-magnifying-glass"></i> Explorer les biens</a></li>
      <li><a href="../locataire/mes_visites.html"><i class="fa-solid fa-calendar-check"></i> Mes visites</a></li>
      <li><a href="../locataire/mes_reservations.html"><i class="fa-solid fa-check"></i> Mes réservations</a></li>
      <li><a href="../locataire/mes_contrats.html"><i class="fa-solid fa-file-contract"></i> Mes contrats</a></li>
      <li><a href="../paiement/finances.html"><i class="fa-solid fa-coins"></i> Espace financier</a></li>
      <li><a href="reclamations_locataire.html" class="active"><i class="fa-solid fa-shield-halved"></i> Service client</a></li>
      <li><a href="../locataire/mon_profil.html"><i class="fa-solid fa-user"></i> Mon profil</a></li>
    </ul>
    <div class="sidebar-footer">
      <a href="../auth/login.html">
        <i class="fa-solid fa-right-from-bracket"></i> Déconnexion
      </a>
    </div>
  </nav>

  <main class="sakan-main">
    <div class="sakan-content">

      <!-- PAGE HEADER -->
      <div class="page-header" style="justify-content: space-between; align-items: center;">
        <div>
          <h1 style="display:flex; align-items:center; gap:12px;"><i class="fa-solid fa-headset"></i> Service Client</h1>
          <p class="result-count" style="margin-top: 4px;">Signalez un problème et suivez vos tickets</p>
        </div>
        <button class="btn-primary" onclick="showModal('modal-new-reclamation')">
          <i class="fa-solid fa-plus"></i> Nouveau ticket
        </button>
      </div>

      <!-- STATS TICKETS RAPIDES -->
      <div style="display:grid;grid-template-columns:repeat(3,1fr); gap:16px;margin-bottom:24px;">
        <div class="kpi-card" style="border-left:4px solid #dc2626;">
          <div class="kpi-icon" style="margin-bottom:0;"><i class="fa-solid fa-circle-exclamation" style="color:#dc2626; font-size: 32px;"></i></div>
          <div class="kpi-body" style="margin-top:16px;">
            <div class="kpi-label">En cours</div>
            <div class="kpi-montant" style="font-size:28px;">1</div>
          </div>
        </div>
        <div class="kpi-card" style="border-left:4px solid #16a34a;">
          <div class="kpi-icon" style="margin-bottom:0;"><i class="fa-solid fa-circle-check" style="color:#16a34a; font-size: 32px;"></i></div>
          <div class="kpi-body" style="margin-top:16px;">
            <div class="kpi-label">Résolus</div>
            <div class="kpi-montant" style="font-size:28px;">1</div>
          </div>
        </div>
        <div class="kpi-card" style="border-left:4px solid #2563eb;">
          <div class="kpi-icon" style="margin-bottom:0;"><i class="fa-solid fa-ticket" style="color:#2563eb; font-size: 32px;"></i></div>
          <div class="kpi-body" style="margin-top:16px;">
            <div class="kpi-label">Total tickets</div>
            <div class="kpi-montant" style="font-size:28px;">3</div>
          </div>
        </div>
      </div>

      <!-- ONGLETS -->
      <div class="section-tabs">
        <button class="tab-btn active" onclick="filterTickets('all')">Tous (3)</button>
        <button class="tab-btn" onclick="filterTickets('en-cours')">En cours (1)</button>
        <button class="tab-btn" onclick="filterTickets('resolu')">Résolus (1)</button>
        <button class="tab-btn" onclick="filterTickets('ouvert')">Ouverts (1)</button>
      </div>

      <!-- LISTE DES TICKETS -->
      <div class="tickets-list">

        <!-- TICKET RCL-01 — EN COURS -->
        <div class="reclamation-card priorite-haute" data-statut="en-cours" style="border-left:4px solid #dc2626;">
          <div class="ticket-header">
            <div>
              <span class="ticket-id">#RCL-01</span>
              <span class="ticket-type"><i class="fa-solid fa-droplet"></i> Plomberie</span>
              <span class="ticket-bien">— Appart. Lac 2</span>
            </div>
            <div style="display:flex;gap:8px;align-items:center;">
              <span class="badge-priorite" style="background:#fee2e2;color:#dc2626; padding:3px 10px;border-radius:20px; font-size:12px;font-weight:600;">🔴 HAUTE</span>
              <span class="badge-attente" style="background:#fef9c3;color:#ca8a04; padding:3px 10px; border-radius:20px; font-size:12px; font-weight:600;">EN COURS</span>
            </div>
          </div>
          <div class="ticket-body">
            <p class="ticket-desc">"Fuite d'eau importante sous l'évier de la salle de bain"</p>
            <div class="ticket-meta">
              <span><i class="fa-solid fa-calendar"></i> 10/07/2025</span>
              <span><i class="fa-solid fa-comments"></i> 6 messages</span>
              <span><i class="fa-solid fa-clock"></i> Dernière activité : 12/07/2025</span>
            </div>
          </div>
          <div class="ticket-actions">
            <button class="btn-primary btn-sm" onclick="showModal('modal-chat-rcl01')"><i class="fa-solid fa-comments"></i> Voir le suivi (6 messages)</button>
            <button class="btn-outline btn-sm" onclick="showToast('📎 Photo partagée')"><i class="fa-solid fa-image"></i> Photos</button>
          </div>
        </div>

        <!-- TICKET RCL-02 — RÉSOLU -->
        <div class="reclamation-card" data-statut="resolu" style="border-left:4px solid #16a34a;opacity:0.85;">
          <div class="ticket-header">
            <div>
              <span class="ticket-id">#RCL-02</span>
              <span class="ticket-type"><i class="fa-solid fa-bolt"></i> Électricité</span>
            </div>
            <div style="display:flex;gap:8px;">
              <span style="background:#fef9c3;color:#ca8a04;padding:3px 10px; border-radius:20px;font-size:12px;font-weight:600;">🟡 MOYENNE</span>
              <span class="badge-paye" style="background:#dcfce7;color:#16a34a; padding:3px 10px; border-radius:20px; font-size:12px; font-weight:600;">RÉSOLU ✓</span>
            </div>
          </div>
          <div class="ticket-body">
            <p class="ticket-desc">"Prise électrique hors service dans le salon"</p>
            <div class="ticket-meta">
              <span><i class="fa-solid fa-calendar"></i> 15/07/2025</span>
              <span><i class="fa-solid fa-circle-check" style="color:#16a34a"></i> Résolu le 17/07/2025</span>
            </div>
          </div>
          <div class="ticket-actions">
            <button class="btn-outline btn-sm" onclick="showToast('✅ Ticket résolu — Archivé')"><i class="fa-solid fa-eye"></i> Voir l'historique</button>
          </div>
        </div>

        <!-- TICKET RCL-03 — OUVERT -->
        <div class="reclamation-card" data-statut="ouvert" style="border-left:4px solid #2563eb;">
          <div class="ticket-header">
            <div>
              <span class="ticket-id">#RCL-03</span>
              <span class="ticket-type"><i class="fa-solid fa-volume-high"></i> Nuisance sonore</span>
            </div>
            <div style="display:flex;gap:8px;">
              <span style="background:#dbeafe;color:#2563eb;padding:3px 10px; border-radius:20px;font-size:12px;font-weight:600;">🔵 BASSE</span>
              <span style="background:#f3f4f6;color:#374151;padding:3px 10px; border-radius:20px;font-size:12px;font-weight:600;">OUVERT</span>
            </div>
          </div>
          <div class="ticket-body">
            <p class="ticket-desc">"Voisins particulièrement bruyants la nuit"</p>
            <div class="ticket-meta">
              <span><i class="fa-solid fa-calendar"></i> 20/07/2025</span>
              <span><i class="fa-solid fa-clock"></i> En attente d'assignation</span>
            </div>
          </div>
          <div class="ticket-actions">
            <button class="btn-primary btn-sm" onclick="showModal('modal-chat-rcl01')"><i class="fa-solid fa-comments"></i> Ouvrir le chat</button>
          </div>
        </div>

      </div>
    </div>
  </main>
</div>

<!-- MODAL NOUVEAU TICKET -->
<div id="modal-new-reclamation" class="modal-overlay" style="display:none">
  <div class="modal-card">
    <div class="modal-header">
      <h3><i class="fa-solid fa-plus"></i> Nouveau ticket</h3>
      <button style="border:none;background:none;font-size:24px;cursor:pointer" onclick="closeModal('modal-new-reclamation')">✕</button>
    </div>
    <div class="modal-body">
      <label style="display:block;margin-bottom:8px;font-weight:600">Type de problème *</label>
      <select class="sakan-input" id="type-reclamation" style="width:100%;margin-bottom:16px;">
        <option value="">-- Choisissez un type --</option>
        <option value="plomberie">🔧 Plomberie</option>
        <option value="electricite">⚡ Électricité</option>
        <option value="nuisance">🔊 Nuisance sonore</option>
        <option value="chauffage">🌡️ Chauffage / Climatisation</option>
        <option value="serrure">🔒 Serrure / Sécurité</option>
        <option value="autre">❓ Autre</option>
      </select>

      <div id="autre-precision" style="display:none;margin-bottom:16px;">
        <label style="display:block;margin-bottom:8px;font-weight:600">Précisez *</label>
        <input type="text" class="sakan-input" placeholder="Décrivez le type de problème" style="width:100%;">
      </div>

      <label style="display:block;margin-bottom:8px;font-weight:600">Bien concerné</label>
      <select class="sakan-input" style="width:100%;margin-bottom:16px;">
        <option selected>Appartement lumineux - Lac 2, Tunis</option>
      </select>

      <label style="display:block;margin-bottom:8px;font-weight:600">Description détaillée *</label>
      <textarea class="sakan-input" rows="4" placeholder="Décrivez le problème en détail...&#10;Ex: La fuite se situe sous l'évier, elle date de ce matin..." style="width:100%;margin-bottom:16px;"></textarea>

      <!-- UPLOAD PHOTO -->
      <label style="display:block;margin-bottom:8px;font-weight:600">Photo(s) du problème</label>
      <div class="photo-upload-zone" onclick="showToast('📷 Sélection photo simulée')" style="border:2px dashed #5E17EB;border-radius:14px; padding:24px;text-align:center;cursor:pointer; background:rgba(94,23,235,0.03);">
        <i class="fa-solid fa-camera" style="font-size:32px;color:#5E17EB;"></i>
        <p style="margin-top:8px;color:#6b7280;font-size:13px; line-height:1.4;">
          Cliquez pour ajouter des photos<br>
          <span style="font-size:11px;">(JPG, PNG — Max 5 Mo)</span>
        </p>
      </div>

    </div>
    <div class="modal-footer">
      <button class="btn-secondary" onclick="closeModal('modal-new-reclamation')">Annuler</button>
      <button class="btn-primary" onclick="closeModal('modal-new-reclamation'); showToast('🎫 Ticket #RCL-04 créé ! Priorité assignée par IA.')"><i class="fa-solid fa-paper-plane"></i> Soumettre le ticket</button>
    </div>
  </div>
</div>

<!-- MODAL CHAT TICKET RCL-01 -->
<div id="modal-chat-rcl01" class="modal-overlay" style="display:none">
  <div class="modal-card modal-lg">
    <div class="modal-header">
      <div>
        <h3 style="margin:0;"><i class="fa-solid fa-comments"></i> Ticket #RCL-01 — Plomberie</h3>
        <span style="font-size:12px;color:#6b7280;display:block;margin-top:4px;">
          Appartement lumineux - Lac 2 • <strong style="color:#dc2626;">EN COURS</strong>
        </span>
      </div>
      <button style="border:none;background:none;font-size:24px;cursor:pointer" onclick="closeModal('modal-chat-rcl01')">✕</button>
    </div>
    
    <div class="modal-body chat-container" style="max-height:400px;overflow-y:auto; padding: 20px;">

      <!-- MESSAGE 1 — Fatma -->
      <div class="chat-message sent" style="display:flex;justify-content:flex-end; margin-bottom:16px;">
        <div style="max-width:70%;">
          <div style="background:rgba(94,23,235,0.1);border-radius:18px 18px 4px 18px; padding:12px 16px;">
            <p style="font-size:14px;margin:0;">
              Bonjour, j'ai une fuite importante sous l'évier de la salle de bain depuis ce matin.
            </p>
          </div>
          <span style="font-size:11px;color:#9ca3af; display:block;text-align:right;margin-top:4px;">
            Fatma — 10/07 09:00
          </span>
        </div>
        <img src="https://i.pravatar.cc/36?img=5" alt="Fatma" style="width:36px;height:36px;border-radius:50%; margin-left:8px;flex-shrink:0; object-fit:cover;">
      </div>

      <!-- MESSAGE 2 — Karim -->
      <div class="chat-message received" style="display:flex;margin-bottom:16px;">
        <img src="https://i.pravatar.cc/36?img=3" alt="Karim" style="width:36px;height:36px;border-radius:50%; margin-right:8px;flex-shrink:0; object-fit:cover;">
        <div style="max-width:70%;">
          <div style="background:#f3f4f6;border-radius:18px 18px 18px 4px; padding:12px 16px;">
            <p style="font-size:14px;margin:0; color: #111827;">
              Bonjour Fatma, je contacte un plombier aujourd'hui. Pouvez-vous m'envoyer une photo ?
            </p>
          </div>
          <span style="font-size:11px;color:#9ca3af;margin-top:4px;display:block;">
            Karim — 10/07 10:30
          </span>
        </div>
      </div>
      
      <!-- PHOTO DE FATMA -->
      <div class="chat-message sent" style="display:flex;justify-content:flex-end; margin-bottom:16px;">
        <div style="max-width:70%;">
          <div style="background:rgba(94,23,235,0.1);border-radius:18px 18px 4px 18px; padding:8px;">
             <img src="https://images.unsplash.com/photo-1584622650111-993a426fbf0a?w=200" alt="Fuite d'eau" style="width: 100%; border-radius: 12px;">
             <p style="font-size:14px;margin:8px 8px 4px 8px;">Bien sûr, voici la photo.</p>
          </div>
          <span style="font-size:11px;color:#9ca3af; display:block;text-align:right;margin-top:4px;">
            Fatma — 10/07 11:00
          </span>
        </div>
        <img src="https://i.pravatar.cc/36?img=5" alt="Fatma" style="width:36px;height:36px;border-radius:50%; margin-left:8px;flex-shrink:0; object-fit:cover; visibility:hidden;">
      </div>

      <!-- MESSAGE 3 — Admin -->
      <div style="text-align:center;margin:16px 0;">
        <div style="display:inline-block;background:#fef9c3; color:#92400e;padding:8px 20px;border-radius:20px; font-size:12px;font-style:italic;">
          <i class="fa-solid fa-shield-halved"></i> Admin — Dossier pris en charge. Intervention prévue le 12/07.
          <span style="color:#d97706; margin-left:4px;">— 10/07 14:00</span>
        </div>
      </div>

      <!-- MESSAGE 4 — Fatma -->
      <div class="chat-message sent" style="display:flex;justify-content:flex-end;margin-bottom:16px;">
        <div style="max-width:70%;">
          <div style="background:rgba(94,23,235,0.1); border-radius:18px 18px 4px 18px;padding:12px 16px;">
            <p style="font-size:14px;margin:0;">
              Le plombier est passé, merci ! Mais il reste une petite humidité sur le mur.
            </p>
          </div>
          <span style="font-size:11px;color:#9ca3af; display:block;text-align:right;margin-top:4px;">
            Fatma — 12/07 16:00
          </span>
        </div>
        <img src="https://i.pravatar.cc/36?img=5" alt="Fatma" style="width:36px;height:36px;border-radius:50%;margin-left:8px; object-fit:cover;">
      </div>

      <!-- MESSAGE 5 — Karim -->
      <div class="chat-message received" style="display:flex;margin-bottom:16px;">
        <img src="https://i.pravatar.cc/36?img=3" alt="Karim" style="width:36px;height:36px;border-radius:50%;margin-right:8px; object-fit:cover;">
        <div style="max-width:70%;">
          <div style="background:#f3f4f6; border-radius:18px 18px 18px 4px;padding:12px 16px;">
            <p style="font-size:14px;margin:0; color: #111827;">
              On fera un suivi dans 48h. Merci de votre patience.
            </p>
          </div>
          <span style="font-size:11px;color:#9ca3af;margin-top:4px;display:block;">
            Karim — 12/07 17:00
          </span>
        </div>
      </div>

    </div>

    <!-- ZONE SAISIE -->
    <div class="chat-input-zone" style="padding:16px;border-top:1px solid #e5e7eb; display:flex;gap:12px;align-items:flex-end; background:#fafafa; border-radius:0 0 20px 20px;">
      <button onclick="showToast('📎 Ajout photo simulé')" style="background:white;border:1.5px solid #e5e7eb; border-radius:12px;padding:10px 14px; cursor:pointer;color:#6b7280; height: 44px; display:flex; align-items:center;">
        <i class="fa-solid fa-image"></i>
      </button>
      <textarea class="sakan-input" rows="2" style="flex:1;resize:none; padding:12px; background:white;" placeholder="Votre message..."></textarea>
      <button class="btn-primary" onclick="showToast('💬 Message envoyé !')" style="height: 44px; padding: 0 20px;">
        <i class="fa-solid fa-paper-plane"></i>
      </button>
    </div>

  </div>
</div>

<div id="toast" class="toast" style="display:none"></div>

<script>
  function showModal(id) { document.getElementById(id).style.display = 'flex'; }
  function closeModal(id) { document.getElementById(id).style.display = 'none'; }
  function showToast(msg) {
    const t = document.getElementById('toast');
    t.textContent = msg;
    t.style.display = 'block';
    setTimeout(() => t.style.display = 'none', 3000);
  }
  document.getElementById('type-reclamation')?.addEventListener('change', function() {
    document.getElementById('autre-precision').style.display = (this.value === 'autre') ? 'block' : 'none';
  });
  function filterTickets(statut) {
    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
    event.target.classList.add('active');
    document.querySelectorAll('.reclamation-card').forEach(card => {
      if (statut === 'all' || card.dataset.statut === statut) {
        card.style.display = 'block';
      } else {
        card.style.display = 'none';
      }
    });
  }
</script>
</body>
</html>
