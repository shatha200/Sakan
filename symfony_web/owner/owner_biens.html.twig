<div id="toast" class="toast" style="display:none"></div>

<script>
  function setView(v) {
    document.getElementById('view-grid').style.display = v === 'grid' ? 'grid' : 'none';
    document.getElementById('view-list').style.display = v === 'list' ? 'block' : 'none';
    document.getElementById('btn-grid').classList.toggle('active-view', v === 'grid');
    document.getElementById('btn-list').classList.toggle('active-view', v === 'list');
  }
  function filterBiens(statut) {
    document.querySelectorAll('.filter-chip').forEach(b => b.classList.remove('active'));
    event.target.classList.add('active');
    document.querySelectorAll('.bien-owner-card').forEach(c => {
      c.style.display = (statut === 'all' || c.dataset.statut === statut) ? 'block' : 'none';
    });
  }
  function showBienTab(id, btn) {
    ['tab-infos','tab-finances','tab-locataire'].forEach(t => document.getElementById(t).style.display = 'none');
    document.querySelectorAll('#modal-detail-bien1 .tab-btn').forEach(b => b.classList.remove('active'));
    document.getElementById(id).style.display = 'block';
    btn.classList.add('active');
  }
  function showModal(id) { document.getElementById(id).style.display = 'flex'; }
  function closeModal(id) { document.getElementById(id).style.display = 'none'; }
  function showToast(msg) {
    const t = document.getElementById('toast');
    t.textContent = msg;
    t.style.display = 'block';
    setTimeout(() => t.style.display = 'none', 3000);
  }
</script>
