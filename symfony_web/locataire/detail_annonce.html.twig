<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Sakan — Détail Annonce</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <link rel="stylesheet" href="../../css_web/sakan-global.css">
  <link rel="stylesheet" href="../../css_web/sakan-locataire.css">
</head>
<body>
  <div class="sakan-layout">

    <!-- SIDEBAR -->
    <nav class="sakan-sidebar" id="sidebar-locataire">
      <div class="sidebar-logo">
        <i class="fa-solid fa-house"></i> <span class="logo-text">Sakan</span>
      </div>
      <ul class="sidebar-menu">
        <li><a href="catalogue.html" class="active"><i class="fa-solid fa-magnifying-glass"></i> Explorer les biens</a></li>
        <li><a href="mes_visites.html"><i class="fa-solid fa-calendar-check"></i> Mes visites</a></li>
        <li><a href="mes_reservations.html"><i class="fa-solid fa-check"></i> Mes réservations</a></li>
        <li><a href="mes_contrats.html"><i class="fa-solid fa-file-contract"></i> Mes contrats</a></li>
        <li><a href="../paiement/finances.html"><i class="fa-solid fa-coins"></i> Espace financier</a></li>
        <li><a href="../reclamations/reclamations_locataire.html"><i class="fa-solid fa-shield-halved"></i> Service client</a></li>
        <li><a href="mon_profil.html"><i class="fa-solid fa-user"></i> Mon profil</a></li>
      </ul>
      <div class="sidebar-footer">
        <a href="../auth/login.html">
          <i class="fa-solid fa-right-from-bracket"></i> Déconnexion
        </a>
      </div>
    </nav>

    <!-- MAIN CONTENT -->
    <main class="sakan-main">
      <button class="btn-retour" onclick="window.location.href='catalogue.html'">
        <i class="fa-solid fa-chevron-left"></i> Retour au catalogue
      </button>

      <!-- HERO IMAGE -->
      <div class="detail-hero">
        <img src="https://images.unsplash.com/photo-1560448204-e02f11c3d0e2?w=1200" alt="Appartement lumineux - Lac 2">
        <div class="hero-overlay">
          <div>
            <h1>Appartement lumineux - Lac 2, Tunis</h1>
            <span class="badge-statut disponible" style="position:static; margin-top:8px;">Disponible</span>
          </div>
          <div class="hero-prix">2 200 TND <span style="font-size:16px;font-weight:normal;color:white;">/ mois</span></div>
        </div>
      </div>

      <!-- LAYOUT 2 COLONNES -->
      <div class="detail-layout">
        
        <!-- COLONNE GAUCHE -->
        <div class="detail-left">
          
          <div class="infos-chips">
            <span><i class="fa-solid fa-bed"></i> 3 chambres</span>
            <span><i class="fa-solid fa-shower"></i> 2 salles de bain</span>
            <span><i class="fa-solid fa-ruler-combined"></i> 95 m²</span>
            <span><i class="fa-solid fa-location-dot"></i> Lac 2, Tunis</span>
          </div>

          <section class="detail-section">
            <h2>Description</h2>
            <p style="color: var(--text-muted); line-height: 1.6;">
              Superbe appartement lumineux au cœur du Lac 2, entièrement meublé avec goût. Vue dégagée, cuisine équipée, parking inclus. Idéal pour cadres ou couples.
            </p>
          </section>

          <section class="detail-section">
            <h2>Équipements & Services</h2>
            <div class="equipements-grid">
              <span class="equip-tag"><i class="fa-solid fa-wifi"></i> WiFi</span>
              <span class="equip-tag"><i class="fa-solid fa-car"></i> Parking</span>
              <span class="equip-tag"><i class="fa-solid fa-snowflake"></i> Climatisation</span>
              <span class="equip-tag"><i class="fa-solid fa-elevator"></i> Ascenseur</span>
              <span class="equip-tag"><i class="fa-brands fa-pagelines"></i> Balcon</span>
            </div>
          </section>

          <section class="detail-section">
            <h2>Localisation</h2>
            <div class="map-placeholder">
              <img src="https://staticmap.openstreetmap.de/staticmap.php?center=36.8325,10.2278&zoom=15&size=800x300" alt="Carte - Lac 2 Tunis" style="width:100%;border-radius:16px;object-fit:cover;">
              <div class="map-actions">
                <button onclick="showToast('Ouverture de la carte...')">
                  <i class="fa-solid fa-map"></i> Voir sur Google Maps
                </button>
                <button onclick="copyAddress()">
                  <i class="fa-solid fa-copy"></i> Copier l'adresse
                </button>
              </div>
            </div>
          </section>

          <section class="detail-section">
            <h2>Avis des locataires</h2>
            <div class="rating-global">
              <span class="rating-score">4.8</span>
              <div class="stars">★★★★★</div>
              <span class="rating-count">(12 avis)</span>
            </div>

            <div class="avis-list">
              <div class="avis-item">
                <img src="https://i.pravatar.cc/80?img=9" alt="Ines" class="avis-avatar">
                <div class="avis-content">
                  <div class="avis-header">
                    <strong>Ines Bouzid</strong>
                    <span class="avis-date">Il y a 2 semaines</span>
                  </div>
                  <div class="avis-stars">★★★★★</div>
                  <p class="avis-text">"Appartement parfait, propriétaire très réactif !"</p>
                </div>
              </div>

              <div class="avis-item">
                <img src="https://i.pravatar.cc/80?img=11" alt="Mohamed" class="avis-avatar">
                <div class="avis-content">
                  <div class="avis-header">
                    <strong>Mohamed Salah</strong>
                    <span class="avis-date">Il y a 1 mois</span>
                  </div>
                  <div class="avis-stars">★★★★☆</div>
                  <p class="avis-text">"Très bon rapport qualité/prix, quartier calme."</p>
                </div>
              </div>

              <div class="avis-item">
                <img src="https://i.pravatar.cc/80?img=15" alt="Amira" class="avis-avatar">
                <div class="avis-content">
                  <div class="avis-header">
                    <strong>Amira Khemiri</strong>
                    <span class="avis-date">Il y a 3 semaines</span>
                  </div>
                  <div class="avis-stars">★★★★★</div>
                  <p class="avis-text">"Logement conforme aux photos, je recommande !"</p>
                </div>
              </div>
            </div>
          </section>

        </div>

        <!-- COLONNE DROITE -->
        <div class="detail-right">
          <div class="action-card">
            <img src="https://i.pravatar.cc/150?img=3" alt="Karim" class="proprio-avatar">
            <div class="proprio-info">
              <strong>Karim Mezghani</strong>
              <span>Propriétaire vérifié ✓</span>
            </div>
            <hr>
            <div class="prix-action">
              <span class="prix-label">Loyer mensuel</span>
              <span class="prix-value">2 200 TND</span>
            </div>
            <button class="btn-primary btn-full" onclick="showModal('modal-reservation')">
              <i class="fa-solid fa-house-circle-check"></i> Réserver cet appartement
            </button>
            <button class="btn-secondary btn-full" onclick="showModal('modal-visite')" style="margin-bottom: 24px;">
              <i class="fa-solid fa-calendar-check"></i> Demander une visite
            </button>
            <button class="btn-outline btn-full" onclick="showToast('Numéro copié : +216 55 123 456')">
              <i class="fa-solid fa-phone"></i> Contacter le propriétaire
            </button>
          </div>
        </div>

      </div>
    </main>
  </div>

  <!-- Modal Réservation -->
  <div id="modal-reservation" class="modal-overlay" style="display:none">
    <div class="modal-card">
      <div class="modal-header">
        <h3><i class="fa-solid fa-house-circle-check"></i> Réserver l'appartement</h3>
        <button onclick="closeModal('modal-reservation')"><i class="fa-solid fa-xmark"></i></button>
      </div>
      <div class="modal-body">
        <div class="modal-bien-recap">
          <img src="https://images.unsplash.com/photo-1560448204-e02f11c3d0e2?w=200" alt="Appartement">
          <div>
            <strong>Appartement lumineux - Lac 2</strong>
            <span>2 200 TND / mois</span>
          </div>
        </div>
        <label>Date de début souhaitée *</label>
        <input type="date" class="sakan-input" value="2025-09-01">
        <label>Durée du bail</label>
        <select class="sakan-input">
          <option>6 mois</option>
          <option selected>12 mois</option>
          <option>24 mois</option>
        </select>
        <label>Message au propriétaire</label>
        <textarea class="sakan-input" rows="3" placeholder="Bonjour, je suis intéressée par votre bien...">Bonjour M. Mezghani, je suis intéressée par votre appartement et souhaite en savoir plus sur les modalités de location.</textarea>
      </div>
      <div class="modal-footer">
        <button class="btn-secondary" onclick="closeModal('modal-reservation')">Annuler</button>
        <button class="btn-primary" onclick="closeModal('modal-reservation'); showToast('✅ Demande de réservation envoyée à Karim Mezghani !')">
          <i class="fa-solid fa-paper-plane"></i> Envoyer la demande
        </button>
      </div>
    </div>
  </div>

  <!-- Modal Visite -->
  <div id="modal-visite" class="modal-overlay" style="display:none">
    <div class="modal-card">
      <div class="modal-header">
        <h3><i class="fa-solid fa-calendar-check"></i> Demander une visite</h3>
        <button onclick="closeModal('modal-visite')"><i class="fa-solid fa-xmark"></i></button>
      </div>
      <div class="modal-body">
        <label>Date souhaitée *</label>
        <input type="date" class="sakan-input">
        <label>Heure préférée *</label>
        <select class="sakan-input">
          <option>09:00</option>
          <option>10:00</option>
          <option selected>11:00</option>
          <option>14:00</option>
          <option>15:00</option>
          <option>16:00</option>
        </select>
        <label>Message (optionnel)</label>
        <textarea class="sakan-input" rows="2" placeholder="Remarques particulières..."></textarea>
        <div class="modal-info-tip">
          <i class="fa-solid fa-circle-info"></i>
          Un QR code vous sera envoyé après confirmation du propriétaire.
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn-secondary" onclick="closeModal('modal-visite')">Annuler</button>
        <button class="btn-primary" onclick="closeModal('modal-visite'); showToast('📅 Visite demandée ! En attente de confirmation.')">
          <i class="fa-solid fa-check"></i> Confirmer
        </button>
      </div>
    </div>
  </div>

  <!-- TOAST -->
  <div id="toast" class="toast" style="display:none"></div>

  <script>
    function showModal(id) { document.getElementById(id).style.display = 'flex'; }
    function closeModal(id) { document.getElementById(id).style.display = 'none'; }
    function showToast(msg) {
      const t = document.getElementById('toast');
      t.textContent = msg;
      t.style.display = 'block';
      setTimeout(() => t.style.display = 'none', 3500);
    }
    function copyAddress() {
      navigator.clipboard.writeText('Lac 2, Tunis, Tunisie');
      showToast('📋 Adresse copiée !');
    }
    document.querySelector('.detail-hero img').addEventListener('click', () => {
      showToast('🖼 Galerie photo (fonctionnalité à venir)');
    });
  </script>
</body>
</html>
