<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Sakan — Explorer les biens</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <link rel="stylesheet" href="../../css_web/sakan-global.css">
  <link rel="stylesheet" href="../../css_web/sakan-locataire.css">
</head>
<body>
  <div class="sakan-layout">

    <!-- SIDEBAR -->
    <nav class="sakan-sidebar" id="sidebar-locataire">
      <div class="sidebar-logo">
        <i class="fa-solid fa-house"></i> <span class="logo-text">Sakan</span>
      </div>
      <ul class="sidebar-menu">
        <li><a href="catalogue.html" class="active"><i class="fa-solid fa-magnifying-glass"></i> Explorer les biens</a></li>
        <li><a href="mes_visites.html"><i class="fa-solid fa-calendar-check"></i> Mes visites</a></li>
        <li><a href="mes_reservations.html"><i class="fa-solid fa-check"></i> Mes réservations</a></li>
        <li><a href="mes_contrats.html"><i class="fa-solid fa-file-contract"></i> Mes contrats</a></li>
        <li><a href="../paiement/finances.html"><i class="fa-solid fa-coins"></i> Espace financier</a></li>
        <li><a href="../reclamations/reclamations_locataire.html"><i class="fa-solid fa-shield-halved"></i> Service client</a></li>
        <li><a href="mon_profil.html"><i class="fa-solid fa-user"></i> Mon profil</a></li>
      </ul>
      <div class="sidebar-footer">
        <a href="../auth/login.html">
          <i class="fa-solid fa-right-from-bracket"></i> Déconnexion
        </a>
      </div>
    </nav>

    <!-- CONTENU PRINCIPAL -->
    <main class="sakan-main">

      <!-- EN-TÊTE DE PAGE -->
      <div class="page-header">
        <div>
          <h1>Explorer les biens</h1>
          <span class="result-count">5 biens disponibles</span>
        </div>
        <div class="header-actions">
          <button class="btn-secondary" onclick="window.location.href='comparateur.html'">
            <i class="fa-solid fa-scale-balanced"></i> Comparer
          </button>
        </div>
      </div>

      <!-- BARRE DE FILTRES -->
      <div class="filter-bar">
        <select class="filter-select">
          <option>Toutes les villes</option>
          <option>Tunis</option>
          <option>La Marsa</option>
        </select>
        
        <select class="filter-select">
          <option>Type de bien</option>
          <option>Appartement</option>
          <option>Villa</option>
          <option>Studio</option>
        </select>
        
        <input type="text" placeholder="Prix max (TND)" class="filter-input">
        <input type="text" placeholder="Surface min (m²)" class="filter-input">
        
        <select class="filter-select">
          <option>Trier par : Pertinence</option>
          <option>Prix: Croissant</option>
          <option>Prix: Décroissant</option>
        </select>

        <button id="btn-filter" class="btn-primary" onclick="applyFilters()" style="margin: 0; padding: 12px 24px;">
          <i class="fa-solid fa-filter"></i> Appliquer les filtres
        </button>
      </div>

      <!-- GRILLE DES ANNONCES -->
      <div class="annonces-grid">

        <!-- CARTE BIEN 1 -->
        <div class="annonce-card" onclick="window.location.href='detail_annonce.html'">
          <div class="card-image-wrapper">
            <img src="https://images.unsplash.com/photo-1560448204-e02f11c3d0e2?w=800" alt="Appartement lumineux - Lac 2, Tunis" class="card-img">
            <span class="badge-statut disponible">Disponible</span>
            <button class="btn-favori" onclick="event.stopPropagation(); this.classList.toggle('active')">
              <i class="fa-solid fa-heart"></i>
            </button>
          </div>
          <div class="card-body">
            <div class="card-prix">2 200 TND<span>/mois</span></div>
            <h3 class="card-titre">Appartement lumineux - Lac 2, Tunis</h3>
            <div class="card-localisation">
              <i class="fa-solid fa-location-dot"></i> Lac 2, Tunis
            </div>
            <div class="card-infos">
              <span><i class="fa-solid fa-bed"></i> 3 ch</span>
              <span><i class="fa-solid fa-shower"></i> 2 sdb</span>
              <span><i class="fa-solid fa-ruler-combined"></i> 95 m²</span>
            </div>
            <div class="card-actions">
              <button class="btn-voir" onclick="event.stopPropagation(); window.location.href='detail_annonce.html'">
                <i class="fa-solid fa-eye"></i> Voir l'annonce
              </button>
              <button class="btn-visite" onclick="event.stopPropagation(); showModal('modal-visite')">
                <i class="fa-solid fa-calendar-check"></i> Visite
              </button>
            </div>
          </div>
        </div>

        <!-- CARTE BIEN 2 -->
        <div class="annonce-card" onclick="window.location.href='detail_annonce.html'">
          <div class="card-image-wrapper">
            <img src="https://images.unsplash.com/photo-1522708323590-d24dbb6b0267?w=800" alt="Studio moderne - Menzah 6, Tunis" class="card-img">
            <span class="badge-statut disponible">Disponible</span>
            <button class="btn-favori" onclick="event.stopPropagation(); this.classList.toggle('active')">
              <i class="fa-solid fa-heart"></i>
            </button>
          </div>
          <div class="card-body">
            <div class="card-prix">1 100 TND<span>/mois</span></div>
            <h3 class="card-titre">Studio moderne - Menzah 6, Tunis</h3>
            <div class="card-localisation">
              <i class="fa-solid fa-location-dot"></i> Menzah 6, Tunis
            </div>
            <div class="card-infos">
              <span><i class="fa-solid fa-bed"></i> 1 ch</span>
              <span><i class="fa-solid fa-shower"></i> 1 sdb</span>
              <span><i class="fa-solid fa-ruler-combined"></i> 45 m²</span>
            </div>
            <div class="card-actions">
              <button class="btn-voir" onclick="event.stopPropagation(); window.location.href='detail_annonce.html'">
                <i class="fa-solid fa-eye"></i> Voir l'annonce
              </button>
              <button class="btn-visite" onclick="event.stopPropagation(); showModal('modal-visite')">
                <i class="fa-solid fa-calendar-check"></i> Visite
              </button>
            </div>
          </div>
        </div>

        <!-- CARTE BIEN 3 -->
        <div class="annonce-card" onclick="window.location.href='detail_annonce.html'">
          <div class="card-image-wrapper">
            <img src="https://images.unsplash.com/photo-1512917774080-9991f1c4c750?w=800" alt="Villa avec piscine - La Marsa" class="card-img">
            <span class="badge-statut disponible">Disponible</span>
            <button class="btn-favori" onclick="event.stopPropagation(); this.classList.toggle('active')">
              <i class="fa-solid fa-heart"></i>
            </button>
          </div>
          <div class="card-body">
            <div class="card-prix">4 500 TND<span>/mois</span></div>
            <h3 class="card-titre">Villa avec piscine - La Marsa</h3>
            <div class="card-localisation">
              <i class="fa-solid fa-location-dot"></i> La Marsa
            </div>
            <div class="card-infos">
              <span><i class="fa-solid fa-bed"></i> 5 ch</span>
              <span><i class="fa-solid fa-shower"></i> 3 sdb</span>
              <span><i class="fa-solid fa-ruler-combined"></i> 280 m²</span>
            </div>
            <div class="card-actions">
              <button class="btn-voir" onclick="event.stopPropagation(); window.location.href='detail_annonce.html'">
                <i class="fa-solid fa-eye"></i> Voir l'annonce
              </button>
              <button class="btn-visite" onclick="event.stopPropagation(); showModal('modal-visite')">
                <i class="fa-solid fa-calendar-check"></i> Visite
              </button>
            </div>
          </div>
        </div>

        <!-- CARTE BIEN 4 (RÉSERVÉ) -->
        <div class="annonce-card" onclick="window.location.href='detail_annonce.html'">
          <div class="card-image-wrapper">
            <img src="https://images.unsplash.com/photo-1484154218962-a197022b5858?w=800" alt="Appartement cosy - Les Berges du Lac" class="card-img">
            <span class="badge-statut reserve">Réservé</span>
            <button class="btn-favori" onclick="event.stopPropagation(); this.classList.toggle('active')">
              <i class="fa-solid fa-heart"></i>
            </button>
          </div>
          <div class="card-body">
            <div class="card-prix">1 800 TND<span>/mois</span></div>
            <h3 class="card-titre">Appartement cosy - Les Berges du Lac</h3>
            <div class="card-localisation">
              <i class="fa-solid fa-location-dot"></i> Les Berges du Lac, Tunis
            </div>
            <div class="card-infos">
              <span><i class="fa-solid fa-bed"></i> 2 ch</span>
              <span><i class="fa-solid fa-shower"></i> 1 sdb</span>
              <span><i class="fa-solid fa-ruler-combined"></i> 75 m²</span>
            </div>
            <div class="card-actions">
              <button class="btn-voir" onclick="event.stopPropagation(); window.location.href='detail_annonce.html'">
                <i class="fa-solid fa-eye"></i> Voir l'annonce
              </button>
              <button class="btn-visite" onclick="event.stopPropagation(); showModal('modal-visite')" style="opacity:0.5; pointer-events:none;">
                <i class="fa-solid fa-calendar-check"></i> Indisponible
              </button>
            </div>
          </div>
        </div>

        <!-- CARTE BIEN 5 -->
        <div class="annonce-card" onclick="window.location.href='detail_annonce.html'">
          <div class="card-image-wrapper">
            <img src="https://images.unsplash.com/photo-1493809842364-78817add7ffb?w=800" alt="Duplex standing - Ennasr 2, Tunis" class="card-img">
            <span class="badge-statut disponible">Disponible</span>
            <button class="btn-favori" onclick="event.stopPropagation(); this.classList.toggle('active')">
              <i class="fa-solid fa-heart"></i>
            </button>
          </div>
          <div class="card-body">
            <div class="card-prix">2 800 TND<span>/mois</span></div>
            <h3 class="card-titre">Duplex standing - Ennasr 2, Tunis</h3>
            <div class="card-localisation">
              <i class="fa-solid fa-location-dot"></i> Ennasr 2, Tunis
            </div>
            <div class="card-infos">
              <span><i class="fa-solid fa-bed"></i> 4 ch</span>
              <span><i class="fa-solid fa-shower"></i> 2 sdb</span>
              <span><i class="fa-solid fa-ruler-combined"></i> 140 m²</span>
            </div>
            <div class="card-actions">
              <button class="btn-voir" onclick="event.stopPropagation(); window.location.href='detail_annonce.html'">
                <i class="fa-solid fa-eye"></i> Voir l'annonce
              </button>
              <button class="btn-visite" onclick="event.stopPropagation(); showModal('modal-visite')">
                <i class="fa-solid fa-calendar-check"></i> Visite
              </button>
            </div>
          </div>
        </div>

      </div>

      <!-- PAGINATION -->
      <div class="pagination-bar">
        <button class="page-btn"><i class="fa-solid fa-chevron-left"></i> Précédent</button>
        <button class="page-btn active">1</button>
        <button class="page-btn">2</button>
        <button class="page-btn">3</button>
        <button class="page-btn">Suivant <i class="fa-solid fa-chevron-right"></i></button>
      </div>

    </main>
  </div>

  <!-- MODAL DEMANDE DE VISITE -->
  <div id="modal-visite" class="modal-overlay" style="display:none">
    <div class="modal-card">
      <div class="modal-header">
        <h3><i class="fa-solid fa-calendar-check"></i> Demander une visite</h3>
        <button onclick="closeModal('modal-visite')">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>
      <div class="modal-body">
        <label>Bien sélectionné</label>
        <p class="modal-bien-nom">Appartement lumineux - Lac 2, Tunis</p>
        <label>Date souhaitée</label>
        <input type="date" class="sakan-input">
        <label>Heure préférée</label>
        <input type="time" class="sakan-input">
        <label>Message au propriétaire (optionnel)</label>
        <textarea class="sakan-input" rows="3" placeholder="Bonjour, je souhaite visiter..."></textarea>
      </div>
      <div class="modal-footer">
        <button class="btn-secondary" onclick="closeModal('modal-visite')">Annuler</button>
        <button class="btn-primary" onclick="closeModal('modal-visite');showToast('Demande envoyée !')">
          <i class="fa-solid fa-check"></i> Confirmer la visite
        </button>
      </div>
    </div>
  </div>

  <!-- TOAST NOTIFICATION -->
  <div id="toast" class="toast" style="display:none"></div>

  <script>
    function showModal(id) { document.getElementById(id).style.display = 'flex'; }
    function closeModal(id) { document.getElementById(id).style.display = 'none'; }
    function showToast(msg) {
      const t = document.getElementById('toast');
      t.textContent = msg;
      t.style.display = 'block';
      setTimeout(() => t.style.display = 'none', 3000);
    }
    function applyFilters() {
      const btn = document.getElementById('btn-filter');
      btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Recherche...';
      setTimeout(() => {
        btn.innerHTML = '<i class="fa-solid fa-filter"></i> Appliquer les filtres';
      }, 800);
    }
    document.querySelectorAll('.btn-favori').forEach(btn => {
      btn.addEventListener('click', function(e) {
        e.stopPropagation();
        this.classList.toggle('active');
        const icon = this.querySelector('i');
        icon.style.color = this.classList.contains('active') ? '#ef4444' : '';
      });
    });
  </script>
</body>
</html>
