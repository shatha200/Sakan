{% extends 'layouts/base_admin.html.twig' %}
{% block title %}Gestion des Cautions — Admin Sakan{% endblock %}
{% block page_title %}<i class="fa-solid fa-shield-halved" ></i> Gestion des Cautions{% endblock %}
{% block page_actions %}
  <button onclick="exportToCSV()" style="display:flex; align-items:center; gap:6px; padding:9px 18px; color:white; border:none; border-radius:10px; font-size:13px; font-weight:600; cursor:pointer;">
    <i class="fa-solid fa-file-excel"></i> Export CSV
  </button>
{% endblock %}

{% block content %}
<style>
.fin-kpi-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(180px,1fr)); gap:16px; margin-bottom:28px; }
.fin-kpi { background:white;border-radius:16px;padding:20px;box-shadow:0 2px 12px rgba(0,0,0,0.07);border-left:4px solid #e5e7eb; }
.fin-kpi.green { border-left-color:#16a34a; } .fin-kpi.green .fin-kpi-value { color:#16a34a; }
.fin-kpi.yellow { border-left-color:#f59e0b; } .fin-kpi.yellow .fin-kpi-value { color:#f59e0b; }
.fin-kpi.red { border-left-color:#dc2626; } .fin-kpi.red .fin-kpi-value { color:#dc2626; }
.fin-kpi.blue { border-left-color:#3b82f6; } .fin-kpi.blue .fin-kpi-value { color:#3b82f6; }
.fin-kpi-label { font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.8px;color:#6b7280;margin-bottom:8px; }
.fin-kpi-value { font-size:26px;font-weight:800; }
.fin-kpi-sub { font-size:12px;color:#9ca3af;margin-top:4px; }
.fin-card { background:white;border-radius:16px;padding:24px;margin-bottom:24px;box-shadow:0 2px 12px rgba(0,0,0,0.07); }
.fin-card-title { font-size:13px;font-weight:800;text-transform:uppercase;letter-spacing:.8px;display:flex;align-items:center;gap:8px;margin-bottom:20px; }
.tabs { display:flex;gap:4px;margin-bottom:20px;background:#f3f4f6;padding:4px;border-radius:12px; }
.tab { padding:8px 18px;border-radius:9px;font-size:13px;font-weight:600;cursor:pointer;border:none;background:transparent;color:#6b7280;transition:all 0.2s; }
.tab.active { background:white;color:#16a34a;box-shadow:0 2px 8px rgba(0,0,0,0.08); }
.fin-filter-bar { display:flex;gap:10px;flex-wrap:wrap;align-items:flex-end;margin-bottom:20px;padding:16px;background:#f9fafb;border-radius:12px; }
.fin-filter-input { padding:9px 14px;border:1px solid #e5e7eb;border-radius:8px;font-size:13px;background:white; }
.fin-table { width:100%;border-collapse:collapse;font-size:13px; }
.fin-table th { padding:12px 10px;text-align:left;font-size:11px;font-weight:700;color:#6b7280;text-transform:uppercase;border-bottom:2px solid #f3f4f6;white-space:nowrap; }
.fin-table td { padding:11px 10px;border-bottom:1px solid #f9fafb; }
.fin-table tr:hover td { background:rgba(22,163,74,0.02); }
.badge-detenu { background:#dcfce7;color:#16a34a;padding:4px 10px;border-radius:20px;font-size:11px;font-weight:700; }
.badge-remb { background:#dbeafe;color:#3b82f6;padding:4px 10px;border-radius:20px;font-size:11px;font-weight:700; }
.badge-retenu { background:#fee2e2;color:#dc2626;padding:4px 10px;border-radius:20px;font-size:11px;font-weight:700; }
.fin-action-btn { padding:5px 10px;border-radius:6px;font-size:12px;font-weight:600;text-decoration:none;display:inline-flex;align-items:center;gap:4px;transition:all 0.2s;background:rgba(22,163,74,0.1);color:#16a34a; }
.fin-action-btn:hover { background:#16a34a;color:white; }
</style>

{# ── KPIs ──────────────────────────────────────────────────────── #}
<div class="fin-kpi-grid">
  <div class="fin-kpi" style="border-left-color:#16a34a;">
    <div class="fin-kpi-label"><i class="fa-solid fa-shield"></i> Total cautions</div>
    <div class="fin-kpi-value" >{{ kpis.total_cautions ?? 0 }}</div>
    <div class="fin-kpi-sub">{{ (kpis.total_detenu ?? 0)|number_format(3,',', ' ') }} TND détenus</div>
  </div>
  <div class="fin-kpi green">
    <div class="fin-kpi-label"><i class="fa-solid fa-lock"></i> Actives (détenues)</div>
    <div class="fin-kpi-value">{{ kpis.nb_actives ?? 0 }}</div>
    <div class="fin-kpi-sub">{{ (kpis.montant_actif ?? 0)|number_format(3,',', ' ') }} TND</div>
  </div>
  <div class="fin-kpi blue">
    <div class="fin-kpi-label"><i class="fa-solid fa-check-circle"></i> Remboursées</div>
    <div class="fin-kpi-value">{{ kpis.nb_remboursees ?? 0 }}</div>
    <div class="fin-kpi-sub">totalement</div>
  </div>
  <div class="fin-kpi yellow">
    <div class="fin-kpi-label"><i class="fa-solid fa-circle-half-stroke"></i> Partielles</div>
    <div class="fin-kpi-value">{{ kpis.nb_partielles ?? 0 }}</div>
    <div class="fin-kpi-sub">partiellement remboursées</div>
  </div>
  <div class="fin-kpi red">
    <div class="fin-kpi-label"><i class="fa-solid fa-scissors"></i> Retenues</div>
    <div class="fin-kpi-value">{{ kpis.nb_retenues ?? 0 }}</div>
    <div class="fin-kpi-sub">avec déductions</div>
  </div>
</div>

{# ── Tableau ────────────────────────────────────────────────────── #}
<div class="fin-card">
  <div class="fin-card-title" ><i class="fa-solid fa-list"></i> Toutes les Cautions
    <span style="margin-left:auto; font-size:12px; font-weight:400; text-transform:none; letter-spacing:0;"><span id="table-count">{{ cautions|length }}</span> résultat(s)</span>
  </div>

  <div class="tabs" id="status-tabs">
    <button class="tab active" data-val="TOUS" onclick="setTab('TOUS', this)">Toutes</button>
    <button class="tab" data-val="DETENU" onclick="setTab('DETENU', this)">🟢 Actives</button>
    <button class="tab" data-val="PARTIELLEMENT_REMBOURSE" onclick="setTab('PARTIELLEMENT_REMBOURSE', this)">🟡 Partielles</button>
    <button class="tab" data-val="TOTALEMENT_REMBOURSE" onclick="setTab('TOTALEMENT_REMBOURSE', this)">🔵 Remboursées</button>
    <button class="tab" data-val="RETENU" onclick="setTab('RETENU', this)">🔴 Retenues</button>
  </div>

  <div class="fin-filter-bar">
    <div style="flex:1; min-width:250px; position:relative;">
      <i class="fa-solid fa-search" style="position:absolute; left:14px; top:12px;"></i>
      <input type="text" id="f-search" class="fin-filter-input" placeholder="Rechercher locataire, bien..." style="width:100%; padding-left:36px;" oninput="filterTable()">
    </div>
    
    <button onclick="document.getElementById('f-search').value='';filterTable();" style="padding:9px 14px; border:none; border-radius:10px; cursor:pointer; font-size:13px; font-weight:600; display:flex; align-items:center; gap:6px;">
      <i class="fa-solid fa-rotate-left"></i> RàZ
    </button>
    
    <div style="display:flex; align-items:center; gap:8px; font-size:13px; padding:8px 12px; border-radius:10px; border:1px solid #e5e7eb;">
      <i class="fa-solid fa-list-ol"></i> Lignes:
      <select id="f-limit" onchange="filterTable()" style="border:none; background:transparent; font-weight:600; cursor:pointer; outline:none;">
        <option value="10">10</option>
        <option value="25">25</option>
        <option value="50">50</option>
        <option value="100">100</option>
      </select>
    </div>
  </div>

  <div style="overflow-x:auto;">
    <table class="fin-table" id="cautions-table">
      <thead><tr>
        <th>#</th><th>Locataire</th><th>Propriétaire</th><th>Bien</th>
        <th>Initial</th><th>Retenu</th><th>Remboursé</th><th>Solde</th><th>Statut</th><th>Action</th>
      </tr></thead>
      <tbody>
        {% for ca in cautions %}
        <tr data-search="{{ (ca.nom_locataire ~ ' ' ~ ca.bien_titre ~ ' ' ~ ca.nom_proprietaire)|lower }}"
            data-statut="{{ ca.statut }}">
          <td style="font-weight:700;">#{{ ca.id }}</td>
          <td><strong>{{ ca.nom_locataire }}</strong><br><span style="font-size:11px;">{{ ca.email_locataire }}</span></td>
          <td>{{ ca.nom_proprietaire ?? '-' }}</td>
          <td style="max-width:130px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;" title="{{ ca.bien_titre }}">{{ ca.bien_titre ?? '-' }}</td>
          <td><strong>{{ ca.montant_initial|number_format(3,',', ' ') }} TND</strong></td>
          <td>
            {% if ca.montant_retention > 0 %}
              <span style="font-weight:600;">{{ ca.montant_retention|number_format(3,',', ' ') }}</span>
            {% else %}—{% endif %}
          </td>
          <td>
            {% if ca.montant_rembourse > 0 %}
              <span style="font-weight:600;">{{ ca.montant_rembourse|number_format(3,',', ' ') }}</span>
            {% else %}—{% endif %}
          </td>
          <td><strong >{{ ca.montant_disponible|number_format(3,',', ' ') }} TND</strong></td>
          <td>
            {% if ca.statut in ['DETENU', 'DÉTENU'] %}<span class="badge-detenu">DÉTENU</span>
            {% elseif 'REMBOURSE' in ca.statut %}<span class="badge-remb">{{ ca.statut|replace({'_': ' '}) }}</span>
            {% else %}<span class="badge-retenu">{{ ca.statut|replace({'_': ' '}) }}</span>{% endif %}
          </td>
          <td><a href="{{ path('admin_finance_caution_detail', {id: ca.id}) }}" class="fin-action-btn"><i class="fa-solid fa-arrow-right"></i> Détail</a></td>
        </tr>
        {% else %}
        <tr class="no-data-row"><td colspan="10" style="text-align:center; padding:40px;"><i class="fa-solid fa-folder-open fa-2x mb-2" style="opacity:0.5; display:block;"></i> Aucune caution.</td></tr>
        {% endfor %}
      </tbody>
    </table>
    <div id="no-result" style="display:none; text-align:center; padding:40px;">
      <i class="fa-solid fa-search fa-2x" style="opacity:0.3; display:block; margin-bottom:10px;"></i>
      Aucun résultat.
    </div>
  </div>
  
  <div class="fin-pagination-container">
    <div id="pagination-info" style="font-size:12px; font-weight:600;"></div>
    <div id="pagination-controls" class="fin-pagination"></div>
  </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<style>
.fin-pagination-container { display:flex; justify-content:space-between; align-items:center; padding:16px 0 0 0; margin-top:20px; border-top:1px solid #f3f4f6; flex-wrap:wrap; gap:16px; }
.fin-pagination { display:flex; gap:6px; }
.fin-page-btn { width:32px; height:32px; border-radius:8px; border:1px solid #e5e7eb; background:white; display:flex; align-items:center; justify-content:center; font-size:13px; font-weight:600; color:#4b5563; cursor:pointer; transition:all 0.2s; }
.fin-page-btn:hover:not(:disabled) { background:#f3f4f6; color:#111827; }
.fin-page-btn.active { background:#16a34a; color:white; border-color:#16a34a; }
.fin-page-btn:disabled { opacity:0.5; cursor:not-allowed; }
</style>
<script>
let currentTab = 'TOUS';
let currentPage = 1;

document.addEventListener('DOMContentLoaded', () => {
  filterTable();
});

function setTab(tab, btn) {
  currentTab = tab;
  currentPage = 1;
  document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
  btn.classList.add('active');
  filterTable();
}

function filterTable() {
  const search = document.getElementById('f-search').value.toLowerCase();
  const limit = parseInt(document.getElementById('f-limit').value);
  const rows = Array.from(document.querySelectorAll('#cautions-table tbody tr[data-search]'));
  
  let filteredRows = rows.filter(row => {
    const matchSearch = !search || row.dataset.search.includes(search);
    const matchTab = currentTab === 'TOUS' || row.dataset.statut === currentTab
      || (currentTab === 'DETENU' && (row.dataset.statut === 'DÉTENU' || row.dataset.statut === 'DETENU'));
    return matchSearch && matchTab;
  });
  
  rows.forEach(r => r.style.display = 'none');
  document.querySelector('.no-data-row') && (document.querySelector('.no-data-row').style.display = 'none');
  
  const total = filteredRows.length;
  document.getElementById('table-count').textContent = total;
  document.getElementById('no-result').style.display = total === 0 ? 'block' : 'none';
  
  if (total === 0) {
    renderPagination(0, limit);
    document.getElementById('pagination-info').innerText = '';
    return;
  }
  
  const totalPages = Math.ceil(total / limit);
  if (currentPage > totalPages) currentPage = totalPages;
  const start = (currentPage - 1) * limit;
  const end = start + limit;
  
  filteredRows.slice(start, end).forEach(r => r.style.display = '');
  document.getElementById('pagination-info').innerHTML = `Affichage de <strong >${start + 1}</strong> à <strong >${Math.min(end, total)}</strong> sur <strong >${total}</strong> entrées`;
  renderPagination(totalPages, limit);
}

function renderPagination(totalPages, limit) {
  const container = document.getElementById('pagination-controls');
  container.innerHTML = '';
  if (totalPages <= 1) return;
  
  let prev = document.createElement('button');
  prev.innerHTML = '<i class="fa-solid fa-chevron-left"></i>';
  prev.className = 'fin-page-btn';
  prev.disabled = currentPage === 1;
  prev.onclick = () => { currentPage--; filterTable(); };
  container.appendChild(prev);
  
  let startP = Math.max(1, currentPage - 2);
  let endP = Math.min(totalPages, currentPage + 2);
  
  if (startP > 1) {
    let b = document.createElement('button'); b.className='fin-page-btn'; b.innerText='1'; b.onclick=()=>{currentPage=1; filterTable();}; container.appendChild(b);
    if (startP > 2) { let dot = document.createElement('span'); dot.style.padding='4px 8px'; dot.innerText='...'; container.appendChild(dot); }
  }
  
  for(let i=startP; i<=endP; i++){
    let b = document.createElement('button');
    b.className = 'fin-page-btn' + (i === currentPage ? ' active' : '');
    b.innerText = i;
    b.onclick = () => { currentPage = i; filterTable(); };
    container.appendChild(b);
  }
  
  if (endP < totalPages) {
    if (endP < totalPages - 1) { let dot = document.createElement('span'); dot.style.padding='4px 8px'; dot.innerText='...'; container.appendChild(dot); }
    let b = document.createElement('button'); b.className='fin-page-btn'; b.innerText=totalPages; b.onclick=()=>{currentPage=totalPages; filterTable();}; container.appendChild(b);
  }
  
  let next = document.createElement('button');
  next.innerHTML = '<i class="fa-solid fa-chevron-right"></i>';
  next.className = 'fin-page-btn';
  next.disabled = currentPage === totalPages;
  next.onclick = () => { currentPage++; filterTable(); };
  container.appendChild(next);
}

function exportToCSV() {
  let csv = "ID,Locataire,Propriétaire,Bien,Initial,Retenu,Remboursé,Solde,Statut\n";
  document.querySelectorAll('#cautions-table tbody tr[data-search]').forEach(row => {
    const search = document.getElementById('f-search').value.toLowerCase();
    const matchSearch = !search || row.dataset.search.includes(search);
    const matchTab = currentTab === 'TOUS' || row.dataset.statut === currentTab
      || (currentTab === 'DETENU' && (row.dataset.statut === 'DÉTENU' || row.dataset.statut === 'DETENU'));
    if (matchSearch && matchTab) {
      const c = row.querySelectorAll('td');
      csv += [0,1,2,3,4,5,6,7,8].map(i=>`"${c[i]?.innerText.trim().replace(/\n/g,' ').replace(/"/g,'""')}"`).join(',') + '\n';
    }
  });
  const blob = new Blob(['\ufeff'+csv],{type:'text/csv;charset=utf-8;'});
  const a = document.createElement('a');a.href=URL.createObjectURL(blob);
  a.download='cautions_sakan_'+new Date().toISOString().slice(0,10)+'.csv';
  document.body.appendChild(a);a.click();document.body.removeChild(a);
}

document.addEventListener('DOMContentLoaded', () => {
  document.querySelectorAll('.sidebar-group').forEach(g => { g.style.listStyle = 'none'; });
});
</script>
{% endblock %}
