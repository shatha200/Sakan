{% extends 'layouts/base_admin.html.twig' %}

{% block title %}Contrats - Admin{% endblock %}
{% block page_title %}Gestion des contrats{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
  .sig-badge { display:inline-flex;align-items:center;gap:4px;font-size:11px;font-weight:600;padding:2px 8px;border-radius:20px; }
  .sig-ok  { background:#e6f9f0;color:#1a9e5c; }
  .sig-off { background:#f5f5f5;color:#aaa; }
  .contrat-annonce { font-size:12px;color:#888;margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:160px; }
  .contrat-dates   { font-size:12px;color:#555; }
  .contrat-montant { font-weight:700;color:#1e293b;font-size:14px; }
  .badge-actif-c   { background:#e6f9f0;color:#1a9e5c; }
  .badge-attente-c { background:#fff3e0;color:#d97706; }
  .badge-resil-c   { background:#fef2f2;color:#dc2626; }
  .badge-other-c   { background:#f0f0f0;color:#666; }
  .user-cell       { display:flex;flex-direction:column;gap:1px; }
  .user-cell-name  { font-weight:600;font-size:13px;color:#1e293b; }
  .user-cell-email { font-size:11px;color:#94a3b8; }
</style>
{% endblock %}

{% block content %}
  <section class="admin-kpi-grid admin-kpi-grid-users">
    <article class="admin-mini-kpi"><span>Total</span><strong>{{ stats.total }}</strong></article>
    <article class="admin-mini-kpi"><span>Actifs</span><strong>{{ stats.active }}</strong></article>
    <article class="admin-mini-kpi"><span>Résiliés</span><strong>{{ stats.ended }}</strong></article>
    <article class="admin-mini-kpi"><span>En attente</span><strong>{{ stats.pending }}</strong></article>
  </section>

  <section class="card admin-soft-card">
    <div class="admin-inline-filters">
      <input id="js-contrat-search" class="form-input" type="text" placeholder="Rechercher contrat, client, bien…" value="{{ filters.q }}">
      <select id="js-contrat-status" class="form-input">
        {% for option in status_options %}
          <option value="{{ option }}" {{ filters.status == option ? 'selected' : '' }}>{{ option }}</option>
        {% endfor %}
      </select>
      <button class="btn-secondary" type="button" onclick="resetContratsFilters()">Réinitialiser</button>
    </div>

    <div class="admin-table-wrap">
      <table class="sakan-table">
        <thead>
          <tr>
            <th>#</th>
            <th>Bien (annonce)</th>
            <th>Locataire</th>
            <th>Propriétaire</th>
            <th>Montant</th>
            <th>Période</th>
            <th>Signatures</th>
            <th>Statut</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          {% if contrats is empty %}
            <tr><td class="admin-empty" colspan="9">Aucun contrat trouvé.</td></tr>
          {% else %}
            {% for item in contrats %}
              {% set statut_up = item.statut|upper %}
              {% if 'ACTIF' in statut_up %}
                {% set badge_class = 'badge-actif-c' %}
              {% elseif 'ATTENTE' in statut_up or 'SIGNATURE' in statut_up or 'PENDING' in statut_up %}
                {% set badge_class = 'badge-attente-c' %}
              {% elseif 'RESIL' in statut_up or 'TERMINE' in statut_up %}
                {% set badge_class = 'badge-resil-c' %}
              {% else %}
                {% set badge_class = 'badge-other-c' %}
              {% endif %}

              <tr data-search="{{ (item.label ~ ' ' ~ item.locataire_nom ~ ' ' ~ item.locataire_email ~ ' ' ~ item.proprietaire_nom ~ ' ' ~ item.annonce_titre)|lower }}"
                  data-statut="{{ statut_up }}">
                <td style="font-weight:700;color:#4a6cf7;">{{ item.label }}</td>
                <td>
                  <div style="font-size:13px;font-weight:600;color:#1e293b;max-width:180px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                    {{ item.annonce_titre }}
                  </div>
                </td>
                <td>
                  <div class="user-cell">
                    <span class="user-cell-name">{{ item.locataire_nom }}</span>
                    {% if item.locataire_email %}<span class="user-cell-email">{{ item.locataire_email }}</span>{% endif %}
                  </div>
                </td>
                <td>
                  <div class="user-cell">
                    <span class="user-cell-name">{{ item.proprietaire_nom }}</span>
                    {% if item.proprietaire_email %}<span class="user-cell-email">{{ item.proprietaire_email }}</span>{% endif %}
                  </div>
                </td>
                <td>
                  <span class="contrat-montant">{{ item.montant != '-' ? item.montant ~ ' TND' : '-' }}</span>
                </td>
                <td>
                  <div class="contrat-dates">
                    {% if item.date_debut %}
                      <div>Du {{ item.date_debut|date('d/m/Y') }}</div>
                    {% endif %}
                    {% if item.date_fin %}
                      <div>Au {{ item.date_fin|date('d/m/Y') }}</div>
                    {% endif %}
                    {% if not item.date_debut and not item.date_fin %}-{% endif %}
                  </div>
                </td>
                <td>
                  <div style="display:flex;flex-direction:column;gap:4px;">
                    <span class="sig-badge {{ item.signe_locataire ? 'sig-ok' : 'sig-off' }}">
                      <i class="fa-solid {{ item.signe_locataire ? 'fa-circle-check' : 'fa-circle-xmark' }}"></i>
                      Locataire
                    </span>
                    <span class="sig-badge {{ item.signe_proprietaire ? 'sig-ok' : 'sig-off' }}">
                      <i class="fa-solid {{ item.signe_proprietaire ? 'fa-circle-check' : 'fa-circle-xmark' }}"></i>
                      Propriétaire
                    </span>
                  </div>
                </td>
                <td>
                  <span class="badge {{ badge_class }}" style="padding:3px 10px;border-radius:20px;font-size:11px;font-weight:600;">
                    {{ item.statut }}
                  </span>
                </td>
                <td>
                  <div class="admin-row-actions">
                    <form method="post" action="{{ path('admin_contrats') }}" class="admin-inline-form">
                      <input type="hidden" name="action" value="update_contrat_status">
                      <input type="hidden" name="contrat_id" value="{{ item.id }}">
                      <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_contrat_' ~ item.id) }}">
                      <select class="form-input form-input-sm" name="statut">
                        <option value="ACTIF"              {{ 'ACTIF'      in statut_up ? 'selected' : '' }}>ACTIF</option>
                        <option value="EN_ATTENTE_SIGNATURE" {{ 'ATTENTE' in statut_up ? 'selected' : '' }}>EN ATTENTE</option>
                        <option value="RESILIE"            {{ 'RESIL'      in statut_up ? 'selected' : '' }}>RÉSILIÉ</option>
                        <option value="TERMINE"            {{ 'TERMIN'     in statut_up ? 'selected' : '' }}>TERMINÉ</option>
                      </select>
                      <button class="btn-secondary btn-sm" type="submit" title="Enregistrer"><i class="fa-solid fa-floppy-disk"></i></button>
                    </form>

                    <form method="post" action="{{ path('admin_contrats') }}" onsubmit="return confirm('Supprimer ce contrat ?');">
                      <input type="hidden" name="action" value="delete_contrat">
                      <input type="hidden" name="contrat_id" value="{{ item.id }}">
                      <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_contrat_' ~ item.id) }}">
                      <button class="btn-danger btn-sm" type="submit"><i class="fa-solid fa-trash"></i></button>
                    </form>
                  </div>
                </td>
              </tr>
            {% endfor %}
          {% endif %}
        </tbody>
      </table>
    </div>
  </section>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
  function applyContratsFilters() {
    var q = (document.getElementById('js-contrat-search').value || '').toLowerCase().trim();
    var s = (document.getElementById('js-contrat-status').value || '').toUpperCase();

    document.querySelectorAll('tbody tr[data-search]').forEach(function(row) {
      var matchQ = q === '' || (row.dataset.search || '').includes(q);
      var matchS = s === '' || s === 'TOUS' || (row.dataset.statut || '').includes(s);
      row.style.display = (matchQ && matchS) ? '' : 'none';
    });
  }

  function resetContratsFilters() {
    document.getElementById('js-contrat-search').value = '';
    document.getElementById('js-contrat-status').value = '{{ status_options|first }}';
    applyContratsFilters();
  }

  document.getElementById('js-contrat-search').addEventListener('input', applyContratsFilters);
  document.getElementById('js-contrat-status').addEventListener('change', applyContratsFilters);
</script>
{% endblock %}
