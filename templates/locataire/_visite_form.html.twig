<div class="glass-form-fragment" style="padding: 10px;">
    {# Zone d'affichage des erreurs spécifiques #}
    {% for message in app.flashes('danger') %}
        <div style="background: #fee2e2; border: 1px solid #f87171; color: #991b1b; padding: 12px 16px; border-radius: 12px; margin-bottom: 20px; font-size: 13px; display: flex; align-items: center; gap: 10px; animation: slideIn 0.3s ease;">
            <i class="fa-solid fa-circle-exclamation"></i>
            <span>{{ message }}</span>
        </div>
    {% endfor %}
    {% for message in app.flashes('warning') %}
        <div style="background: #fffbeb; border: 1px solid #fbbf24; color: #92400e; padding: 12px 16px; border-radius: 12px; margin-bottom: 20px; font-size: 13px; display: flex; align-items: center; gap: 10px; animation: slideIn 0.3s ease;">
            <i class="fa-solid fa-lightbulb"></i>
            <span>{{ message }}</span>
        </div>
    {% endfor %}

    {{ form_start(form, {'action': path('tenant_visite_edit', {'id': visite.id})}) }}
        {# Erreurs globales #}
        <div class="sakan-form-errors" style="color: #dc2626; font-size: 13px; margin-bottom: 15px;">
            {{ form_errors(form) }}
        </div>

        <div style="margin-bottom: 24px;">
            <label style="font-weight: 600; font-size: 14px; margin-bottom: 8px; display: block;">Date et Heure du rendez-vous</label>
            {{ form_widget(form.dateHeure, {'attr': {'class': 'sakan-input'}}) }}
            <div style="color: #dc2626; font-size: 12px; margin-top: 5px; font-weight: 600;">{{ form_errors(form.dateHeure) }}</div>
        </div>
        <div style="margin-bottom: 24px;">
            <label style="font-weight: 600; font-size: 14px; margin-bottom: 8px; display: block;">Commentaire (Optionnel)</label>
            {{ form_widget(form.commentaire, {'attr': {'class': 'sakan-input', 'rows': 3}}) }}
        </div>
        <button type="submit" class="btn-primary" style="width: 100%; justify-content: center; height: 50px; border-radius: 12px;">
            Modifier le rendez-vous
        </button>
    {{ form_end(form) }}
</div>
