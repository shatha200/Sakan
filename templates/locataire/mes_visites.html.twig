{% extends 'layouts/base_locataire.html.twig' %}

{% block title %}Mes Rendez-vous — Sakan{% endblock %}
{% block page_title %}Mes Rendez-vous{% endblock %}
{% block page_subtitle %}Retrouvez ici le planning de vos visites à venir.{% endblock %}

{% block content %}
    {# Flash messages #}
    {% for label, messages in app.flashes %}
        {% if label != 'agenda_url' %}
            {% for message in messages %}
                <div class="alert alert-{{ label == 'error' ? 'danger' : label }}" style="padding: 12px 20px; margin-bottom: 20px; border-radius: 12px; background: {{ label == 'success' ? '#d1fae5' : (label == 'error' or label == 'danger' ? '#fee2e2' : '#fef3c7') }}; color: {{ label == 'success' ? '#065f46' : (label == 'error' or label == 'danger' ? '#991b1b' : '#92400e') }}; border: 1px solid {{ label == 'success' ? '#a7f3d0' : (label == 'error' or label == 'danger' ? '#fecaca' : '#fde68a') }};">
                    <i class="fa-solid {{ label == 'success' ? 'fa-check-circle' : (label == 'error' or label == 'danger' ? 'fa-exclamation-circle' : 'fa-info-circle') }}"></i> {{ message }}
                </div>
            {% endfor %}
        {% endif %}
    {% endfor %}

    {% for message in app.flashes('agenda_url') %}
        <div style="background: linear-gradient(135deg, #4285f4, #34a853); padding: 20px; border-radius: 12px; margin-bottom: 20px; color: white; display: flex; align-items: center; justify-content: space-between; box-shadow: 0 10px 15px -3px rgba(66, 133, 244, 0.3);">
            <div style="display: flex; align-items: center; gap: 15px;">
                <i class="fa-solid fa-calendar-check" style="font-size: 32px;"></i>
                <div>
                    <h3 style="margin: 0; font-size: 16px; font-weight: 700;">Visite confirmée !</h3>
                    <p style="margin: 5px 0 0 0; font-size: 13px; opacity: 0.9;">N'oubliez pas d'ajouter cette visite à votre agenda Google.</p>
                </div>
            </div>
            <a href="{{ message|raw }}" target="_blank" class="btn-primary" style="background: white; color: #4285f4; border: none; padding: 10px 20px; font-weight: 700; border-radius: 8px; text-decoration: none;">
                Ouvrir Google Agenda
            </a>
        </div>
    {% endfor %}

    <div style="display: flex; justify-content: flex-end; margin-bottom: 25px;">
        <a href="{{ path('tenant_visites_optimize') }}" class="btn-primary" style="background: linear-gradient(135deg, #6366f1, #a855f7); border: none; padding: 12px 24px; border-radius: 12px; font-weight: 700; display: flex; align-items: center; gap: 10px; box-shadow: 0 10px 15px -3px rgba(99, 102, 241, 0.3); text-decoration: none;">
            <i class="fa-solid fa-route"></i> Optimiser mon itinéraire (IA)
        </a>
    </div>

    <div class="annonces-grid">
        {% for item in visites %}
            {% set visite = item.entity %}
            {% set weather = item.weather %}
            {% set passUrl = item.pass_url %}
            <div class="annonce-card" style="height: auto; border: 1px solid var(--border); overflow: hidden; display: flex; flex-direction: column; background: white; border-radius: 24px; transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1); position: relative;">
                {# Weather Badge (IA Smart Logic) #}
                <div style="position: absolute; top: 15px; left: 15px; background: rgba(255,255,255,0.9); backdrop-filter: blur(4px); padding: 6px 12px; border-radius: 50px; display: flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 700; color: var(--blue-dark); border: 1px solid var(--border); z-index: 10;" title="{{ weather.desc }}">
                    <span style="font-size: 18px;">{{ weather.icon }}</span>
                    <span>{{ weather.temp }}</span>
                </div>
                <div class="card-body" style="padding: 24px; flex: 1; display: flex; flex-direction: column;">
                    <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; margin-bottom: 20px;">
                        <h3 class="card-titre" style="font-size: 20px; color: var(--blue-dark); font-weight: 700; margin: 0; line-height: 1.2;">
                            {{ visite.annonce.titre }}
                        </h3>
                        
                        {% set statut_class = 'en-attente' %}
                        {% if visite.statut|lower in ['confirmée', 'confirmee', 'confirmé', 'confirme'] %}{% set statut_class = 'disponible' %}{% endif %}
                        {% if visite.statut|lower == 'annulée' %}{% set statut_class = 'reserve' %}{% endif %}
                        
                        <span class="badge {{ statut_class == 'disponible' ? 'badge-ok' : (statut_class == 'reserve' ? 'badge-err' : 'badge-warn') }}" style="font-size: 11px;">
                            {{ visite.statut }}
                        </span>
                    </div>
                    
                    <div style="background: #f8fafc; padding: 15px; border-radius: 12px; display: flex; text-align: center; margin-bottom: 20px; border: 1px solid var(--border);">
                        <div style="flex: 1; border-right: 1px solid var(--border);">
                            <div style="font-size: 10px; text-transform: uppercase; color: var(--text-muted); font-weight: 700; margin-bottom: 4px;">Date</div>
                            <div style="font-weight: 700; font-size: 14px;">{{ visite.dateHeure|date('d/m/Y') }}</div>
                        </div>
                        <div style="flex: 1;">
                            <div style="font-size: 10px; text-transform: uppercase; color: var(--text-muted); font-weight: 700; margin-bottom: 4px;">Heure</div>
                            <div style="font-weight: 700; font-size: 14px;">{{ visite.dateHeure|date('H:i') }}</div>
                        </div>
                    </div>

                    {% if visite.commentaire %}
                        <div style="color: var(--text-muted); font-size: 13px; font-style: italic; margin-bottom: 20px; padding: 12px; background: rgba(0,0,0,0.02); border-radius: 12px;">
                            "{{ visite.commentaire }}"
                        </div>
                    {% endif %}
                    
                    <div style="margin-top: auto; display: flex; justify-content: flex-end; align-items: center; border-top: 1px solid var(--border); padding-top: 16px; gap: 8px; flex-wrap: wrap;">
                        {% set isPast = visite.dateHeure < date() %}
                        {% if visite.statut|lower in ['demande', 'en attente', 'confirmée', 'confirmee', 'confirmé', 'confirme'] %}
                            <button onclick="{{ isPast ? 'showPastVisiteWarning()' : "openEditModal('" ~ path('tenant_visite_edit', {'id': visite.id}) ~ "')" }}" 
                                    class="btn-secondary" 
                                    style="padding: 6px 12px; font-size: 12px; border-radius: 8px; cursor: pointer; display: flex; align-items: center; gap: 6px; border: 1px solid var(--blue); color: var(--blue); background: transparent; {{ isPast ? 'opacity: 0.5; cursor: not-allowed;' : '' }}">
                                <i class="fa-solid fa-pen"></i> Modifier
                            </button>
                            <form action="{{ path('tenant_visite_cancel', {'id': visite.id}) }}" method="POST" onsubmit="return confirm('Voulez-vous vraiment annuler cette demande de visite ?')">
                                <button type="submit" class="btn-primary" style="background: var(--danger); border-color: var(--danger); padding: 8px 16px; font-size: 12px; border-radius: 10px; font-weight: 700;">
                                    Annuler
                                </button>
                            </form>
                            
                            {% if passUrl %}
                                <button onclick="showPassModal('{{ passUrl }}')" class="btn-primary" style="background: var(--blue-dark); border: none; padding: 8px 16px; font-size: 12px; border-radius: 10px; font-weight: 700; display: flex; align-items: center; gap: 6px;">
                                    <i class="fa-solid fa-qrcode"></i> Mon Pass
                                </button>
                            {% endif %}
                        {% else %}
                            <span style="font-size: 12px; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px;">Terminée</span>
                        {% endif %}
                    </div>
                </div>
            </div>
        {% else %}
            <div style="grid-column: 1 / -1; text-align: center; padding: 100px 0;">
                <i class="fa-solid fa-calendar-xmark" style="font-size: 60px; color: var(--border); margin-bottom: 24px; display: block;"></i>
                <p style="color: var(--text-muted); font-size: 18px;">Aucune visite programmée.</p>
                <a href="{{ path('tenant_catalogue') }}" class="btn-primary" style="margin-top: 24px; text-decoration: none;">Planifier une visite</a>
            </div>
        {% endfor %}
    </div>

    <!-- MODALE PASS VISITE (IA Feature) -->
    <div id="pass-modal" class="modal-overlay" style="display: none; align-items: center; justify-content: center; z-index: 3000; background: rgba(0,0,0,0.8); backdrop-filter: blur(10px); position: fixed; top: 0; left: 0; right: 0; bottom: 0;">
        <div style="background: white; padding: 40px; border-radius: 32px; text-align: center; max-width: 400px; width: 90%; position: relative; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.5);">
            <button onclick="closePassModal()" style="position: absolute; top: 20px; right: 20px; border: none; background: #f1f5f9; width: 35px; height: 35px; border-radius: 50%; cursor: pointer; color: #64748b; font-size: 20px;">×</button>
            <h3 style="color: var(--blue-dark); margin-bottom: 5px; font-weight: 800;">Pass de Visite Sakan</h3>
            <p style="color: var(--text-muted); font-size: 14px; margin-bottom: 25px;">Présentez ce QR code au propriétaire le jour J.</p>
            <div style="background: #f8fafc; padding: 20px; border-radius: 20px; margin-bottom: 25px; border: 2px dashed var(--border);">
                <img id="pass-qr-img" src="" alt="QR Code" style="width: 200px; height: 200px; border-radius: 12px; display: block; margin: 0 auto; box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1);">
            </div>
            <button onclick="window.print()" class="btn-secondary" style="width: 100%; border-radius: 12px; font-weight: 700; padding: 12px;"><i class="fa-solid fa-print"></i> Imprimer le pass</button>
        </div>
    </div>

    <!-- MODALE DE MODIFICATION -->
    <div id="edit-modal" class="modal-overlay" style="display: none; align-items: center; justify-content: center; z-index: 2000; background: rgba(0,0,0,0.7); backdrop-filter: blur(8px); position: fixed; top: 0; left: 0; right: 0; bottom: 0;">
        <div class="glass-card" style="width: 90%; max-width: 500px; padding: 40px; background: white; border-radius: 24px; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.5); position: relative;">
            <button onclick="closeEditModal()" style="position: absolute; top: 20px; right: 20px; border: none; background: #f1f5f9; width: 35px; height: 35px; border-radius: 50%; cursor: pointer; color: var(--text-muted); display: flex; align-items: center; justify-content: center;">×</button>
            <div id="modal-loader" style="text-align: center; padding: 40px; display: none;">
                <i class="fa-solid fa-circle-notch fa-spin" style="font-size: 32px; color: var(--blue);"></i>
                <p style="margin-top: 15px; color: var(--text-muted);">Chargement du rendez-vous...</p>
            </div>
            <div id="modal-body"></div>
        </div>
    </div>

    <script>
        function showPassModal(url) {
            const modal = document.getElementById('pass-modal');
            const img = document.getElementById('pass-qr-img');
            img.src = url;
            modal.style.display = 'flex';
        }

        function closePassModal() {
            document.getElementById('pass-modal').style.display = 'none';
        }

        async function openEditModal(url) {
            /**
             * Ouvre la modale et configure la soumission AJAX
             */
            const modal = document.getElementById('edit-modal');
            const body = document.getElementById('modal-body');
            const loader = document.getElementById('modal-loader');
            
            modal.style.display = 'flex';
            body.innerHTML = '';
            loader.style.display = 'block';

            try {
                const ajaxUrl = url + (url.includes('?') ? '&' : '?') + 'ajax=1';
                const response = await fetch(ajaxUrl, {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                
                if (!response.ok) throw new Error("Erreur serveur (" + response.status + ")");
                
                const data = await response.json();
                
                loader.style.display = 'none';
                body.innerHTML = '<div style="text-align:center; margin-bottom:20px;"><h3 style="color:var(--blue-dark);">Modifier le rendez-vous</h3></div>';
                
                if (data.html) {
                    body.insertAdjacentHTML('beforeend', data.html);
                    const form = body.querySelector('form');
                    if (form) setupAjaxForm(form, body);
                } else {
                    throw new Error("Impossible de charger le formulaire.");
                }
            } catch (err) {
                console.error("AJAX Error:", err);
                loader.style.display = 'none';
                body.innerHTML = `
                    <div style="text-align:center; padding: 20px;">
                        <i class="fa-solid fa-triangle-exclamation" style="font-size: 40px; color: var(--err); margin-bottom: 15px;"></i>
                        <p style="font-weight: 700; color: var(--blue-dark);">Oops ! Une erreur est survenue.</p>
                        <p style="color: var(--text-muted); font-size: 14px;">${err.message}</p>
                        <button onclick="closeEditModal()" class="btn-secondary" style="margin-top:20px;">Fermer</button>
                    </div>
                `;
            }
        }

        /**
         * Intercepte la soumission du formulaire pour l'envoyer via AJAX
         */
        function setupAjaxForm(form, container) {
            form.onsubmit = async (e) => {
                e.preventDefault();
                const submitBtn = form.querySelector('button[type="submit"]');
                const originalText = submitBtn.innerHTML;
                
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin"></i> Enregistrement...';

                try {
                    const formData = new FormData(form);
                    const ajaxUrl = form.action + (form.action.includes('?') ? '&' : '?') + 'ajax=1';
                    const response = await fetch(ajaxUrl, {
                        method: 'POST',
                        body: formData,
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    });

                    if (!response.ok) {
                        const text = await response.text();
                        console.error("Server Error:", text);
                        throw new Error("Erreur serveur (" + response.status + ").");
                    }

                    let data;
                    const responseClone = response.clone();
                    try {
                        data = await response.json();
                    } catch (parseError) {
                        const rawText = await responseClone.text();
                        console.error("Non-JSON Response detected:", rawText);
                        const snippet = rawText.substring(0, 200).replace(/</g, "&lt;").replace(/>/g, "&gt;");
                        throw new Error("Le serveur a renvoyé du HTML au lieu du JSON. Début de réponse : " + snippet);
                    }
                    
                    if (data.success) {
                        window.location.reload();
                    } else if (data.html) {
                        // Erreur de validation, on réaffiche le formulaire avec message
                        container.innerHTML = '<div style="text-align:center; margin-bottom:20px;"><h3 style="color:var(--blue-dark);">Modifier le rendez-vous</h3></div>';
                        container.insertAdjacentHTML('beforeend', data.html);
                        const newForm = container.querySelector('form');
                        if (newForm) setupAjaxForm(newForm, container);

                        if (typeof showSakanToast === 'function') {
                            showSakanToast("Veuillez corriger les erreurs.", "warning");
                        }
                    } else {
                        throw new Error("Format de réponse invalide");
                    }
                } catch (err) {
                    console.error("AJAX Error:", err);
                    const errorMsg = err.message.length < 100 ? err.message : "Erreur lors de l'enregistrement.";
                    if (typeof showSakanToast === 'function') {
                        showSakanToast(errorMsg, "danger");
                    } else {
                        alert(errorMsg);
                    }
                } finally {
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = originalText;
                }
            };
        }

        function closeEditModal() {
            document.getElementById('edit-modal').style.display = 'none';
        }

        function showPassModal(url) {
            document.getElementById('pass-qr-img').src = url;
            document.getElementById('pass-modal').style.display = 'flex';
        }

        function closePassModal() {
            document.getElementById('pass-modal').style.display = 'none';
        }

        window.onclick = function(event) {
            const modal = document.getElementById('edit-modal');
            const passModal = document.getElementById('pass-modal');
            if (event.target == modal) closeEditModal();
            if (event.target == passModal) closePassModal();
        }
    </script>
{% endblock %}
