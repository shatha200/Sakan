{% block javascripts %}
<script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>
<script>
(function() {
    var mapDiv  = document.getElementById('map-detail');
    var fallbck = document.getElementById('map-detail-fallback');
    if (!mapDiv || typeof L === 'undefined') return;

    var addr  = {{ ((a.adresse_text ?? '')|trim)|json_encode|raw }};
    var titre = {{ (a.titre ?? '')|json_encode|raw }};

    var map = L.map('map-detail', { zoomControl: true }).setView([33.8869, 9.5375], 7);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; OpenStreetMap contributors'
    }).addTo(map);

    // --- Overpass API: nearby places (1km radius) ---
    var nearbyCategories = [
        { label: 'Supermarché',       icon: '🏪', query: 'shop~"supermarket|convenience"' },
        { label: 'Boulangerie',       icon: '🥖', query: 'shop=bakery' },
        { label: 'École',             icon: '🏫', query: 'amenity~"school|university|college"' },
        { label: 'Pharmacie',         icon: '🏥', query: 'amenity=pharmacy' },
        { label: 'Mosquée',           icon: '🕌', query: 'amenity=place_of_worship' },
        { label: 'Arrêt de bus',      icon: '🚌', query: 'highway=bus_stop' },
        { label: 'Banque / ATM',      icon: '🏦', query: 'amenity~"bank|atm"' },
        { label: 'Café / Restaurant', icon: '☕', query: 'amenity~"cafe|restaurant"' }
    ];

    function matchCategory(tags) {
        if (!tags) return null;
        if (tags.shop === 'supermarket' || tags.shop === 'convenience') return nearbyCategories[0];
        if (tags.shop === 'bakery') return nearbyCategories[1];
        if (tags.amenity === 'school' || tags.amenity === 'university' || tags.amenity === 'college') return nearbyCategories[2];
        if (tags.amenity === 'pharmacy') return nearbyCategories[3];
        if (tags.amenity === 'place_of_worship') return nearbyCategories[4];
        if (tags.highway === 'bus_stop') return nearbyCategories[5];
        if (tags.amenity === 'bank' || tags.amenity === 'atm') return nearbyCategories[6];
        if (tags.amenity === 'cafe' || tags.amenity === 'restaurant') return nearbyCategories[7];
        return null;
    }

    function showNearbyLegend() {
        if (document.getElementById('nearby-legend')) return;
        var legend = document.createElement('div');
        legend.id = 'nearby-legend';
        legend.style.cssText = 'display:flex;flex-wrap:wrap;gap:8px;margin-top:10px;padding:10px;background:#f8f9fa;border-radius:8px;font-size:13px;';
        nearbyCategories.forEach(function(cat) {
            var item = document.createElement('span');
            item.style.cssText = 'display:inline-flex;align-items:center;gap:4px;padding:4px 10px;background:white;border-radius:20px;border:1px solid #dee2e6;';
            item.innerHTML = cat.icon + ' ' + cat.label;
            legend.appendChild(item);
        });
        mapDiv.parentNode.insertBefore(legend, mapDiv.nextSibling);
    }

    function showNearbyLoading() {
        if (document.getElementById('nearby-loading')) return;
        var loading = document.createElement('p');
        loading.id = 'nearby-loading';
        loading.style.cssText = 'font-size:13px;color:gray;margin-top:8px;';
        loading.innerText = '📍 Chargement des lieux à proximité...';
        mapDiv.parentNode.insertBefore(loading, mapDiv.nextSibling);
    }
    function hideNearbyLoading() {
        var el = document.getElementById('nearby-loading');
        if (el) el.remove();
    }

    function fetchNearbyPlaces(lat, lon) {
        var radius = 1000;
        var parts = nearbyCategories.map(function(cat) {
            return 'node[' + cat.query + '](around:' + radius + ',' + lat + ',' + lon + ');'
                 + 'way['  + cat.query + '](around:' + radius + ',' + lat + ',' + lon + ');';
        }).join('\n');
        var overpassQuery = '[out:json][timeout:25];(' + parts + ');out center;';
        return fetch('https://overpass-api.de/api/interpreter', {
            method: 'POST',
            body: overpassQuery
        }).then(function(r) { return r.json(); })
          .then(function(data) { return data.elements || []; })
          .catch(function() { return []; });
    }

    function addNearbyMarkers(lat, lon) {
        if (!lat || !lon || lat === 0 || lon === 0) return;
        showNearbyLoading();
        fetchNearbyPlaces(lat, lon).then(function(elements) {
            elements.forEach(function(el) {
                var elLat = el.lat || (el.center && el.center.lat);
                var elLon = el.lon || (el.center && el.center.lon);
                var name  = (el.tags && el.tags.name) ? el.tags.name : 'Sans nom';
                var cat = matchCategory(el.tags);
                if (!cat || !elLat || !elLon) return;
                var icon = L.divIcon({
                    html: '<div style="font-size:20px;filter:drop-shadow(1px 1px 2px rgba(0,0,0,0.4));">' + cat.icon + '</div>',
                    className: '',
                    iconSize: [28, 28],
                    iconAnchor: [14, 14]
                });
                L.marker([elLat, elLon], { icon: icon })
                    .addTo(map)
                    .bindPopup('<strong>' + cat.icon + ' ' + cat.label + '</strong><br>' + name.replace(/</g, '&lt;'));
            });
            if (elements.length > 0) showNearbyLegend();
        }).catch(function() {}).then(function() { hideNearbyLoading(); });
    }
    // --- end Overpass ---

    if (!addr) { if (fallbck) fallbck.style.display = 'block'; return; }

    var parts = addr.split(',').map(function(p){ return p.trim(); }).filter(function(p){ return p.length > 0; });
    var queries = [addr];
    if (parts.length > 3) {
        queries.push(parts[0] + ', ' + parts[parts.length - 1]);
    }
    if (parts.length > 0) {
        queries.push(parts[0]);
        queries.push(parts[parts.length - 1]);
    }

    function tryGeocode(i) {
        if (i >= queries.length) {
            if (fallbck) fallbck.style.display = 'block';
            return;
        }
        fetch('https://nominatim.openstreetmap.org/search?q=' + encodeURIComponent(queries[i]) + '&countrycodes=tn&format=json&limit=1', {
            headers: { 'User-Agent': 'SakanApp/1.0 (esprit.tn)' }
        })
        .then(function(r) { return r.json(); })
        .then(function(results) {
            if (results && results.length > 0) {
                var lat = parseFloat(results[0].lat);
                var lng = parseFloat(results[0].lon);
                map.setView([lat, lng], 14);
                L.marker([lat, lng], { draggable: false })
                    .addTo(map)
                    .bindPopup('<strong>' + titre.replace(/</g,'&lt;') + '</strong><br>' + addr.replace(/</g,'&lt;'))
                    .openPopup();
                setTimeout(function() { addNearbyMarkers(lat, lng); }, 1000);
            } else {
                tryGeocode(i + 1);
            }
        })
        .catch(function() {
            tryGeocode(i + 1);
        });
    }
    tryGeocode(0);
})();
</script>
<script>
    function showModal(id) { document.getElementById(id).style.display = 'flex'; }
    function closeModal(id) { document.getElementById(id).style.display = 'none'; }
    
    // --- Logic Système Expert : Simulateur de Budget ---
    const startDateInput = document.getElementById('res-date-start');
    const endDateInput = document.getElementById('res-date-end');
    const budgetDiv = document.getElementById('budget-simulator');
    const budgetDetails = document.getElementById('budget-details');
    const budgetLoader = document.getElementById('budget-loader');

    const updateBudget = async () => {
        const start = startDateInput.value;
        const end = endDateInput.value;
        const price = {{ a.prix|default(0) }};

        if (start && end && price > 0) {
            budgetDiv.style.display = 'block';
            budgetDetails.style.opacity = '0.3';
            budgetLoader.style.display = 'block';

            try {
                const formData = new FormData();
                formData.append('price', price);
                formData.append('start', start);
                formData.append('end', end);

                const response = await fetch('{{ path('api_reservation_simulate') }}', {
                    method: 'POST',
                    body: formData,
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });

                const data = await response.json();
                budgetLoader.style.display = 'none';
                budgetDetails.style.opacity = '1';

                if (data.total_tnd) {
                    document.getElementById('total-tnd').innerText = data.total_tnd.toLocaleString() + ' TND';
                    document.getElementById('total-eur').innerText = data.total_eur ? data.total_eur.toLocaleString() + ' EUR' : '--';
                    
                    if (typeof showSakanToast === 'function' && data.duration_months < 1) {
                        showSakanToast("Expert Conseil : Notez que cette réservation est courte (moins d'un mois).", "info");
                    }
                } else if (data.error) {
                    document.getElementById('total-tnd').innerText = 'Dates invalides';
                }
            } catch (err) {
                console.error("Budget Simulation Error:", err);
                budgetLoader.style.display = 'none';
                budgetDetails.style.opacity = '1';
            }
        }
    };

    if (startDateInput) startDateInput.addEventListener('change', updateBudget);
    if (endDateInput) endDateInput.addEventListener('change', updateBudget);

    function showToast(msg) {
        const t = document.getElementById('toast');
        t.textContent = msg;
        t.style.display = 'block';
        setTimeout(() => t.style.display = 'none', 3500);
    }
    
    // Ajax Interceptor for Create Modals
    async function submitModalAjax(e, form) {
        e.preventDefault();
        const submitBtn = form.querySelector('button[type="submit"]');
        const originalHtml = submitBtn.innerHTML;
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin"></i> Traitement...';
        
        const isVisite = form.action.includes('visiter');
        const errorDiv = isVisite ? document.getElementById('visite-error') : document.getElementById('reservation-error');
        errorDiv.style.display = 'none';
        
        let successState = false;

        try {
            const formData = new FormData(form);
            const ajaxUrl = form.action + (form.action.includes('?') ? '&' : '?') + 'ajax=1';
            
            const req = await fetch(ajaxUrl, {
                method: 'POST',
                body: formData,
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });
            
            if (!req.ok) throw new Error("Erreur serveur ou de connexion.");
            
            const data = await req.json();
            
            if (data.success) {
                successState = true;
                if (data.agenda_url) {
                    // Inject Success Modal
                    form.innerHTML = `
                        <div class="modal-body" style="text-align: center; padding: 30px;">
                            <i class="fa-solid fa-circle-check" style="color: #10b981; font-size: 64px; margin-bottom: 20px;"></i>
                            <h2 style="color: var(--blue-dark); margin-bottom: 10px;">Visite planifiée !</h2>
                            <p style="color: var(--text-muted); margin-bottom: 25px;">Votre demande a été envoyée au propriétaire.</p>
                            
                            <div style="background: linear-gradient(135deg, #4285f4, #34a853); padding: 20px; border-radius: 12px; margin-bottom: 20px; color: white; display: flex; flex-direction: column; align-items: center; box-shadow: 0 10px 15px -3px rgba(66, 133, 244, 0.3);">
                                <i class="fa-solid fa-calendar-check" style="font-size: 32px; margin-bottom: 10px;"></i>
                                <h3 style="margin: 0 0 15px 0; font-size: 16px; font-weight: 700;">Ajoutez ce rendez-vous à votre agenda</h3>
                                <a href="${data.agenda_url}" target="_blank" class="btn-primary" style="background: white; color: #4285f4; border: none; padding: 10px 20px; font-weight: 700; border-radius: 8px; text-decoration: none; width: 100%; text-align: center;">
                                    <i class="fa-solid fa-plus"></i> Ouvrir Google Agenda
                                </a>
                            </div>
                        </div>
                        <div class="modal-footer" style="justify-content: center; border-top: 1px solid var(--border); padding-top: 20px;">
                            <a href="${data.redirect || '{{ path('tenant_catalogue') }}'}" class="btn-secondary" style="width: 100%; text-align: center; text-decoration: none;">Continuer vers Mes Visites</a>
                        </div>
                    `;
                } else {
                    // Inject Success Modal for Reservations
                    form.innerHTML = `
                        <div class="modal-body" style="text-align: center; padding: 30px;">
                            <i class="fa-solid fa-circle-check" style="color: #10b981; font-size: 64px; margin-bottom: 20px;"></i>
                            <h2 style="color: var(--blue-dark); margin-bottom: 10px;">Réservation envoyée !</h2>
                            <p style="color: var(--text-muted); margin-bottom: 25px;">Le propriétaire examinera votre demande très bientôt.</p>
                        </div>
                        <div class="modal-footer" style="justify-content: center; border-top: 1px solid var(--border); padding-top: 20px;">
                            <a href="${data.redirect || '{{ path('tenant_catalogue') }}'}" class="btn-primary" style="width: 100%; text-align: center; text-decoration: none;">Voir mes réservations</a>
                        </div>
                    `;
                }
            } else {
                if (data.is_holiday_warning) {
                    errorDiv.innerHTML = '<i class="fa-solid fa-bell"></i> ' + (data.error);
                    errorDiv.style.background = '#fffbeb';
                    errorDiv.style.color = '#b45309';
                    // Allow the user to bypass on next click
                    if (!form.querySelector('input[name="ignore_holiday"]')) {
                        const input = document.createElement('input');
                        input.type = 'hidden';
                        input.name = 'ignore_holiday';
                        input.value = '1';
                        form.appendChild(input);
                    }
                } else {
                    errorDiv.innerHTML = '<i class="fa-solid fa-triangle-exclamation"></i> ' + (data.error || "Une erreur inattendue est survenue.");
                }
                errorDiv.style.display = 'block';
            }
        } catch (err) {
            errorDiv.textContent = err.message;
            errorDiv.style.display = 'block';
        }

        if (!successState) {
            submitBtn.disabled = false;
            // Ne pas réécraser le bouton s'il a été changé en bypass
            if (!form.querySelector('input[name="ignore_holiday"]')) {
                submitBtn.innerHTML = originalHtml;
            } else {
                submitBtn.innerHTML = '<i class="fa-solid fa-forward"></i> Confirmer (Forcer)';
            }
        }
    }

    const FAV_CSRF = {{ csrf_token('tenant_wishlist_toggle')|json_encode|raw }};
    function toggleFavDetail(id) {
        const fd = new FormData();
        fd.append('_token', FAV_CSRF);
        fetch('/locataire/wishlist/toggle/' + id, { method: 'POST', body: fd, headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(r => r.json())
            .then(data => {
                if (!data.ok) { showToast('Erreur wishlist'); return; }
                const btn = document.getElementById('btn-fav');
                const lbl = document.getElementById('fav-label');
                if (data.added) {
                    btn.style.color = '#ef4444';
                    btn.style.borderColor = '#ef4444';
                    lbl.textContent = 'Retirer de la wishlist';
                    showToast('❤ Ajouté à la wishlist');
                } else {
                    btn.style.color = '';
                    btn.style.borderColor = '';
                    lbl.textContent = 'Ajouter à la wishlist';
                    showToast('Retiré de la wishlist');
                }
            });
    }
    function copyAddress() {
        navigator.clipboard.writeText({{ (a.adresse_text ?: '')|json_encode|raw }});
        showToast('📋 Adresse copiée !');
    }

    // Sélecteur d'étoiles interactif
    (function() {
        const container = document.getElementById('star-rating');
        if (!container) return;
        const input = document.getElementById('note-input');
        const stars = container.querySelectorAll('.star-btn');
        let current = parseInt(input.value) || 0;

        function renderStars(val) {
            stars.forEach(s => {
                const v = parseInt(s.dataset.value);
                s.className = v <= val ? 'fa-solid fa-star star-btn' : 'fa-regular fa-star star-btn';
            });
        }
        renderStars(current);

        stars.forEach(s => {
            s.addEventListener('mouseenter', () => renderStars(parseInt(s.dataset.value)));
            s.addEventListener('mouseleave', () => renderStars(current));
            s.addEventListener('click', () => {
                current = parseInt(s.dataset.value);
                input.value = current;
                renderStars(current);
            });
        });
    })();

    // Galerie photos avec flèches
    (function() {
        const images = [{% for img in a.images %}{{ (img | imagine_filter('annonce_watermark'))|json_encode|raw }}{% if not loop.last %},{% endif %}{% endfor %}];
        const total = images.length;
        if (total === 0) return;
        const hero = document.getElementById('hero-img');
        const counter = document.getElementById('gallery-counter');
        let idx = 0;

        window.setGallery = function(i) {
            idx = ((i % total) + total) % total;
            hero.src = images[idx];
            hero.dataset.index = idx;
            if (counter) counter.textContent = (idx + 1) + ' / ' + total;
            document.querySelectorAll('[data-thumb]').forEach(t => {
                t.style.borderColor = parseInt(t.dataset.thumb) === idx ? '#5E17EB' : 'transparent';
            });
        };
        window.navGallery = function(delta) { setGallery(idx + delta); };

        document.addEventListener('keydown', e => {
            if (e.key === 'ArrowLeft')  navGallery(-1);
            if (e.key === 'ArrowRight') navGallery(1);
        });
    })();

    // Minuteur temps réel
    (function() {
        const el = document.getElementById('loc-countdown');
        if (!el) return;
        let sec = parseInt(el.dataset.seconds) || 0;
        const jEl = document.getElementById('lc-j');
        const hEl = document.getElementById('lc-h');
        const mEl = document.getElementById('lc-m');
        const sEl = document.getElementById('lc-s');
        if (!jEl || !hEl || !mEl || !sEl) return;
        function pad(n) { return String(n).padStart(2, '0'); }
        const timer = setInterval(function() {
            sec--;
            if (sec <= 0) {
                clearInterval(timer);
                el.style.background = '#dcfce7';
                el.style.borderColor = '#86efac';
                el.innerHTML = '<div style="padding:12px;text-align:center;font-weight:700;color:#166534;font-size:16px;"><i class="fa-solid fa-check-circle"></i> Ce bien est maintenant disponible ! <a href="" style="color:#166534;text-decoration:underline;">Rafraîchir</a></div>';
                return;
            }
            jEl.textContent = Math.floor(sec / 86400);
            hEl.textContent = pad(Math.floor((sec % 86400) / 3600));
            mEl.textContent = pad(Math.floor((sec % 3600) / 60));
            sEl.textContent = pad(sec % 60);
        }, 1000);
    })();
</script>
<script type="text/javascript" src="https://platform-api.sharethis.com/js/sharethis.js" defer></script>
{% endblock %}
