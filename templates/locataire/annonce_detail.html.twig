            </div>
            <div class="modal-footer" style="padding: 20px; border-top: 1px solid var(--border); display: flex; justify-content: flex-end; gap: 12px; flex-shrink: 0; background: #fdfdfd;">
                <button type="button" class="btn-secondary" onclick="closeModal('modal-reservation')">Annuler</button>
                <button type="submit" class="btn-primary">
                    <i class="fa-solid fa-paper-plane"></i> Confirmer ma demande
                </button>
            </div>
        </form>
    </div>
</div>

