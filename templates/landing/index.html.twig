{% extends 'base.html.twig' %}

{% block title %}Sakan — Louer, signer et gérer votre logement autrement{% endblock %}

{% block stylesheets %}
{{ parent() }}

<style>
/* ╔════════════════════════════════════════════════════════════╗
   ║ SAKAN LANDING — Premium Sakan 2026                        ║
   ║ Direction UI/UX: liquid glass sélectif, motion utile,      ║
   ║ storytelling court, sections non-template, responsive.     ║
   ╚════════════════════════════════════════════════════════════╝ */

:root {
  --sk-blue: var(--blue, #5A69E5);
  --sk-blue-2: var(--blue-lit, #7C89FF);
  --sk-navy: var(--navy, #070435);
  --sk-text: var(--text, #101325);
  --sk-muted: var(--text-muted, #697086);
  --sk-bg: var(--bg-color, #F7F5F0);
  --sk-surface: var(--surface, #FFFFFF);
  --sk-border: var(--border, rgba(18, 25, 38, .10));
  --sk-divider: var(--divider, rgba(18, 25, 38, .08));
  --sk-warm: #C17A4B;
  --sk-warm-2: #E3B46C;
  --sk-green: #16A36A;
  --sk-purple: #8B5CF6;
  --sk-danger: #F97373;

  --sk-radius-sm: 14px;
  --sk-radius-md: 20px;
  --sk-radius-lg: 28px;
  --sk-radius-xl: 36px;

  --sk-shadow-sm: 0 8px 28px rgba(7, 4, 53, .08);
  --sk-shadow-md: 0 18px 55px rgba(7, 4, 53, .12);
  --sk-shadow-lg: 0 28px 90px rgba(7, 4, 53, .18);

  --sk-ease: cubic-bezier(.22, 1, .36, 1);
  --sk-ease-pop: cubic-bezier(.34, 1.35, .64, 1);
}

html[data-theme="dark"] {
  --sk-bg: #080C18;
  --sk-surface: #101727;
  --sk-text: #EEF2FF;
  --sk-muted: #9AA4BE;
  --sk-border: rgba(255, 255, 255, .10);
  --sk-divider: rgba(255, 255, 255, .08);
}

.lp-sakan,
.lp-sakan *,
.lp-sakan *::before,
.lp-sakan *::after {
  box-sizing: border-box;
}

.lp-sakan {
  position: relative;
  overflow-x: clip;
  font-family: 'Poppins', system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  color: var(--sk-text);
  background:
    radial-gradient(circle at 12% 5%, rgba(90,105,229,.13), transparent 34%),
    radial-gradient(circle at 90% 18%, rgba(193,122,75,.12), transparent 32%),
    linear-gradient(180deg, var(--sk-bg) 0%, color-mix(in srgb, var(--sk-bg) 92%, white 8%) 100%);
}

.lp-sakan a { color: inherit; }
.lp-sakan img { max-width: 100%; display: block; }

.sk-container {
  width: min(1240px, calc(100% - 48px));
  margin-inline: auto;
}

.sk-section {
  padding: 112px 0;
}

.sk-section-tight {
  padding: 84px 0;
}

.sk-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  width: fit-content;
  padding: 8px 13px;
  border: 1px solid color-mix(in srgb, var(--sk-blue) 22%, transparent);
  border-radius: 999px;
  background: color-mix(in srgb, var(--sk-blue) 9%, transparent);
  color: var(--sk-blue);
  font-size: 12px;
  font-weight: 700;
  letter-spacing: .035em;
}

.sk-eyebrow .pulse {
  width: 7px;
  height: 7px;
  border-radius: 999px;
  background: currentColor;
  box-shadow: 0 0 0 0 color-mix(in srgb, currentColor 35%, transparent);
  animation: skPulse 2.2s infinite;
}

@keyframes skPulse {
  0% { box-shadow: 0 0 0 0 color-mix(in srgb, currentColor 35%, transparent); }
  70% { box-shadow: 0 0 0 9px transparent; }
  100% { box-shadow: 0 0 0 0 transparent; }
}

.sk-h1,
.sk-h2,
.sk-h3 {
  font-family: 'Sora', 'Poppins', sans-serif;
  letter-spacing: -.045em;
  color: var(--sk-text);
}

.sk-h1 {
  margin: 22px 0 0;
  font-size: clamp(3rem, 7.4vw, 6.85rem);
  line-height: .91;
  font-weight: 850;
}

.sk-h2 {
  margin: 18px 0 0;
  font-size: clamp(2.15rem, 4.2vw, 4.35rem);
  line-height: .96;
  font-weight: 850;
}

.sk-h3 {
  margin: 0;
  font-size: clamp(1.35rem, 2.1vw, 2rem);
  line-height: 1.08;
  font-weight: 800;
}

.sk-lead {
  margin: 24px 0 0;
  max-width: 640px;
  color: var(--sk-muted);
  font-size: clamp(1rem, 1.3vw, 1.15rem);
  line-height: 1.75;
}

.sk-gradient {
  background: linear-gradient(120deg, var(--sk-blue), var(--sk-blue-2) 45%, var(--sk-warm));
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.sk-warm-gradient {
  background: linear-gradient(120deg, var(--sk-warm), var(--sk-warm-2));
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

/* Buttons */
.sk-btn {
  --btn-bg: var(--sk-blue);
  --btn-color: #fff;
  --btn-border: transparent;

  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 9px;
  min-height: 48px;
  padding: 13px 23px;
  border-radius: 999px;
  border: 1px solid var(--btn-border);
  background: var(--btn-bg);
  color: var(--btn-color);
  font-size: 14px;
  font-weight: 750;
  text-decoration: none;
  cursor: pointer;
  box-shadow: 0 14px 32px color-mix(in srgb, var(--btn-bg) 28%, transparent);
  transition:
    transform .25s var(--sk-ease),
    box-shadow .25s var(--sk-ease),
    background .25s var(--sk-ease),
    border-color .25s var(--sk-ease);
}

.sk-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 20px 46px color-mix(in srgb, var(--btn-bg) 34%, transparent);
}

.sk-btn:active { transform: translateY(0) scale(.985); }

.sk-btn-ghost {
  --btn-bg: color-mix(in srgb, var(--sk-surface) 78%, transparent);
  --btn-color: var(--sk-text);
  --btn-border: var(--sk-border);
  box-shadow: none;
  backdrop-filter: blur(18px) saturate(150%);
}

.sk-btn-warm {
  --btn-bg: var(--sk-warm);
}
.sk-btn-white {
  --btn-bg: #5A69E5;
  --btn-color: #fff;
}

/* ═════════════════ NAV — Liquid Class 2026 ═════════════════ */

.sk-liquid-nav-shell {
  position: sticky;
  top: 14px;
  z-index: 600;
  padding-inline: 18px;
  pointer-events: none;
}

.sk-liquid-nav {
  pointer-events: auto;
  width: min(1160px, 100%);
  height: 66px;
  margin-inline: auto;
  display: grid;
  grid-template-columns: auto 1fr auto;
  align-items: center;
  gap: 18px;
  padding: 8px 10px 8px 16px;
  border-radius: 999px;
  border: 1px solid rgba(255,255,255,.44);
  background:
    linear-gradient(135deg, rgba(255,255,255,.74), rgba(255,255,255,.38)),
    color-mix(in srgb, var(--sk-surface) 70%, transparent);
  backdrop-filter: blur(28px) saturate(170%);
  -webkit-backdrop-filter: blur(28px) saturate(170%);
  box-shadow:
    0 18px 60px rgba(7,4,53,.10),
    inset 0 1px 0 rgba(255,255,255,.65),
    inset 0 -1px 0 rgba(255,255,255,.20);
  transition:
    width .32s var(--sk-ease),
    box-shadow .32s var(--sk-ease),
    background .32s var(--sk-ease),
    transform .32s var(--sk-ease);
}

html[data-theme="dark"] .sk-liquid-nav {
  border-color: rgba(255,255,255,.10);
  background:
    linear-gradient(135deg, rgba(20,28,48,.74), rgba(20,28,48,.42)),
    rgba(11,16,32,.62);
  box-shadow:
    0 18px 60px rgba(0,0,0,.26),
    inset 0 1px 0 rgba(255,255,255,.08);
}

.sk-liquid-nav.sk-nav-compact {
  width: min(980px, 100%);
  box-shadow:
    0 24px 70px rgba(7,4,53,.14),
    inset 0 1px 0 rgba(255,255,255,.55);
}

.sk-brand {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  min-width: 0;
  text-decoration: none;
}

.sk-brand img {
  height: 34px;
  object-fit: contain;
}

.sk-brand-chip {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 5px 9px;
  border-radius: 999px;
  background: color-mix(in srgb, var(--sk-blue) 10%, transparent);
  color: var(--sk-blue);
  font-size: 11px;
  font-weight: 800;
}

.sk-nav-links {
  justify-self: center;
  display: flex;
  align-items: center;
  gap: 5px;
  padding: 5px;
  border-radius: 999px;
  background: rgba(255,255,255,.24);
  border: 1px solid rgba(255,255,255,.28);
}

html[data-theme="dark"] .sk-nav-links {
  background: rgba(255,255,255,.04);
  border-color: rgba(255,255,255,.08);
}

.sk-nav-link {
  position: relative;
  display: inline-flex;
  align-items: center;
  min-height: 38px;
  padding: 0 14px;
  border-radius: 999px;
  color: var(--sk-muted);
  font-size: 13px;
  font-weight: 700;
  text-decoration: none;
  transition: color .24s var(--sk-ease), background .24s var(--sk-ease);
}

.sk-nav-link:hover,
.sk-nav-link.is-active {
  color: var(--sk-text);
  background: color-mix(in srgb, var(--sk-surface) 66%, transparent);
}

.sk-nav-actions {
  display: flex;
  align-items: center;
  gap: 9px;
}

.sk-mobile-menu-btn {
  display: none;
  width: 42px;
  height: 42px;
  border: 1px solid var(--sk-border);
  border-radius: 999px;
  background: color-mix(in srgb, var(--sk-surface) 70%, transparent);
  color: var(--sk-text);
  cursor: pointer;
}

.sk-mobile-drawer {
  display: none;
}

/* ═════════════════ HERO ═════════════════ */

.sk-hero {
  position: relative;
  min-height: calc(100svh - 90px);
  padding: 78px 0 64px;
  overflow: hidden;
}

.sk-hero::before {
  content: "";
  position: absolute;
  inset: -80px -160px auto auto;
  width: 650px;
  height: 650px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(90,105,229,.20), transparent 63%);
  filter: blur(8px);
  pointer-events: none;
}

.sk-hero-grid {
  position: relative;
  display: grid;
  grid-template-columns: minmax(0, 1.02fr) minmax(420px, .98fr);
  align-items: center;
  gap: clamp(44px, 6vw, 90px);
}

.sk-hero-copy {
  padding-top: 32px;
}

.sk-hero-title-row {
  display: inline-flex;
  align-items: baseline;
  gap: .16em;
}

.sk-hero-title-mark {
  position: relative;
  display: inline-block;
}

.sk-hero-title-mark::after {
  content: "";
  position: absolute;
  left: .04em;
  right: .04em;
  bottom: .045em;
  height: .12em;
  border-radius: 999px;
  background: color-mix(in srgb, var(--sk-warm) 45%, transparent);
  z-index: -1;
  transform: rotate(-1deg);
}

.sk-hero-actions {
  display: flex;
  align-items: center;
  gap: 13px;
  flex-wrap: wrap;
  margin-top: 34px;
}

.sk-hero-assurance {
  display: grid;
  grid-template-columns: repeat(3, auto);
  gap: 14px;
  margin-top: 30px;
}

.sk-assurance-pill {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: var(--sk-muted);
  font-size: 13px;
  font-weight: 700;
}

.sk-assurance-pill i {
  color: var(--sk-blue);
}

/* Hero visual — non-template */
.sk-hero-stage {
  position: relative;
  min-height: 620px;
  perspective: 1200px;
}

.sk-orbit {
  position: absolute;
  inset: 22px 0 0 0;
  margin: auto;
  width: min(520px, 100%);
  height: 520px;
  border-radius: 50%;
  background:
    radial-gradient(circle at 50% 50%, rgba(255,255,255,.68), rgba(255,255,255,.28) 42%, transparent 68%),
    radial-gradient(circle at 42% 38%, rgba(90,105,229,.25), transparent 38%),
    radial-gradient(circle at 68% 64%, rgba(193,122,75,.18), transparent 40%);
  border: 1px solid rgba(255,255,255,.44);
  backdrop-filter: blur(20px);
  box-shadow: var(--sk-shadow-lg);
  overflow: hidden;
  transform: rotateX(4deg) rotateY(-8deg);
}

html[data-theme="dark"] .sk-orbit {
  background:
    radial-gradient(circle at 50% 50%, rgba(22,31,52,.72), rgba(22,31,52,.35) 42%, transparent 68%),
    radial-gradient(circle at 42% 38%, rgba(90,105,229,.25), transparent 38%),
    radial-gradient(circle at 68% 64%, rgba(193,122,75,.16), transparent 40%);
  border-color: rgba(255,255,255,.10);
}

.sk-orbit::before,
.sk-orbit::after {
  content: "";
  position: absolute;
  inset: 58px;
  border-radius: 50%;
  border: 1px dashed rgba(90,105,229,.32);
  animation: skSpin 22s linear infinite;
}

.sk-orbit::after {
  inset: 104px;
  border-color: rgba(193,122,75,.30);
  animation-duration: 30s;
  animation-direction: reverse;
}

@keyframes skSpin {
  to { transform: rotate(360deg); }
}

.sk-home-card {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 315px;
  transform: translate(-50%, -48%);
  border-radius: 30px;
  overflow: hidden;
  background: var(--sk-surface);
  border: 1px solid var(--sk-border);
  box-shadow: var(--sk-shadow-lg);
  animation: skFloatMain 7s ease-in-out infinite;
}

@keyframes skFloatMain {
  0%, 100% { transform: translate(-50%, -48%) translateY(0) rotate(-1.5deg); }
  50% { transform: translate(-50%, -48%) translateY(-14px) rotate(1deg); }
}

.sk-home-photo {
  height: 205px;
  position: relative;
  background:
    linear-gradient(180deg, transparent, rgba(7,4,53,.55)),
    url('https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?w=900&q=80') center/cover;
}

.sk-ai-badge {
  position: absolute;
  top: 14px;
  left: 14px;
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 7px 10px;
  border-radius: 999px;
  background: rgba(7,4,53,.70);
  color: #fff;
  backdrop-filter: blur(14px);
  font-size: 11px;
  font-weight: 800;
}

.sk-ai-badge span {
  width: 7px;
  height: 7px;
  border-radius: 999px;
  background: #3BE681;
}

.sk-home-body {
  padding: 18px;
}

.sk-price {
  font-family: 'Sora', sans-serif;
  font-size: 25px;
  font-weight: 850;
  letter-spacing: -.03em;
}

.sk-price small {
  color: var(--sk-muted);
  font-size: 12px;
  font-weight: 600;
}

.sk-home-title {
  margin-top: 5px;
  color: var(--sk-text);
  font-size: 14px;
  font-weight: 800;
}

.sk-home-meta {
  display: flex;
  gap: 10px;
  margin-top: 14px;
  padding-top: 14px;
  border-top: 1px solid var(--sk-divider);
}

.sk-home-meta span {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  color: var(--sk-muted);
  font-size: 12px;
  font-weight: 700;
}

.sk-home-meta i { color: var(--sk-blue); }

.sk-float-card {
  position: absolute;
  z-index: 3;
  border: 1px solid rgba(255,255,255,.44);
  border-radius: 22px;
  background: rgba(255,255,255,.66);
  backdrop-filter: blur(24px) saturate(160%);
  box-shadow: var(--sk-shadow-md);
  color: var(--sk-text);
}

html[data-theme="dark"] .sk-float-card {
  background: rgba(16,23,39,.68);
  border-color: rgba(255,255,255,.10);
}

.sk-float-card.card-search {
  left: 0;
  top: 96px;
  width: 235px;
  padding: 15px;
  animation: skFloatA 8s ease-in-out infinite;
}

.sk-float-card.card-contract {
  right: 4px;
  bottom: 106px;
  width: 242px;
  padding: 16px;
  animation: skFloatB 7s ease-in-out infinite;
}

.sk-float-card.card-caution {
  left: 28px;
  bottom: 42px;
  width: 220px;
  padding: 15px;
  animation: skFloatA 7.5s ease-in-out infinite reverse;
}

@keyframes skFloatA {
  0%,100% { transform: translateY(0); }
  50% { transform: translateY(13px); }
}

@keyframes skFloatB {
  0%,100% { transform: translateY(0) rotate(1deg); }
  50% { transform: translateY(-12px) rotate(-1deg); }
}

.sk-float-label {
  display: flex;
  align-items: center;
  gap: 7px;
  color: var(--sk-muted);
  font-size: 11px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: .06em;
}

.sk-float-value {
  margin-top: 9px;
  font-family: 'Sora', sans-serif;
  font-size: 18px;
  font-weight: 850;
  letter-spacing: -.03em;
}

.sk-progress {
  position: relative;
  height: 8px;
  margin-top: 12px;
  border-radius: 999px;
  background: color-mix(in srgb, var(--sk-blue) 12%, transparent);
  overflow: hidden;
}

.sk-progress::after {
  content: "";
  position: absolute;
  inset: 0 28% 0 0;
  border-radius: inherit;
  background: linear-gradient(90deg, var(--sk-blue), var(--sk-blue-2));
}

.sk-contract-row {
  display: flex;
  align-items: center;
  gap: 11px;
  margin-top: 12px;
}

.sk-contract-icon {
  width: 42px;
  height: 42px;
  border-radius: 15px;
  display: grid;
  place-items: center;
  background: color-mix(in srgb, var(--sk-green) 13%, transparent);
  color: var(--sk-green);
}

.sk-contract-text strong {
  display: block;
  font-size: 13px;
}

.sk-contract-text span {
  display: block;
  margin-top: 2px;
  color: var(--sk-muted);
  font-size: 12px;
}

.sk-caution-row {
  display: flex;
  justify-content: space-between;
  align-items: end;
  margin-top: 10px;
}

.sk-caution-row strong {
  font-family: 'Sora', sans-serif;
  font-size: 18px;
}

.sk-status-ok {
  padding: 5px 8px;
  border-radius: 999px;
  background: color-mix(in srgb, var(--sk-green) 13%, transparent);
  color: var(--sk-green);
  font-size: 11px;
  font-weight: 850;
}

/* Break rhythm strip */
.sk-rhythm-break {
  position: relative;
  padding: 28px 0;
  border-block: 1px solid var(--sk-border);
  background:
    linear-gradient(90deg, transparent, rgba(90,105,229,.06), transparent),
    color-mix(in srgb, var(--sk-surface) 72%, transparent);
  overflow: hidden;
}

.sk-rhythm-track {
  display: flex;
  gap: 18px;
  width: max-content;
  animation: skMarquee 34s linear infinite;
}

.sk-rhythm-item {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  white-space: nowrap;
  color: var(--sk-muted);
  font-size: 13px;
  font-weight: 800;
}

.sk-rhythm-item i {
  color: var(--sk-blue);
}

.sk-rhythm-dot {
  width: 6px;
  height: 6px;
  border-radius: 999px;
  background: color-mix(in srgb, var(--sk-warm) 65%, transparent);
}

@keyframes skMarquee {
  to { transform: translateX(-50%); }
}

/* Problem / decision section */
.sk-decision-grid {
  display: grid;
  grid-template-columns: .92fr 1.08fr;
  gap: 46px;
  align-items: start;
}

.sk-decision-panel {
  position: sticky;
  top: 112px;
}

.sk-decision-list {
  display: grid;
  gap: 14px;
}

.sk-decision-card {
  display: grid;
  grid-template-columns: 48px 1fr;
  gap: 15px;
  padding: 20px;
  border-radius: 26px;
  border: 1px solid var(--sk-border);
  background: color-mix(in srgb, var(--sk-surface) 86%, transparent);
  box-shadow: var(--sk-shadow-sm);
}

.sk-decision-card:nth-child(2) {
  transform: translateX(28px);
}

.sk-decision-card:nth-child(4) {
  transform: translateX(44px);
}

.sk-decision-icon {
  width: 48px;
  height: 48px;
  border-radius: 17px;
  display: grid;
  place-items: center;
  background: color-mix(in srgb, var(--sk-blue) 10%, transparent);
  color: var(--sk-blue);
}

.sk-decision-card h3 {
  margin: 0;
  color: var(--sk-text);
  font-size: 16px;
  font-weight: 850;
}

.sk-decision-card p {
  margin: 6px 0 0;
  color: var(--sk-muted);
  font-size: 13.5px;
  line-height: 1.65;
}

/* Properties */
.sk-section-head {
  display: flex;
  justify-content: space-between;
  align-items: end;
  gap: 28px;
  margin-bottom: 34px;
}

.sk-properties-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 18px;
}

.sk-prop-card {
  position: relative;
  min-width: 0;
  overflow: hidden;
  border-radius: 28px;
  border: 1px solid var(--sk-border);
  background: var(--sk-surface);
  color: inherit;
  text-decoration: none;
  box-shadow: var(--sk-shadow-sm);
  transform: translateZ(0);
  transition:
    transform .34s var(--sk-ease),
    box-shadow .34s var(--sk-ease),
    border-color .34s var(--sk-ease);
}

.sk-prop-card:hover {
  transform: translateY(-8px);
  box-shadow: var(--sk-shadow-md);
  border-color: color-mix(in srgb, var(--sk-blue) 25%, var(--sk-border));
}

.sk-prop-media {
  height: 192px;
  position: relative;
