          </h2>
        </div>

        <a href="{{ path('app_login') }}" class="sk-btn sk-btn-ghost sk-reveal sk-delay-2">
          Voir les annonces <i class="fa-solid fa-arrow-right"></i>
        </a>
      </div>

      <div class="sk-properties-grid">
        {% if annonces is defined and annonces|length > 0 %}
          {% for annonce in annonces|slice(0,4) %}
            <a href="{{ path('app_login') }}" class="sk-prop-card sk-reveal sk-delay-{{ loop.index }}">
              <div class="sk-prop-media">
                {% if annonce.photoPrincipale %}
                  <img src="{{ asset(annonce.photoPrincipale) }}" alt="{{ annonce.titre }}" loading="lazy">
                {% else %}
                  {% set imgs = [
                    'https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?w=700&q=75',
                    'https://images.unsplash.com/photo-1512918728675-ed5a9ecdebfd?w=700&q=75',
                    'https://images.unsplash.com/photo-1580587771525-78b9dba3b914?w=700&q=75',
                    'https://images.unsplash.com/photo-1484154218962-a197022b5858?w=700&q=75'
                  ] %}
                  <img src="{{ imgs[loop.index0 % 4] }}" alt="{{ annonce.titre }}" loading="lazy">
                {% endif %}

                <div class="sk-prop-badges">
                  <span class="sk-prop-badge">
                    <i class="fa-solid fa-house"></i>
                    {{ annonce.type is defined ? annonce.type : 'Location' }}
                  </span>
                  <span class="sk-prop-heart"><i class="fa-regular fa-heart"></i></span>
                </div>
              </div>

              <div class="sk-prop-body">
                <div class="sk-prop-price">
                  {{ annonce.prixFloat is defined ? annonce.prixFloat|number_format(0, ',', ' ') : annonce.prix }} TND
                  <small>/ mois</small>
                </div>
                <div class="sk-prop-title">{{ annonce.titre }}</div>
                <div class="sk-prop-location">
                  <i class="fa-solid fa-location-dot"></i>
                  {{ annonce.ville ?? annonce.adresse ?? 'Tunisie' }}
                </div>
                <div class="sk-prop-meta">
                  {% if annonce.surface is defined %}
                    <span><i class="fa-solid fa-vector-square"></i>{{ annonce.surface }} m²</span>
                  {% endif %}
                  {% if annonce.chambres is defined %}
                    <span><i class="fa-solid fa-bed"></i>{{ annonce.chambres }} ch.</span>
                  {% endif %}
                  {% if annonce.sallesDeBain is defined %}
                    <span><i class="fa-solid fa-bath"></i>{{ annonce.sallesDeBain }} sdb.</span>
                  {% endif %}
                </div>
              </div>
            </a>
          {% endfor %}
        {% else %}
          {% set dummies = [
            {titre:'Appartement S+3 Ennasr', prix:'1 200', ville:'Ariana', surface:110, chambres:3, sdb:2, img:'https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?w=700&q=75', type:'Appartement'},
            {titre:'Studio meublé Lac 2', prix:'750', ville:'Tunis', surface:52, chambres:1, sdb:1, img:'https://images.unsplash.com/photo-1512918728675-ed5a9ecdebfd?w=700&q=75', type:'Studio'},
            {titre:'Villa S+4 La Marsa', prix:'3 500', ville:'La Marsa', surface:240, chambres:4, sdb:3, img:'https://images.unsplash.com/photo-1580587771525-78b9dba3b914?w=700&q=75', type:'Villa'},
            {titre:'Duplex S+2 Menzah 9', prix:'980', ville:'Ariana', surface:88, chambres:2, sdb:1, img:'https://images.unsplash.com/photo-1484154218962-a197022b5858?w=700&q=75', type:'Duplex'}
          ] %}

          {% for d in dummies %}
            <a href="{{ path('app_login') }}" class="sk-prop-card sk-reveal sk-delay-{{ loop.index }}">
              <div class="sk-prop-media">
                <img src="{{ d.img }}" alt="{{ d.titre }}" loading="lazy">
                <div class="sk-prop-badges">
                  <span class="sk-prop-badge"><i class="fa-solid fa-house"></i>{{ d.type }}</span>
                  <span class="sk-prop-heart"><i class="fa-regular fa-heart"></i></span>
                </div>
              </div>
              <div class="sk-prop-body">
                <div class="sk-prop-price">{{ d.prix }} TND <small>/ mois</small></div>
                <div class="sk-prop-title">{{ d.titre }}</div>
                <div class="sk-prop-location"><i class="fa-solid fa-location-dot"></i>{{ d.ville }}</div>
                <div class="sk-prop-meta">
                  <span><i class="fa-solid fa-vector-square"></i>{{ d.surface }} m²</span>
                  <span><i class="fa-solid fa-bed"></i>{{ d.chambres }} ch.</span>
                  <span><i class="fa-solid fa-bath"></i>{{ d.sdb }} sdb.</span>
                </div>
              </div>
            </a>
          {% endfor %}
        {% endif %}
      </div>
    </div>
  </section>

