{% extends 'layouts/base_auth.html.twig' %}

{% block title %}Connexion - Sakan{% endblock %}

{% block auth_content %}
    <div class="brand-title">
        <img src="{{ asset('images/logo.png') }}" alt="Sakan" style="height: 40px; object-fit: contain;">
    </div>

    <h1 class="auth-title">Bon retour 👋</h1>
    <p class="muted">Connectez-vous pour accéder à votre espace personnel</p>

    {% for message in app.flashes('auth_error') %}
        <p class="field-error">{{ message }}</p>
    {% endfor %}
    {% for message in app.flashes('auth_success') %}
        <p style="color: #16a34a; font-size: 13px; margin-bottom: 8px;">{{ message }}</p>
    {% endfor %}

    {% if error %}
        {% set auth_error = error.messageKey %}
        {% if auth_error == 'Invalid credentials.' %}
            {% set auth_error = 'Mot de passe incorrect.' %}
        {% elseif auth_error == 'Invalid CSRF token.' %}
            {% set auth_error = 'Session invalide. Veuillez réessayer.' %}
        {% elseif auth_error == 'An authentication exception occurred.' %}
            {% set auth_error = 'Une erreur est survenue lors de la connexion.' %}
        {% endif %}
        <p class="field-error">{{ auth_error }}</p>
    {% endif %}

    <form class="auth-form-card" method="post" action="{{ path('app_login') }}">
        <div class="auth-input-wrapper">
            <i class="fa-solid fa-envelope input-icon"></i>
            <input type="text" name="identifier" value="{{ last_identifier|default('') }}" placeholder="Email ou identifiant" autocomplete="username" required>
        </div>

        <div class="auth-input-wrapper">
            <i class="fa-solid fa-lock input-icon"></i>
            <input type="password" name="password" placeholder="Mot de passe" autocomplete="current-password" required>
        </div>

        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

        <div class="options-row">
            <label style="display: flex; align-items: center; gap: 8px; font-weight: 600; cursor: pointer;">
                <input type="checkbox" name="_remember_me" checked> Se souvenir de moi
            </label>
            <a href="{{ path('app_forgot_password') }}" style="color: var(--primary); font-weight: 600;">Mot de passe oublié ?</a>
        </div>

        <button type="submit" class="btn-sakan-primary">Se connecter &rarr;</button>

        <div class="auth-divider">ou</div>

        <button type="button" class="btn-google" onclick="window.location.href='{{ path('app_google_start', { flow: 'login' }) }}'">
            <svg viewBox="0 0 24 24" width="20" height="20" xmlns="http://www.w3.org/2000/svg">
                <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
                <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
            </svg>
            Continuer avec Google
        </button>

        <p style="text-align: center; margin-top: 20px; font-weight: 500;">
            Vous n'avez pas de compte ? <a href="{{ path('app_register') }}">Créer un compte</a>
        </p>

        <div id="webauthn-login-section" style="margin-top:6px;">
          <div id="webauthn-email-wrapper" style="display:none;margin-bottom:8px;">
            <input type="email" id="webauthn-email-input"
                   placeholder="Email (pour Face ID / Windows Hello)"
                   style="width:100%;padding:12px;border-radius:8px;border:1px solid #d1d5db;font-size:14px;"
                   onkeydown="if(event.key==='Enter'){launchWebAuthnLogin();}">
          </div>
          <button type="button" id="btn-webauthn-login" onclick="launchWebAuthnLogin()"
                  style="width:100%;padding:12px;border-radius:8px;border:1px solid #2563eb;background:#eff6ff;color:#1d4ed8;font-weight:600;cursor:pointer;font-size:14px;display:flex;align-items:center;justify-content:center;gap:10px;">
            <i class="fa-solid fa-fingerprint" style="font-size:18px;"></i>
            Se connecter avec Face ID / Windows Hello
          </button>
          <div id="webauthn-login-status" style="display:none;"></div>
        </div>

        <div id="fr-login-section" style="margin-top:6px;">
          <div id="fr-login-email-wrapper" style="display:none;margin-bottom:8px;">
            <input type="email" id="fr-login-email-input"
                   placeholder="Email (pour la reconnaissance faciale)"
                   style="width:100%;padding:12px;border-radius:8px;border:1px solid #d1d5db;font-size:14px;"
                   onkeydown="if(event.key==='Enter'){loginWithFaceRecognition();}">
          </div>
          <button type="button" onclick="loginWithFaceRecognition()"
                  style="width:100%;padding:12px;border-radius:8px;border:1px solid #7c3aed;background:#f5f3ff;color:#6d28d9;font-weight:600;cursor:pointer;font-size:14px;display:flex;align-items:center;justify-content:center;gap:10px;">
            <i class="fa-solid fa-face-smile" style="font-size:18px;"></i>
            Se connecter par reconnaissance faciale
          </button>
          <div id="fr-login-status" style="display:none;"></div>
        </div>
    </form>
{% endblock %}

{% block javascripts %}
    {% include 'auth/_validation_js.html.twig' %}
    <script src="{{ asset('js/webauthn.js') }}"></script>
    <script src="{{ asset('js/face-recognition.js') }}"></script>
    <script>
    function launchWebAuthnLogin() {
      const wrapper = document.getElementById('webauthn-email-wrapper');
      const input   = document.getElementById('webauthn-email-input');
      if (wrapper && wrapper.style.display === 'none') {
        wrapper.style.display = 'block';
        const pwdInput = document.querySelector('input[name="identifier"]')
                      || document.querySelector('input[name="email"]');
        if (pwdInput && pwdInput.value.trim()) input.value = pwdInput.value.trim();
        input.focus();
        return;
      }
      authenticateWebAuthn(input ? input.value.trim() : '');
    }
    </script>
{% endblock %}
