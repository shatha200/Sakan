{% extends 'layouts/base_auth.html.twig' %}

{% block title %}Mot de passe oublié - Sakan{% endblock %}

{% block auth_content %}
    <div class="brand-title">
        <img src="{{ asset('images/logo.png') }}" alt="Sakan" style="height: 40px; object-fit: contain;">
    </div>

    <h1 class="auth-title">Mot de passe oublié</h1>
    <p class="muted">Récupérez votre compte avec un code OTP envoyé par e-mail.</p>

    {% for message in app.flashes('auth_error') %}
        <p class="field-error">{{ message }}</p>
    {% endfor %}
    {% for message in app.flashes('auth_success') %}
        <p style="color: #16a34a; font-size: 13px; margin-bottom: 8px;">{{ message }}</p>
    {% endfor %}

    {% if pending_email is empty %}
        <form class="auth-form-card" method="post" action="{{ path('app_forgot_password') }}">
            <input type="hidden" name="step" value="request">
            <div class="auth-input-wrapper">
                <i class="fa-solid fa-envelope input-icon"></i>
                <input type="email" name="email" placeholder="Votre email" required>
            </div>
            <button type="submit" class="btn-sakan-primary">Envoyer le code OTP &rarr;</button>
        </form>
    {% else %}
        {% set otpKey = 'forgot-password' %}
        {% set secondsRemaining = otp_status.seconds_remaining|default(0) %}
        {% set resendCount = otp_status.resend_count|default(0) %}
        {% set maxResends = otp_status.max_resends|default(5) %}
        {% set expiresAt = otp_status.expires_at|default('') %}

        <form class="auth-form-card" method="post" action="{{ path('app_forgot_password') }}">
            <input type="hidden" name="step" value="verify">
            <div class="auth-input-wrapper">
                <i class="fa-solid fa-shield-halved input-icon"></i>
                <input type="text" name="otp_code" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" placeholder="Code OTP (6 chiffres)" required autofocus>
            </div>
            <div class="auth-input-wrapper">
                <i class="fa-solid fa-lock input-icon"></i>
                <input type="password" name="new_password" placeholder="Nouveau mot de passe" required>
            </div>
            <div class="auth-input-wrapper">
                <i class="fa-solid fa-lock input-icon"></i>
                <input type="password" name="confirm_password" placeholder="Confirmer mot de passe" required>
            </div>
            <button type="submit" class="btn-sakan-primary">Mettre à jour le mot de passe &rarr;</button>
        </form>

        <div style="margin-top: 16px; text-align: center;">
            <strong
                data-otp-countdown
                data-otp-timer-key="{{ otpKey }}"
                data-otp-expires-at="{{ expiresAt }}"
                data-otp-seconds-remaining="{{ secondsRemaining }}"
                style="font-size: 20px; color: #4a6cf7; display: block; margin-bottom: 6px;"
            >{{ '%02d:%02d'|format((secondsRemaining / 60)|round(0, 'floor'), secondsRemaining % 60) }}</strong>

            <p style="font-size: 13px; color: #888; margin-bottom: 12px;"
               data-otp-resend-status="{{ otpKey }}">
                {% if resendCount >= maxResends and secondsRemaining > 0 %}
                    Limite de renvoi atteinte.
                {% elseif secondsRemaining > 0 %}
                    Vous pouvez renvoyer le code jusqu'à 5 fois pendant 5 min.
                {% else %}
                    Le prochain renvoi relancera le minuteur à 05:00.
                {% endif %}
            </p>

            <form method="post" action="{{ path('app_forgot_password') }}" style="display:inline;">
                <input type="hidden" name="step" value="resend">
                <button
                    type="submit"
                    class="btn-secondary btn-sm"
                    data-otp-resend-button="{{ otpKey }}"
                    data-otp-maxed="{{ resendCount >= maxResends and secondsRemaining > 0 ? '1' : '0' }}"
                    {{ resendCount >= maxResends and secondsRemaining > 0 ? 'disabled' : '' }}
                    style="font-size: 13px;"
                >Renvoyer le code</button>
            </form>
        </div>
    {% endif %}

    <p style="text-align: center; margin-top: 20px; font-weight: 500;">
        <a href="{{ path('app_login') }}">Retour à la connexion</a>
    </p>
{% endblock %}

{% block javascripts %}
    {% include 'auth/_validation_js.html.twig' %}
    {% include 'shared/_otp_timer_script.html.twig' %}
{% endblock %}
