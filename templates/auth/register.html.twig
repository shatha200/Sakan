{% extends 'layouts/base_auth.html.twig' %}

{% block title %}Inscription - Sakan{% endblock %}

{% block auth_content %}
    {% set selectedRole = form.role|default('LOCATAIRE') %}
    <div class="brand-title">
        <img src="{{ asset('images/logo.png') }}" alt="Sakan" style="height: 40px; object-fit: contain;">
    </div>

    <h1 class="auth-title">Créer un compte</h1>
    <p class="muted">Tous les champs marqués * sont obligatoires.</p>

    <form class="auth-form-card" method="post" action="{{ path('app_register') }}">
        {% if register_error %}
            <div class="auth-error-stack">
                <div class="auth-alert auth-alert-error">{{ register_error }}</div>
            </div>
        {% endif %}
        {% for message in app.flashes('auth_error') %}
            <div class="auth-error-stack">
                <div class="auth-alert auth-alert-error">{{ message }}</div>
            </div>
        {% endfor %}

        <div class="role-toggle">
            <button type="button" class="role-btn {{ selectedRole == 'LOCATAIRE' ? 'active' : '' }}" onclick="setRole('LOCATAIRE', this)">
                <i class="fa-solid fa-key" aria-hidden="true"></i> Locataire
            </button>
            <button type="button" class="role-btn {{ selectedRole == 'PROPRIETAIRE' ? 'active' : '' }}" onclick="setRole('PROPRIETAIRE', this)">
                <i class="fa-solid fa-building" aria-hidden="true"></i> Propriétaire
            </button>
        </div>
        <input type="hidden" id="role" name="role" value="{{ selectedRole }}">

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
            <div class="auth-input-wrapper">
                <input type="text" name="prenom" placeholder="Prénom*" value="{{ form.prenom|default('') }}" required>
            </div>
            <div class="auth-input-wrapper">
                <input type="text" name="nom" placeholder="Nom*" value="{{ form.nom|default('') }}" required>
            </div>
        </div>

        <div class="auth-input-wrapper">
            <i class="fa-solid fa-envelope input-icon" aria-hidden="true"></i>
            <input type="email" name="email" placeholder="Email*" value="{{ form.email|default('') }}" required>
        </div>

        <div class="auth-input-wrapper">
            <i class="fa-solid fa-phone input-icon" aria-hidden="true"></i>
            <input type="text" name="telephone" pattern="[2-9][0-9]{7}" value="{{ form.telephone|default('') }}" placeholder="Téléphone tunisien (8 chiffres)*" required>
        </div>

        <div class="auth-input-wrapper">
            <i class="fa-solid fa-lock input-icon" aria-hidden="true"></i>
            <input type="password" name="password" placeholder="Mot de passe*" required>
        </div>

        <div class="auth-input-wrapper">
            <i class="fa-solid fa-lock input-icon" aria-hidden="true"></i>
            <input type="password" name="password_confirm" placeholder="Confirmer mot de passe*" required>
        </div>

        <label class="auth-terms">
            <input type="checkbox" name="accept_terms" value="1" required style="margin-top: 4px;" {{ form.accept_terms|default(false) ? 'checked' : '' }}>
            <span>J'accepte les <a href="#">conditions générales</a> et la <a href="#">politique de confidentialité</a></span>
        </label>

        <button type="submit" class="btn-sakan-primary">Créer mon compte &rarr;</button>

        <div class="auth-divider">ou</div>

        <button type="button" class="btn-google" onclick="window.location.href='{{ path('app_google_start', { flow: 'register' }) }}'">
            <svg viewBox="0 0 24 24" width="20" height="20" xmlns="http://www.w3.org/2000/svg">
                <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
                <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
            </svg>
            Continuer avec Google
        </button>

        <p class="auth-login-link">
            Déjà un compte ? <a href="{{ path('app_login') }}">Se connecter</a>
        </p>
    </form>
{% endblock %}

{% block javascripts %}
    {% include 'auth/_validation_js.html.twig' %}
    <script>
        function setRole(role, btnElement) {
            document.getElementById('role').value = role;
            document.querySelectorAll('.role-btn').forEach(btn => btn.classList.remove('active'));
            btnElement.classList.add('active');
        }
    </script>
{% endblock %}
