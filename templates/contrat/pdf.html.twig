<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contrat de Location #{{ contrat.id }} - Sakan</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            font-size: 12pt;
            line-height: 1.6;
            color: #333;
            background: white;
        }
        
        .container {
            max-width: 800px;
            margin: 0 auto;
            padding: 40px;
        }
        
        /* Header avec Logo */
        .header {
            text-align: center;
            margin-bottom: 30px;
            padding-bottom: 20px;
            border-bottom: 3px solid #4f46e5;
        }
        
        .logo {
            font-size: 32pt;
            font-weight: 800;
            color: #4f46e5;
            letter-spacing: -1px;
        }
        
        .logo-icon {
            display: inline-block;
            width: 40px;
            height: 40px;
            background: linear-gradient(135deg, #4f46e5, #7c3aed);
            border-radius: 10px;
            margin-right: 10px;
            vertical-align: middle;
        }
        
        .subtitle {
            font-size: 10pt;
            color: #6b7280;
            margin-top: 5px;
        }
        
        /* Title */
        .document-title {
            text-align: center;
            font-size: 20pt;
            font-weight: 700;
            color: #111827;
            margin: 30px 0;
            text-transform: uppercase;
            letter-spacing: 2px;
        }
        
        .document-meta {
            text-align: center;
            font-size: 10pt;
            color: #6b7280;
            margin-bottom: 30px;
        }
        
        /* Sections */
        .section {
            margin-bottom: 25px;
            page-break-inside: avoid;
        }
        
        .section-title {
            font-size: 14pt;
            font-weight: 700;
            color: #4f46e5;
            margin-bottom: 15px;
            padding-bottom: 8px;
            border-bottom: 2px solid #e5e7eb;
        }
        
        /* Info Grid */
        .info-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
        }
        
        .info-item {
            padding: 10px;
            background: #f9fafb;
            border-radius: 6px;
        }
        
        .info-label {
            font-size: 9pt;
            color: #6b7280;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 4px;
        }
        
        .info-value {
            font-size: 11pt;
            font-weight: 600;
            color: #111827;
        }
        
        /* Parties */
        .party-box {
            border: 1px solid #e5e7eb;
            border-radius: 8px;
            padding: 15px;
            margin-bottom: 15px;
        }
        
        .party-title {
            font-size: 10pt;
            font-weight: 700;
            color: #4f46e5;
            text-transform: uppercase;
            margin-bottom: 10px;
        }
        
        /* Table */
        .data-table {
            width: 100%;
            border-collapse: collapse;
            margin: 15px 0;
        }
        
        .data-table th {
            background: #4f46e5;
            color: white;
            padding: 10px;
            text-align: left;
            font-size: 10pt;
            font-weight: 600;
        }
        
        .data-table td {
            padding: 10px;
            border-bottom: 1px solid #e5e7eb;
            font-size: 10pt;
        }
        
        .data-table tr:nth-child(even) {
            background: #f9fafb;
        }
        
        /* Financial Summary */
        .finance-summary {
            background: linear-gradient(135deg, #f0fdf4, #dcfce7);
            border: 2px solid #bbf7d0;
            border-radius: 10px;
            padding: 20px;
            margin: 20px 0;
        }
        
        .finance-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 10px;
        }
        
        .finance-row:last-child {
            margin-bottom: 0;
            padding-top: 10px;
            border-top: 2px solid #10b981;
        }
        
        .finance-label {
            font-size: 10pt;
            color: #166534;
        }
        
        .finance-value {
            font-size: 11pt;
            font-weight: 700;
            color: #166534;
        }
        
        /* Signature Section */
        .signature-section {
            margin-top: 50px;
            page-break-inside: avoid;
        }
        
        .signature-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 40px;
            margin-top: 30px;
        }
        
        .signature-box {
            border-top: 1px solid #d1d5db;
            padding-top: 15px;
        }
        
        .signature-title {
            font-size: 10pt;
            font-weight: 700;
            color: #374151;
            margin-bottom: 5px;
        }
        
        .signature-name {
            font-size: 9pt;
            color: #6b7280;
        }
        
        /* Footer */
        .footer {
            margin-top: 40px;
            padding-top: 20px;
            border-top: 1px solid #e5e7eb;
            text-align: center;
            font-size: 8pt;
            color: #9ca3af;
        }
        
        /* Status Badge */
        .status-badge {
            display: inline-block;
            padding: 5px 15px;
            border-radius: 20px;
            font-size: 9pt;
            font-weight: 700;
            text-transform: uppercase;
        }
        
        .status-actif {
            background: #dcfce7;
            color: #16a34a;
            border: 1px solid #bbf7d0;
        }
        
        .status-attente {
            background: #fef3c7;
            color: #d97706;
            border: 1px solid #fde68a;
        }
        
        /* Terms */
        .terms {
            font-size: 9pt;
            color: #4b5563;
            line-height: 1.8;
            text-align: justify;
        }
        
        .terms p {
            margin-bottom: 10px;
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Header avec Logo Sakan -->
        <div class="header">
            <div class="logo">
                <span class="logo-icon"></span>
                SAKAN
            </div>
            <div class="subtitle">Plateforme de Gestion Locative</div>
        </div>

        <!-- Document Title -->
        <div class="document-title">Contrat de Location</div>
        <div class="document-meta">
            Contrat N° <strong>{{ contrat.id }}</strong> | 
            Statut: 
            <span class="status-badge {{ contrat.statut == 'ACTIF' ? 'status-actif' : 'status-attente' }}">
                {{ contrat.statut == 'ACTIF' ? 'Actif' : (contrat.statut == 'PROPOSE' ? 'Proposé' : 'En attente') }}
            </span>
        </div>

        <!-- Partie 1: Les Parties -->
        <div class="section">
            <div class="section-title">1. Les Parties</div>
            
            <div class="party-box">
                <div class="party-title">Propriétaire (Bailleur)</div>
                <div class="info-grid">
                    <div class="info-item">
                        <div class="info-label">Nom complet</div>
                        <div class="info-value">{{ contrat.annonce.proprietaire.nom ?? 'Non spécifié' }}</div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Email</div>
                        <div class="info-value">{{ contrat.annonce.proprietaire.email ?? 'Non spécifié' }}</div>
                    </div>
                </div>
            </div>
            
            <div class="party-box">
                <div class="party-title">Locataire</div>
                <div class="info-grid">
                    <div class="info-item">
                        <div class="info-label">Nom complet</div>
                        <div class="info-value">{{ contrat.locataire.nom ?? 'Non spécifié' }}</div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Email</div>
                        <div class="info-value">{{ contrat.locataire.email ?? 'Non spécifié' }}</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Partie 2: Description du Bien -->
        <div class="section">
            <div class="section-title">2. Description du Bien</div>
            <div class="info-grid">
                <div class="info-item">
                    <div class="info-label">Titre</div>
                    <div class="info-value">{{ contrat.annonce.titre ?? 'Bien #' ~ contrat.annonce.id }}</div>
                </div>
                <div class="info-item">
                    <div class="info-label">Description</div>
                    <div class="info-value">{{ contrat.annonce.description ?? 'Non spécifiée' }}</div>
                </div>
            </div>
        </div>

        <!-- Partie 3: Conditions du Bail -->
        <div class="section">
            <div class="section-title">3. Conditions du Bail</div>
            <div class="info-grid">
                <div class="info-item">
                    <div class="info-label">Date de début</div>
                    <div class="info-value">{{ contrat.dateDebut ? contrat.dateDebut|date('d/m/Y') : 'Non définie' }}</div>
                </div>
                <div class="info-item">
                    <div class="info-label">Date de fin</div>
                    <div class="info-value">{{ contrat.dateFin ? contrat.dateFin|date('d/m/Y') : 'Non définie' }}</div>
                </div>
                <div class="info-item">
                    <div class="info-label">Durée</div>
                    <div class="info-value">{{ contrat.getDureeMois }} mois</div>
                </div>
                <div class="info-item">
                    <div class="info-label">Loyer mensuel</div>
                    <div class="info-value" style="color: #4f46e5; font-size: 14pt;">
                        {{ contrat.montant|number_format(3, ',', ' ') }} TND
                    </div>
                </div>
            </div>
        </div>

        <!-- Partie 4: Récapitulatif Financier -->
        <div class="section">
            <div class="section-title">4. Récapitulatif Financier</div>
            
            <div class="finance-summary">
                <div class="finance-row">
                    <span class="finance-label">Total loyers dûs ({{ contrat.getDureeMois }} mois)</span>
                    <span class="finance-value">{{ dashboard.paiements.total|number_format(3, ',', ' ') }} TND</span>
                </div>
                <div class="finance-row">
                    <span class="finance-label">Charges totales</span>
                    <span class="finance-value">{{ dashboard.charges.total|number_format(3, ',', ' ') }} TND</span>
                </div>
                <div class="finance-row">
                    <span class="finance-label">Caution</span>
                    <span class="finance-value">{{ dashboard.caution ? dashboard.caution.montant_initial|number_format(3, ',', ' ') : '0' }} TND</span>
                </div>
                <div class="finance-row">
                    <span class="finance-label">SOLDE GLOBAL À PAYER</span>
                    <span class="finance-value" style="font-size: 14pt; color: #dc2626;">
                        {{ dashboard.solde_global|number_format(3, ',', ' ') }} TND
                    </span>
                </div>
            </div>
        </div>

        <!-- Partie 5: Historique des Paiements -->
        {% if dashboard.paiements.liste|length > 0 %}
        <div class="section">
            <div class="section-title">5. Historique des Paiements de Loyer</div>
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Période</th>
                        <th>Montant</th>
                        <th>Statut</th>
                        <th>Date de paiement</th>
                    </tr>
                </thead>
                <tbody>
                    {% for paiement in dashboard.paiements.liste %}
                    <tr>
                        <td>{{ paiement.periode ?? 'N/A' }}</td>
                        <td>{{ paiement.montant|number_format(3, ',', ' ') }} TND</td>
                        <td>{{ paiement.statut ?? 'En attente' }}</td>
                        <td>{{ paiement.datePaiement ? paiement.datePaiement|date('d/m/Y') : '-' }}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% endif %}

        <!-- Partie 6: Clauses et Conditions -->
        <div class="section">
            <div class="section-title">6. Clauses et Conditions</div>
            <div class="terms">
                <p><strong>Article 1 - Objet du contrat :</strong> Le présent contrat a pour objet la location du bien décrit ci-dessus, à usage exclusif d'habitation.</p>
                
                <p><strong>Article 2 - Durée :</strong> Le bail est conclu pour une durée de {{ contrat.getDureeMois }} mois, commençant le {{ contrat.dateDebut ? contrat.dateDebut|date('d/m/Y') : '...' }} et se terminant le {{ contrat.dateFin ? contrat.dateFin|date('d/m/Y') : '...' }}.</p>
                
                <p><strong>Article 3 - Loyer :</strong> Le loyer mensuel est fixé à {{ contrat.montant|number_format(3, ',', ' ') }} TND, payable le premier de chaque mois.</p>
                
                <p><strong>Article 4 - Caution :</strong> Une caution de {{ dashboard.caution ? dashboard.caution.montant_initial|number_format(3, ',', ' ') : '...' }} TND est versée à la signature du présent contrat. Elle sera restituée dans les 30 jours suivant la fin du bail, déduction faite des éventuels dommages.</p>
                
                <p><strong>Article 5 - Charges :</strong> Les charges (électricité, eau, internet) sont à la charge exclusive du locataire.</p>
                
                <p><strong>Article 6 - Résiliation :</strong> En cas de résiliation anticipée, un préavis de 30 jours est requis de part et d'autre.</p>
            </div>
        </div>

        <!-- Signatures -->
        <div class="signature-section">
            <div class="section-title">7. Signatures</div>
            <p style="font-size: 9pt; color: #6b7280; margin-bottom: 20px;">
                Les parties déclarent avoir pris connaissance et accepté l'ensemble des clauses du présent contrat. 
                Fait en deux exemplaires à Tunis, le {{ "now"|date('d/m/Y') }}.
            </p>
            
            <div class="signature-grid">
                <div class="signature-box">
                    <div class="signature-title">Le Propriétaire</div>
                    <div class="signature-name">{{ contrat.annonce.proprietaire.nom ?? '...' }}</div>
                    {% if contrat.proprietaireSignatureImage %}
                        <div style="margin-top: 15px;">
                            <img src="{{ contrat.proprietaireSignatureImage }}" style="max-height: 80px; max-width: 100%; border: 1px dashed #d1d5db; padding: 5px;">
                        </div>
                    {% else %}
                        <div style="margin-top: 40px; font-size: 8pt; color: #9ca3af;">Signature précédée de la mention "Bon pour accord"</div>
                    {% endif %}
                </div>
                <div class="signature-box">
                    <div class="signature-title">Le Locataire</div>
                    <div class="signature-name">{{ contrat.locataire.nom ?? '...' }}</div>
                    {% if contrat.locataireSignatureImage %}
                        <div style="margin-top: 15px;">
                            <img src="{{ contrat.locataireSignatureImage }}" style="max-height: 80px; max-width: 100%; border: 1px dashed #d1d5db; padding: 5px;">
                        </div>
                    {% else %}
                        <div style="margin-top: 40px; font-size: 8pt; color: #9ca3af;">Signature précédée de la mention "Bon pour accord"</div>
                    {% endif %}
                </div>
            </div>
        </div>

        <!-- Footer -->
        <div class="footer">
            <p>Document généré automatiquement par la plateforme Sakan</p>
            <p>© {{ "now"|date('Y') }} Sakan - Tous droits réservés</p>
            <p style="margin-top: 10px; font-size: 7pt;">
                Ce document est un contrat numérique reconnu par les parties. 
                Pour toute question, contactez support@sakan.tn
            </p>
        </div>
    </div>
</body>
</html>
