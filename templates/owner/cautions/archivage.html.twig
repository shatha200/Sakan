{% extends 'layouts/base_cautions_owner.html.twig' %}
{% block cautions_content %}

{# ── Stats bar ──────────────────────────────────────────────── #}

<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:16px;margin-bottom:28px;">
    <div style="background:white;border-radius:16px;padding:20px 24px;box-shadow:var(--shadow-card);display:flex;align-items:center;gap:16px;">
        <div style="width:48px;height:48px;border-radius:12px;background:linear-gradient(135deg,#475569,#64748b);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
            <i class="fa-solid fa-box-archive" style="color:white;font-size:20px;"></i>
        </div>
        <div>
            <div style="font-size:12px;color:var(--text-muted);font-weight:500;text-transform:uppercase;letter-spacing:.5px;">Total archivé</div>
            <div style="font-size:26px;font-weight:800;color:var(--text-primary);line-height:1.2;">{{ countTotal }}</div>
        </div>
    </div>
    <div style="background:white;border-radius:16px;padding:20px 24px;box-shadow:var(--shadow-card);display:flex;align-items:center;gap:16px;">
        <div style="width:48px;height:48px;border-radius:12px;background:linear-gradient(135deg,#059669,#34d399);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
            <i class="fa-solid fa-hand-holding-dollar" style="color:white;font-size:20px;"></i>
        </div>
        <div>
            <div style="font-size:12px;color:var(--text-muted);font-weight:500;text-transform:uppercase;letter-spacing:.5px;">Total remboursé</div>
            <div style="font-size:20px;font-weight:800;color:#059669;line-height:1.2;">
                {{ totalRembourse|number_format(3, '.', ' ') }} <span style="font-size:12px;">TND</span>
            </div>
        </div>
    </div>
    <div style="background:white;border-radius:16px;padding:20px 24px;box-shadow:var(--shadow-card);display:flex;align-items:center;gap:16px;">
        <div style="width:48px;height:48px;border-radius:12px;background:linear-gradient(135deg,#d97706,#f59e0b);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
            <i class="fa-solid fa-scissors" style="color:white;font-size:20px;"></i>
        </div>
        <div>
            <div style="font-size:12px;color:var(--text-muted);font-weight:500;text-transform:uppercase;letter-spacing:.5px;">Total retenu</div>
            <div style="font-size:20px;font-weight:800;color:#d97706;line-height:1.2;">
                {{ totalRetenu|number_format(3, '.', ' ') }} <span style="font-size:12px;">TND</span>
            </div>
        </div>
    </div>
</div>

{# ── Search bar - Formulaire GET serveur ────────────────────────────── #}
<form method="get" action="{{ path('caution_archivage') }}" style="background:white;border-radius:14px;padding:16px 20px;margin-bottom:16px;box-shadow:var(--shadow-card);display:flex;align-items:center;gap:12px;flex-wrap:wrap;">
    <i class="fa-solid fa-magnifying-glass" style="color:var(--text-muted);"></i>
    <input name="search" type="text" value="{{ search }}" placeholder="Rechercher par locataire, bien…"
        style="flex:1;min-width:200px;border:none;outline:none;font-size:14px;color:var(--text-primary);background:transparent;">
    
    <select name="statut" onchange="this.form.submit()"
        style="border:1px solid var(--border);border-radius:8px;padding:6px 10px;font-size:13px;color:var(--text-primary);background:white;outline:none;cursor:pointer;">
        <option value="" {{ statutFilter == '' ? 'selected' }}>Tous les statuts</option>
        <option value="TOTALEMENT_REMBOURSE" {{ statutFilter == 'TOTALEMENT_REMBOURSE' ? 'selected' }}>Totalement remboursée</option>
        <option value="PARTIELLEMENT_REMBOURSE" {{ statutFilter == 'PARTIELLEMENT_REMBOURSE' ? 'selected' }}>Partiellement remboursée</option>
        <option value="ABANDONNEE" {{ statutFilter == 'ABANDONNEE' ? 'selected' }}>Abandonnée</option>
        <option value="RETENUE" {{ statutFilter == 'RETENUE' ? 'selected' }}>Retenue</option>
    </select>
    
    <select name="limit" onchange="this.form.submit()"
        style="border:1px solid var(--border);border-radius:8px;padding:6px 10px;font-size:13px;color:var(--text-primary);background:white;outline:none;cursor:pointer;">
        <option value="5" {{ limit == 5 ? 'selected' }}>5 lignes</option>
        <option value="10" {{ limit == 10 ? 'selected' }}>10 lignes</option>
        <option value="20" {{ limit == 20 ? 'selected' }}>20 lignes</option>
        <option value="50" {{ limit == 50 ? 'selected' }}>50 lignes</option>
    </select>
    
    <button type="submit" style="padding:8px 16px;background:linear-gradient(135deg,#6366f1,#8b5cf6);color:white;border:none;border-radius:8px;font-weight:600;cursor:pointer;font-size:13px;">
        <i class="fa-solid fa-filter"></i> Filtrer
    </button>
    
    <a href="{{ path('caution_archivage') }}" style="padding:8px 12px;background:rgba(107,114,128,0.1);color:#374151;border-radius:8px;text-decoration:none;display:inline-flex;align-items:center;">
        <i class="fa-solid fa-rotate-left"></i>
    </a>
</form>

{# ── Tags filtres actifs ─────────────────────────────────────── #}
{% if search or statutFilter %}
<div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px;">
    <span style="font-size:12px;color:#64748b;font-weight:600;text-transform:uppercase;padding:4px 0;">Filtres actifs:</span>
    {% if search %}
        <a href="{{ path('caution_archivage', app.request.query.all|merge({search: null})) }}" style="padding:4px 10px;background:rgba(99,102,241,0.1);color:#6366f1;border-radius:12px;font-size:11px;font-weight:600;text-decoration:none;">
            Recherche: {{ search }} <i class="fa-solid fa-xmark" style="margin-left:4px;"></i>
        </a>
    {% endif %}
    {% if statutFilter %}
        <a href="{{ path('caution_archivage', app.request.query.all|merge({statut: null})) }}" style="padding:4px 10px;background:rgba(99,102,241,0.1);color:#6366f1;border-radius:12px;font-size:11px;font-weight:600;text-decoration:none;">
            Statut: {{ statutFilter|replace({'_': ' '})|capitalize }} <i class="fa-solid fa-xmark" style="margin-left:4px;"></i>
        </a>
    {% endif %}
</div>
{% endif %}

{# ── Table card ─────────────────────────────────────────────── #}
<div style="background:white;border-radius:20px;padding:0;box-shadow:var(--shadow-card);overflow:hidden;">
    <div style="padding:20px 24px;border-bottom:1px solid var(--border);">
        <h3 style="font-size:16px;font-weight:700;margin:0 0 2px;">
            <i class="fa-solid fa-box-archive" style="color:#64748b;margin-right:8px;"></i>
            Historique des cautions
        </h3>
        <p style="font-size:13px;color:var(--text-muted);margin:0;">Cautions dont le statut est différent de DETENU (remboursées, retenues, archivées)</p>
    </div>

    {% if cautions is empty %}
    <div style="padding:60px 24px;text-align:center;color:var(--text-muted);">
        <i class="fa-solid fa-box-archive" style="font-size:48px;opacity:.2;display:block;margin-bottom:16px;"></i>
        <p style="font-size:16px;font-weight:500;margin-bottom:4px;">Aucune caution archivée</p>
        <p style="font-size:13px;">L'historique apparaîtra ici après la finalisation de contrats.</p>
    </div>
    {% else %}
    <div style="overflow-x:auto;">
        <table id="tableArchive" style="width:100%;border-collapse:collapse;">
            <thead>
                <tr>
                    <th style="padding:14px 20px;text-align:left;font-size:12px;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:.5px;background:#f8fafc;border-bottom:1px solid var(--border);">Locataire</th>
                    <th style="padding:14px 20px;text-align:left;font-size:12px;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:.5px;background:#f8fafc;border-bottom:1px solid var(--border);">Bien</th>
                    <th style="padding:14px 20px;text-align:right;font-size:12px;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:.5px;background:#f8fafc;border-bottom:1px solid var(--border);">Initial</th>
                    <th style="padding:14px 20px;text-align:right;font-size:12px;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:.5px;background:#f8fafc;border-bottom:1px solid var(--border);">Retenu</th>
                    <th style="padding:14px 20px;text-align:right;font-size:12px;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:.5px;background:#f8fafc;border-bottom:1px solid var(--border);">Remboursé</th>
                    <th style="padding:14px 20px;text-align:center;font-size:12px;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:.5px;background:#f8fafc;border-bottom:1px solid var(--border);">Fin contrat</th>
                    <th style="padding:14px 20px;text-align:center;font-size:12px;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:.5px;background:#f8fafc;border-bottom:1px solid var(--border);">Statut</th>
                </tr>
            </thead>
            <tbody>
            {% for c in cautions %}
            {% set statut = c.statut_caution|upper %}
            <tr style="border-bottom:1px solid #f1f5f9;transition:background .15s;" onmouseover="this.style.background='#f8fafc'" onmouseout="this.style.background=''">
                <td style="padding:16px 20px;">
                    <div style="display:flex;align-items:center;gap:10px;">
                        <div style="width:34px;height:34px;border-radius:50%;background:linear-gradient(135deg,#475569,#64748b);display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:700;color:white;flex-shrink:0;">
                            {{ c.nom_locataire|first|upper }}
                        </div>
                        <span style="font-weight:600;font-size:14px;color:var(--text-primary);">{{ c.nom_locataire }}</span>
                    </div>
                </td>
                <td style="padding:16px 20px;font-size:14px;color:var(--text-primary);">
                    <i class="fa-solid fa-building" style="color:var(--text-muted);margin-right:6px;font-size:12px;"></i>
                    {{ c.nom_bien }}
                </td>
                <td style="padding:16px 20px;text-align:right;font-size:14px;font-weight:600;color:var(--text-primary);">
                    {{ c.montant_initial|number_format(3, '.', ' ') }} TND
                </td>
                <td style="padding:16px 20px;text-align:right;font-size:14px;">
                    {% if c.montant_retention > 0 %}
                    <span style="color:#d97706;font-weight:600;">{{ c.montant_retention|number_format(3, '.', ' ') }} TND</span>
                    {% else %}
                    <span style="color:var(--text-muted);">—</span>
                    {% endif %}
                </td>
                <td style="padding:16px 20px;text-align:right;font-size:14px;">
                    {% if c.montant_rembourse > 0 %}
                    <span style="color:#059669;font-weight:600;">{{ c.montant_rembourse|number_format(3, '.', ' ') }} TND</span>
                    {% else %}
                    <span style="color:var(--text-muted);">—</span>
                    {% endif %}
                </td>
                <td style="padding:16px 20px;text-align:center;font-size:13px;color:var(--text-muted);">
                    {{ c.date_fin ? c.date_fin|date('d/m/Y') : '—' }}
                </td>
                <td style="padding:16px 20px;text-align:center;">
                    {% if statut == 'TOTALEMENT_REMBOURSE' %}
                    <span style="background:#dcfce7;color:#166534;padding:5px 12px;border-radius:20px;font-size:12px;font-weight:600;display:inline-flex;align-items:center;gap:5px;">
                        <span style="width:6px;height:6px;background:#22c55e;border-radius:50%;"></span>
                        Remboursée
                    </span>
                    {% elseif statut == 'PARTIELLEMENT_REMBOURSE' %}
                    <span style="background:#fef3c7;color:#92400e;padding:5px 12px;border-radius:20px;font-size:12px;font-weight:600;display:inline-flex;align-items:center;gap:5px;">
                        <span style="width:6px;height:6px;background:#f59e0b;border-radius:50%;"></span>
                        Partielle
                    </span>
                    {% elseif statut == 'RETENUE' %}
                    <span style="background:#fce7f3;color:#9d174d;padding:5px 12px;border-radius:20px;font-size:12px;font-weight:600;display:inline-flex;align-items:center;gap:5px;">
                        <span style="width:6px;height:6px;background:#ec4899;border-radius:50%;"></span>
                        Retenue
                    </span>
                    {% else %}
                    <span style="background:#f1f5f9;color:#475569;padding:5px 12px;border-radius:20px;font-size:12px;font-weight:600;">
                        {{ statut|replace({'_': ' '})|capitalize }}
                    </span>
                    {% endif %}
                </td>
            </tr>
            {% endfor %}
            </tbody>
        </table>
        
        {# ── Pagination Pagerfanta ─────────────────────────────────── #}
        {% if pager.nbPages > 1 %}
        <div style="display:flex;justify-content:center;align-items:center;gap:8px;padding:20px;border-top:1px solid var(--border);flex-wrap:wrap;">
            {% if pager.currentPage > 1 %}
                <a href="{{ path('caution_archivage', app.request.query.all|merge({page: pager.currentPage - 1})) }}"
                   style="padding:8px 12px;background:white;border:1px solid #e2e8f0;border-radius:6px;text-decoration:none;color:#374151;font-size:13px;">
                    <i class="fa-solid fa-chevron-left"></i>
                </a>
            {% else %}
                <span style="padding:8px 12px;background:#f1f5f9;border:1px solid #e2e8f0;border-radius:6px;color:#94a3b8;font-size:13px;">
                    <i class="fa-solid fa-chevron-left"></i>
                </span>
            {% endif %}

            {% for page in 1..pager.nbPages %}
                {% if page == pager.currentPage %}
                    <span style="padding:8px 14px;background:#6366f1;color:white;border-radius:6px;font-weight:600;font-size:13px;">
                        {{ page }}
                    </span>
                {% elseif page >= pager.currentPage - 2 and page <= pager.currentPage + 2 %}
                    <a href="{{ path('caution_archivage', app.request.query.all|merge({page: page})) }}"
                       style="padding:8px 14px;background:white;border:1px solid #e2e8f0;border-radius:6px;text-decoration:none;color:#374151;font-size:13px;">
                        {{ page }}
                    </a>
                {% elseif page == 1 or page == pager.nbPages %}
                    <a href="{{ path('caution_archivage', app.request.query.all|merge({page: page})) }}"
                       style="padding:8px 14px;background:white;border:1px solid #e2e8f0;border-radius:6px;text-decoration:none;color:#374151;font-size:13px;">
                        {{ page }}
                    </a>
                {% elseif page == pager.currentPage - 3 or page == pager.currentPage + 3 %}
                    <span style="padding:8px;color:#94a3b8;font-size:13px;">...</span>
                {% endif %}
            {% endfor %}

            {% if pager.currentPage < pager.nbPages %}
                <a href="{{ path('caution_archivage', app.request.query.all|merge({page: pager.currentPage + 1})) }}"
                   style="padding:8px 12px;background:white;border:1px solid #e2e8f0;border-radius:6px;text-decoration:none;color:#374151;font-size:13px;">
                    <i class="fa-solid fa-chevron-right"></i>
                </a>
            {% else %}
                <span style="padding:8px 12px;background:#f1f5f9;border:1px solid #e2e8f0;border-radius:6px;color:#94a3b8;font-size:13px;">
                    <i class="fa-solid fa-chevron-right"></i>
                </span>
            {% endif %}

            <span style="font-size:12px;color:#64748b;margin-left:12px;">
                Page {{ pager.currentPage }} / {{ pager.nbPages }} ({{ pager.nbResults }} résultats)
            </span>
        </div>
        {% endif %}
    </div>
    {% endif %}
</div>

{% endblock %}
