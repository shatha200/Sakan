{% extends 'layouts/base_owner.html.twig' %}

{% block title %}Gestion des Visites — Sakan{% endblock %}
{% block page_title %}Visites{% endblock %}
{% block page_subtitle %}Suivez vos rendez-vous de visites.{% endblock %}

{% block content %}
{# Flash messages #}
{% for label, messages in app.flashes %}
    {% for message in messages %}
        <div class="alert alert-{{ label == 'error' ? 'danger' : label }}" style="padding: 12px 20px; margin-bottom: 20px; border-radius: 12px; background: {{ label == 'success' ? '#d1fae5' : (label == 'error' or label == 'danger' ? '#fee2e2' : '#fef3c7') }}; color: {{ label == 'success' ? '#065f46' : (label == 'error' or label == 'danger' ? '#991b1b' : '#92400e') }}; border: 1px solid {{ label == 'success' ? '#a7f3d0' : (label == 'error' or label == 'danger' ? '#fecaca' : '#fde68a') }};">
            <i class="fa-solid {{ label == 'success' ? 'fa-check-circle' : (label == 'error' or label == 'danger' ? 'fa-exclamation-circle' : 'fa-info-circle') }}"></i> {{ message }}
        </div>
    {% endfor %}
{% endfor %}

<div class="glass-card overflow-hidden" style="background: white; margin-top: 24px;">
    <div style="padding: 24px; border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center;">
        <h2 class="h5 mb-0" style="font-weight: 700; color: var(--blue-dark);">Planning des visites</h2>
        <div style="position: relative;">
            <input type="text" id="tableSearch" placeholder="Filtrer..." 
                   style="border: 1px solid var(--border); padding: 10px 16px; border-radius: 12px; color: var(--text-main); width: 250px;">
            <i class="fa-solid fa-filter" style="position: absolute; right: 16px; top: 12px; opacity: 0.3;"></i>
        </div>
    </div>

    <table class="table" style="width: 100%; border-collapse: collapse; text-align: left;">
        <thead>
            <tr style="background: #f8fafc; border-bottom: 1px solid var(--border);">
                <th style="padding: 20px; font-size: 11px; text-transform: uppercase; color: var(--text-muted); font-weight: 700;">Rendez-vous</th>
                <th style="padding: 20px; font-size: 11px; text-transform: uppercase; color: var(--text-muted); font-weight: 700;">Bien</th>
                <th style="padding: 20px; font-size: 11px; text-transform: uppercase; color: var(--text-muted); font-weight: 700;">Locataire</th>
                <th style="padding: 20px; font-size: 11px; text-transform: uppercase; color: var(--text-muted); font-weight: 700;">Statut</th>
                <th style="padding: 20px; font-size: 11px; text-transform: uppercase; color: var(--text-muted); font-weight: 700; text-align: right;">Action</th>
            </tr>
        </thead>
        <tbody>
            {% for item in visites_data %}
            {% set visite = item.entity %}
            {% set weather = item.weather %}
            <tr class="table-row" style="border-bottom: 1px solid var(--border); transition: all 0.2s;">
                <td style="padding: 20px;">
                    <div style="font-weight: 800; font-size: 15px; color: var(--blue);">{{ visite.dateHeure|date('d/m/Y') }}</div>
                    <div style="font-weight: 600; font-size: 13px; color: var(--text-muted);">{{ visite.dateHeure|date('H:i') }}</div>
                    <div style="margin-top: 8px; font-size: 11px; background: #f0f9ff; color: #0369a1; padding: 4px 8px; border-radius: 4px; display: inline-flex; align-items: center; gap: 4px; border: 1px solid #bae6fd;">
                        {{ weather.icon }} {{ weather.temp }} ({{ weather.desc }})
                    </div>
                </td>
                <td style="padding: 20px;">
                    <div style="font-weight: 700;">{{ visite.annonce.titre }}</div>
                </td>
                <td style="padding: 20px;">
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <i class="fa-solid fa-circle-user" style="color: #cbd5e1; font-size: 20px;"></i>
                        <span style="font-weight: 600;">{{ visite.locataire.nom }}</span>
                    </div>
                </td>
                <td style="padding: 20px;">
                    {% set badge = 'badge-pending' %}
                    {% if visite.statut|lower == 'confirmée' %}{% set badge = 'badge-success' %}{% endif %}
                    {% if visite.statut|lower == 'annulée' %}{% set badge = 'badge-danger' %}{% endif %}
                    <span class="badge-status {{ badge }}">
                        {{ visite.statut }}
                    </span>
                </td>
                <td style="padding: 20px; text-align: right;">
                    <div style="display: flex; gap: 8px; justify-content: flex-end;">
                        {% if visite.statut|lower == 'en attente' or visite.statut|lower == 'demande' %}
                             <form action="{{ path('owner_visite_approve', {'id': visite.id}) }}" method="POST">
                                <button type="submit" class="icon-btn" style="background: #f0fdf4; color: #16a34a; border: none; width: 32px; height: 32px; border-radius: 8px; cursor: pointer;">
                                    <i class="fa-solid fa-check"></i>
                                </button>
                            </form>
                            <form action="{{ path('owner_visite_reject', {'id': visite.id}) }}" method="POST">
                                <button type="submit" class="icon-btn" style="background: #fef2f2; color: #dc2626; border: none; width: 32px; height: 32px; border-radius: 8px; cursor: pointer;">
                                    <i class="fa-solid fa-xmark"></i>
                                </button>
                            </form>
                        {% else %}
                             <span style="color: var(--text-muted); font-size: 11px; font-weight: 700;">TERMINÉ</span>
                        {% endif %}
                    </div>
                </td>
            </tr>
            {% else %}
            <tr>
                <td colspan="5" style="padding: 80px; text-align: center; color: var(--text-muted);">
                    Aucune visite programmée.
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const searchInput = document.getElementById('tableSearch');
        const rows = document.querySelectorAll('.table-row');

        if (searchInput) {
            searchInput.addEventListener('keyup', function(e) {
                const term = e.target.value.toLowerCase();
                rows.forEach(row => {
                    if (row.textContent.toLowerCase().includes(term)) {
                        row.style.display = '';
                    } else {
                        row.style.display = 'none';
                    }
                });
            });
        }
    });
</script>
{% endblock %}
