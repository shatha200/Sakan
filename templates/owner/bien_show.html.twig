{% extends 'layouts/base_owner.html.twig' %}

{% block title %}{{ a.titre }} — Sakan{% endblock %}
{% block page_title %}{{ a.titre }}{% endblock %}
{% block page_subtitle %}Détail du bien{% endblock %}

{% block content %}
{% set statut = a.statut|default('disponible')|lower %}
{% set color = statut == 'occupe' ? '#10b981' : (statut == 'bientot' ? '#d97706' : '#5E17EB') %}
{% set label = statut == 'occupe' ? 'OCCUPÉ' : (statut == 'bientot' ? 'BIENTÔT' : 'DISPONIBLE') %}
{% set _raw_addr = a.bien_adresse ?? a.adresse ?? '' %}
{% set _parts = _raw_addr|split(',')|map(p => p|trim)|filter(p => p != '') %}
{% set adresse_short = _parts|length > 3 ? (_parts|slice(0, 2)|join(', ') ~ ', ' ~ _parts|last) : _parts|join(', ') %}

<div class="sakan-content">

  <div style="margin-bottom:16px;">
    <a href="{{ path('owner_biens') }}" style="color:var(--text-muted);font-size:14px;text-decoration:none;display:inline-flex;align-items:center;gap:6px;">
      <i class="fa-solid fa-arrow-left"></i> Retour à mes biens
    </a>
  </div>

  {% for label_f, messages in app.flashes(['error', 'success']) %}
    {% for message in messages %}
      <div style="padding:12px 16px;border-radius:12px;margin-bottom:16px;background:{{ label_f == 'success' ? '#dcfce7' : '#fee2e2' }};color:{{ label_f == 'success' ? '#166534' : '#991b1b' }};font-weight:600;">{{ message }}</div>
    {% endfor %}
  {% endfor %}

  <div style="display:grid;grid-template-columns:2fr 1fr;gap:24px;">

    <!-- LEFT: gallery + description -->
    <div style="background:white;border-radius:20px;overflow:hidden;box-shadow:var(--shadow-card);">
      <div style="height:5px;background:{{ color }};"></div>
      <div style="position:relative;">
        {% if a.images|length > 0 %}
          <img id="cover-img" data-index="0" src="{{ a.images|first | imagine_filter('annonce_watermark') }}" style="width:100%;height:420px;object-fit:cover;display:block;">
          {% if a.images|length > 1 %}
            <button type="button" onclick="navGallery(-1)" aria-label="Précédente"
                    style="position:absolute;top:50%;left:16px;transform:translateY(-50%);width:46px;height:46px;border-radius:50%;border:none;background:rgba(255,255,255,0.92);color:#5E17EB;font-size:18px;cursor:pointer;box-shadow:0 4px 14px rgba(0,0,0,0.18);display:flex;align-items:center;justify-content:center;transition:all .15s;">
              <i class="fa-solid fa-chevron-left"></i>
            </button>
            <button type="button" onclick="navGallery(1)" aria-label="Suivante"
                    style="position:absolute;top:50%;right:16px;transform:translateY(-50%);width:46px;height:46px;border-radius:50%;border:none;background:rgba(255,255,255,0.92);color:#5E17EB;font-size:18px;cursor:pointer;box-shadow:0 4px 14px rgba(0,0,0,0.18);display:flex;align-items:center;justify-content:center;transition:all .15s;">
              <i class="fa-solid fa-chevron-right"></i>
            </button>
            <div id="gallery-counter" style="position:absolute;bottom:16px;left:16px;background:rgba(0,0,0,0.6);color:white;padding:6px 14px;border-radius:20px;font-size:12px;font-weight:600;">
              1 / {{ a.images|length }}
            </div>
          {% endif %}
        {% else %}
          <div style="width:100%;height:420px;background:#f1f5f9;display:flex;align-items:center;justify-content:center;color:var(--text-muted);"><i class="fa-solid fa-image" style="font-size:48px;"></i></div>
        {% endif %}
        <span style="position:absolute;top:16px;right:16px;background:{{ color }};color:white;padding:6px 14px;border-radius:20px;font-size:12px;font-weight:700;">● {{ label }}</span>
        {% if a.images|length > 0 %}
          <img src="/images/watermark.png" alt="" aria-hidden="true"
               style="position:absolute;bottom:14px;right:14px;width:65px;opacity:0.8;pointer-events:none;z-index:3;filter:drop-shadow(0 2px 4px rgba(0,0,0,0.5));">
        {% endif %}
      </div>
      {% if a.images|length > 1 %}
        <div style="display:flex;gap:8px;padding:12px;overflow-x:auto;background:#f8fafc;">
          {% for img in a.images %}
            <img src="{{ img | imagine_filter('annonce_thumb_watermark') }}" onclick="setGallery({{ loop.index0 }})" data-thumb="{{ loop.index0 }}" style="width:90px;height:70px;object-fit:cover;border-radius:8px;cursor:pointer;border:2px solid {{ loop.first ? '#5E17EB' : 'transparent' }};transition:border-color .15s;">
          {% endfor %}
        </div>
      {% endif %}
      <div style="padding:24px;">
        <h2 style="margin:0 0 6px 0;font-size:22px;font-weight:800;">{{ a.titre }}</h2>
        <p style="margin:0 0 20px 0;color:var(--text-muted);"><i class="fa-solid fa-location-dot"></i> {{ adresse_short ?: '—' }}</p>

        <p style="font-size:13px; color:gray; margin-bottom:6px;">
          Partager cette annonce
        </p>
        <!-- ShareThis BEGINS -->
        <div class="sharethis-share-buttons"
             data-type="inline-share-buttons"
             data-labels="cta"
             data-show_total="false"
             data-size="small"
             data-url="{{ absolute_url(path('tenant_annonce_detail', {id: a.id})) }}"
             data-title="{{ a.titre|e('html_attr') }}"
             data-description="{{ a.description|slice(0, 200)|e('html_attr') }}"
             {% if a.images|length > 0 %}data-image="{{ absolute_url('/' ~ a.images|first) }}"{% endif %}>
            <span data-network="facebook"></span>
            <span data-network="messenger"></span>
            <span data-network="sharethis"></span>
            <span data-network="whatsapp"></span>
        </div>
        <!-- ShareThis ENDS -->

        <h3 style="font-size:14px;font-weight:700;margin:20px 0 8px 0;color:#5E17EB;text-transform:uppercase;letter-spacing:0.5px;">Description</h3>
        <p style="line-height:1.6;color:#334155;white-space:pre-wrap;">{{ a.description }}</p>

        <h3 style="font-size:14px;font-weight:700;margin:16px 0 8px 0;color:#5E17EB;text-transform:uppercase;letter-spacing:0.5px;">Localisation</h3>
        <div id="map-detail" style="height:350px; border-radius:8px;"></div>
        <div id="map-detail-fallback" style="display:none;margin-top:8px;padding:10px 14px;background:#fee2e2;color:#991b1b;border-radius:10px;font-size:13px;">
          <i class="fa-solid fa-triangle-exclamation"></i> Adresse non localisée
        </div>
      </div>
    </div>

    <!-- RIGHT: stats + actions -->
    <div style="display:flex;flex-direction:column;gap:16px;">
      <div style="background:white;border-radius:20px;padding:24px;box-shadow:var(--shadow-card);">
        <div style="font-size:12px;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.5px;margin-bottom:6px;">Loyer mensuel</div>
        <div style="font-size:32px;font-weight:800;color:#5E17EB;">{{ a.prix ? a.prix|number_format(0, ',', ' ') : '—' }} <span style="font-size:14px;color:var(--text-muted);font-weight:600;">TND</span></div>
        {% if a.caution_mois is defined and a.caution_mois %}
          <div style="margin-top:14px;padding-top:14px;border-top:1px solid #f1f5f9;">
            <div style="font-size:12px;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.5px;margin-bottom:4px;"><i class="fa-solid fa-shield-halved"></i> Caution demandée</div>
            <div style="font-size:18px;font-weight:700;color:#334155;">{{ a.caution_mois }} mois <span style="font-size:13px;color:var(--text-muted);font-weight:500;">({{ (a.prix * a.caution_mois)|number_format(0, ',', ' ') }} TND)</span></div>
          </div>
        {% endif %}
      </div>

      <div style="background:white;border-radius:20px;padding:20px;box-shadow:var(--shadow-card);">
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;">
          <div style="text-align:center;padding:12px;background:#f8fafc;border-radius:12px;">
            <i class="fa-solid fa-house" style="color:#5E17EB;font-size:18px;"></i>
            <div style="font-size:14px;font-weight:700;margin-top:6px;">{{ a.bien_type ?: '—' }}</div>
            <div style="font-size:11px;color:var(--text-muted);">type</div>
          </div>
          <div style="text-align:center;padding:12px;background:#f8fafc;border-radius:12px;">
            <i class="fa-solid fa-ruler-combined" style="color:#5E17EB;font-size:18px;"></i>
            <div style="font-size:14px;font-weight:700;margin-top:6px;">{{ a.superficie ?: '—' }} m²</div>
            <div style="font-size:11px;color:var(--text-muted);">surface</div>
          </div>
          <div style="text-align:center;padding:12px;background:#f8fafc;border-radius:12px;">
            <i class="fa-solid fa-bed" style="color:#5E17EB;font-size:18px;"></i>
            <div style="font-size:14px;font-weight:700;margin-top:6px;">{{ a.nombreChambres ?: 0 }}</div>
            <div style="font-size:11px;color:var(--text-muted);">chambres</div>
          </div>
          <div style="text-align:center;padding:12px;background:#f8fafc;border-radius:12px;">
            <i class="fa-solid fa-calendar" style="color:#5E17EB;font-size:18px;"></i>
            <div style="font-size:14px;font-weight:700;margin-top:6px;">{{ a.dateDisponibilite ? a.dateDisponibilite|date('d/m/Y') : 'Imprévue' }}</div>
            <div style="font-size:11px;color:var(--text-muted);">disponibilité</div>
          </div>
        </div>

        {% if statut == 'bientot' and a.total_seconds is defined and a.total_seconds %}
          <div id="detail-countdown" data-seconds="{{ a.total_seconds }}" style="margin-top:14px;padding:16px;background:#fffbeb;border:1.5px solid #fcd34d;border-radius:14px;text-align:center;">
            <div style="font-size:12px;color:#a16207;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:8px;font-weight:600;">
              <i class="fa-solid fa-clock"></i> Sera disponible dans
            </div>
            <div id="cd-display" style="display:flex;justify-content:center;gap:12px;">
              <div style="text-align:center;"><div id="cd-j" style="font-size:28px;font-weight:800;color:#92400e;">{{ a.jours_restants }}</div><div style="font-size:10px;color:#a16207;">jours</div></div>
              <div style="font-size:28px;font-weight:300;color:#d97706;">:</div>
              <div style="text-align:center;"><div id="cd-h" style="font-size:28px;font-weight:800;color:#92400e;">{{ a.heures_restantes }}</div><div style="font-size:10px;color:#a16207;">heures</div></div>
              <div style="font-size:28px;font-weight:300;color:#d97706;">:</div>
              <div style="text-align:center;"><div id="cd-m" style="font-size:28px;font-weight:800;color:#92400e;">{{ a.minutes_restantes }}</div><div style="font-size:10px;color:#a16207;">min</div></div>
              <div style="font-size:28px;font-weight:300;color:#d97706;">:</div>
              <div style="text-align:center;"><div id="cd-s" style="font-size:28px;font-weight:800;color:#92400e;">{{ a.secondes_restantes }}</div><div style="font-size:10px;color:#a16207;">sec</div></div>
            </div>
          </div>
        {% elseif statut == 'bientot' and (a.dateDisponibilite is empty or a.dateDisponibilite is null) %}
          <div style="margin-top:14px;padding:14px 18px;background:#fffbeb;border:1.5px solid #fcd34d;border-radius:14px;text-align:center;font-weight:600;color:#92400e;">
            <i class="fa-solid fa-clock"></i> Date de disponibilité imprévue
          </div>
        {% elseif statut == 'occupe' and a.total_seconds is defined and a.total_seconds %}
          <div id="detail-countdown" data-seconds="{{ a.total_seconds }}" style="margin-top:14px;padding:16px;background:#f1f5f9;border:1.5px solid #e2e8f0;border-radius:14px;text-align:center;">
            <div style="font-size:12px;color:#64748b;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:8px;font-weight:600;">
              <i class="fa-solid fa-clock"></i> Sera visible dans
            </div>
            <div id="cd-display" style="display:flex;justify-content:center;gap:12px;">
              <div style="text-align:center;"><div id="cd-j" style="font-size:28px;font-weight:800;color:#475569;">{{ a.jours_restants }}</div><div style="font-size:10px;color:#64748b;">jours</div></div>
              <div style="font-size:28px;font-weight:300;color:#94a3b8;">:</div>
              <div style="text-align:center;"><div id="cd-h" style="font-size:28px;font-weight:800;color:#475569;">{{ a.heures_restantes }}</div><div style="font-size:10px;color:#64748b;">heures</div></div>
              <div style="font-size:28px;font-weight:300;color:#94a3b8;">:</div>
              <div style="text-align:center;"><div id="cd-m" style="font-size:28px;font-weight:800;color:#475569;">{{ a.minutes_restantes }}</div><div style="font-size:10px;color:#64748b;">min</div></div>
              <div style="font-size:28px;font-weight:300;color:#94a3b8;">:</div>
              <div style="text-align:center;"><div id="cd-s" style="font-size:28px;font-weight:800;color:#475569;">{{ a.secondes_restantes }}</div><div style="font-size:10px;color:#64748b;">sec</div></div>
            </div>
          </div>
        {% endif %}

        {% if a.equipements is defined and a.equipements %}
          <div style="margin-top:14px;padding:12px;background:#faf5ff;border-radius:12px;font-size:13px;color:#5E17EB;">
            <i class="fa-solid fa-couch"></i> {{ a.equipements }}
          </div>
        {% endif %}
      </div>

      <div style="background:white;border-radius:20px;padding:20px;box-shadow:var(--shadow-card);display:flex;flex-direction:column;gap:10px;">
        <a href="{{ path('owner_bien_edit', {id: a.id}) }}" class="btn-primary" style="text-align:center;text-decoration:none;">
          <i class="fa-solid fa-pen-to-square"></i> Modifier
        </a>
        <form method="post" action="{{ path('owner_bien_delete', {id: a.id}) }}" onsubmit="return confirm('Supprimer définitivement ce bien ?');">
          <input type="hidden" name="_token" value="{{ csrf_token('owner_bien_delete_' ~ a.id) }}">
          <button type="submit" class="btn-outline" style="width:100%;color:#dc2626;border-color:#fecaca;">
            <i class="fa-solid fa-trash"></i> Supprimer
          </button>
        </form>
      </div>
    </div>
  </div>

  <!-- SECTION AVIS DES LOCATAIRES -->
  <div style="background:white;border-radius:20px;padding:28px;box-shadow:var(--shadow-card);margin-top:24px;">
    <h2 style="margin:0 0 20px 0;font-size:18px;font-weight:800;">
      <i class="fa-solid fa-star" style="color:#f59e0b;"></i> Avis des locataires
    </h2>

    {% if avis_count > 0 %}
      <div style="display:flex;align-items:center;gap:16px;margin-bottom:24px;padding:16px;background:#faf5ff;border-radius:14px;">
        <span style="font-size:36px;font-weight:900;color:#5E17EB;">{{ avis_avg }}</span>
        <div>
          <div style="color:#f59e0b;font-size:20px;letter-spacing:2px;">
            {% for i in 1..5 %}
              {% if avis_avg >= i %}
                <i class="fa-solid fa-star"></i>
              {% elseif avis_avg >= i - 0.5 %}
                <i class="fa-solid fa-star-half-stroke"></i>
              {% else %}
                <i class="fa-regular fa-star"></i>
              {% endif %}
            {% endfor %}
          </div>
          <span style="color:var(--text-muted);font-weight:600;font-size:14px;">{{ avis_count }} avis</span>
        </div>
      </div>

      <div style="display:flex;flex-direction:column;gap:16px;">
        {% for avis in avis_list %}
        <div style="display:flex;gap:14px;padding:18px;background:#f8fafc;border-radius:14px;position:relative;">
          {% if avis.is_masked %}
            <div style="position:absolute;top:12px;right:12px;display:flex;align-items:center;gap:6px;padding:4px 10px;border-radius:50px;background:#fee2e2;border:1px solid #fecaca;color:#991b1b;font-size:11px;font-weight:700;">
              <i class="fa-solid fa-ban"></i> Suspendu
            </div>
          {% endif %}
          <div style="width:46px;height:46px;border-radius:50%;background:linear-gradient(135deg,#5E17EB,#4a11c7);color:white;display:flex;align-items:center;justify-content:center;font-size:18px;font-weight:700;flex-shrink:0;">
            {{ avis.auteur_nom|first|upper }}
          </div>
          <div style="flex:1;">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:4px;">
              <strong style="font-size:14px;">{{ avis.auteur_nom ?: 'Anonyme' }}</strong>
              <span style="color:var(--text-muted);font-size:12px;font-weight:600;">{{ avis.date_creation|date('d/m/Y') }}</span>
            </div>
            <div style="color:#f59e0b;font-size:13px;margin-bottom:6px;">
              {% for i in 1..5 %}
                <i class="fa-{{ i <= avis.note ? 'solid' : 'regular' }} fa-star"></i>
              {% endfor %}
            </div>
            {% if avis.is_masked %}
              <p style="margin:0;font-style:italic;color:#94a3b8;font-size:14px;display:flex;align-items:center;gap:8px;">
                <i class="fa-solid fa-eye-slash"></i> Commentaire masqué — contenu inapproprié détecté, en attente de modération.
              </p>
            {% else %}
              <p style="margin:0;font-style:italic;color:#334155;font-size:14px;line-height:1.5;">{{ avis.commentaire }}</p>
            {% endif %}
          </div>
        </div>
        {% endfor %}
      </div>
    {% else %}
      <p style="color:var(--text-muted);text-align:center;padding:20px 0;">Aucun avis pour le moment.</p>
    {% endif %}
  </div>

</div>

<script>
  (function() {
    const images = [{% for img in a.images %}{{ (img | imagine_filter('annonce_watermark'))|json_encode|raw }}{% if not loop.last %},{% endif %}{% endfor %}];
    const total = images.length;
    if (total === 0) return;
    const cover = document.getElementById('cover-img');
    const counter = document.getElementById('gallery-counter');
    let idx = 0;

    window.setGallery = function(i) {
      idx = ((i % total) + total) % total;
      cover.src = images[idx];
      cover.dataset.index = idx;
      if (counter) counter.textContent = (idx + 1) + ' / ' + total;
      document.querySelectorAll('[data-thumb]').forEach(t => {
        t.style.borderColor = parseInt(t.dataset.thumb) === idx ? '#5E17EB' : 'transparent';
      });
    };
    window.navGallery = function(delta) { setGallery(idx + delta); };

    document.addEventListener('keydown', e => {
      if (e.key === 'ArrowLeft')  navGallery(-1);
      if (e.key === 'ArrowRight') navGallery(1);
    });
  })();

  // Minuteur temps réel
  (function() {
    const el = document.getElementById('detail-countdown');
    if (!el) return;
    let sec = parseInt(el.dataset.seconds) || 0;
    const jEl = document.getElementById('cd-j');
    const hEl = document.getElementById('cd-h');
    const mEl = document.getElementById('cd-m');
    const sEl = document.getElementById('cd-s');
    if (!jEl || !hEl || !mEl || !sEl) return;

    function pad(n) { return String(n).padStart(2, '0'); }
    const timer = setInterval(function() {
      sec--;
      if (sec <= 0) {
        clearInterval(timer);
        el.style.background = '#dcfce7';
        el.style.borderColor = '#86efac';
        el.innerHTML = '<div style="padding:12px;text-align:center;font-weight:700;color:#166534;font-size:16px;"><i class="fa-solid fa-check-circle"></i> Votre annonce est maintenant disponible ! <a href="" style="color:#166534;text-decoration:underline;">Rafraîchir</a></div>';
        return;
      }
      jEl.textContent = Math.floor(sec / 86400);
      hEl.textContent = pad(Math.floor((sec % 86400) / 3600));
      mEl.textContent = pad(Math.floor((sec % 3600) / 60));
      sEl.textContent = pad(sec % 60);
    }, 1000);
  })();
</script>
{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css">
<link rel="canonical" href="{{ absolute_url(path('tenant_annonce_detail', {id: a.id})) }}">
<meta property="og:type" content="website">
<meta property="og:title" content="{{ a.titre|e('html_attr') }}">
<meta property="og:description" content="{{ a.description|slice(0, 200)|e('html_attr') }}">
<meta property="og:url" content="{{ absolute_url(path('tenant_annonce_detail', {id: a.id})) }}">
{% if a.images|length > 0 %}<meta property="og:image" content="{{ absolute_url('/' ~ a.images|first) }}">{% endif %}
<meta name="twitter:card" content="summary_large_image">
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>
<script>
(function() {
    var mapDiv  = document.getElementById('map-detail');
    var fallbck = document.getElementById('map-detail-fallback');
    if (!mapDiv || typeof L === 'undefined') return;

    var addr  = {{ ((a.bien_adresse ?? a.adresse ?? '')|trim)|json_encode|raw }};
    var titre = {{ (a.titre ?? '')|json_encode|raw }};

    var map = L.map('map-detail', { zoomControl: true }).setView([33.8869, 9.5375], 7);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; OpenStreetMap contributors'
    }).addTo(map);

    // --- Overpass API: nearby places (1km radius) ---
    var nearbyCategories = [
        { label: 'Supermarché',       icon: '🏪', query: 'shop~"supermarket|convenience"' },
        { label: 'Boulangerie',       icon: '🥖', query: 'shop=bakery' },
        { label: 'École',             icon: '🏫', query: 'amenity~"school|university|college"' },
        { label: 'Pharmacie',         icon: '🏥', query: 'amenity=pharmacy' },
        { label: 'Mosquée',           icon: '🕌', query: 'amenity=place_of_worship' },
        { label: 'Arrêt de bus',      icon: '🚌', query: 'highway=bus_stop' },
        { label: 'Banque / ATM',      icon: '🏦', query: 'amenity~"bank|atm"' },
        { label: 'Café / Restaurant', icon: '☕', query: 'amenity~"cafe|restaurant"' }
    ];

    function matchCategory(tags) {
        if (!tags) return null;
        if (tags.shop === 'supermarket' || tags.shop === 'convenience') return nearbyCategories[0];
        if (tags.shop === 'bakery') return nearbyCategories[1];
        if (tags.amenity === 'school' || tags.amenity === 'university' || tags.amenity === 'college') return nearbyCategories[2];
        if (tags.amenity === 'pharmacy') return nearbyCategories[3];
        if (tags.amenity === 'place_of_worship') return nearbyCategories[4];
        if (tags.highway === 'bus_stop') return nearbyCategories[5];
        if (tags.amenity === 'bank' || tags.amenity === 'atm') return nearbyCategories[6];
        if (tags.amenity === 'cafe' || tags.amenity === 'restaurant') return nearbyCategories[7];
        return null;
    }

    function showNearbyLegend() {
        if (document.getElementById('nearby-legend')) return;
        var legend = document.createElement('div');
        legend.id = 'nearby-legend';
        legend.style.cssText = 'display:flex;flex-wrap:wrap;gap:8px;margin-top:10px;padding:10px;background:#f8f9fa;border-radius:8px;font-size:13px;';
        nearbyCategories.forEach(function(cat) {
            var item = document.createElement('span');
            item.style.cssText = 'display:inline-flex;align-items:center;gap:4px;padding:4px 10px;background:white;border-radius:20px;border:1px solid #dee2e6;';
            item.innerHTML = cat.icon + ' ' + cat.label;
            legend.appendChild(item);
        });
        mapDiv.parentNode.insertBefore(legend, mapDiv.nextSibling);
    }

    function showNearbyLoading() {
        if (document.getElementById('nearby-loading')) return;
        var loading = document.createElement('p');
        loading.id = 'nearby-loading';
        loading.style.cssText = 'font-size:13px;color:gray;margin-top:8px;';
        loading.innerText = '📍 Chargement des lieux à proximité...';
        mapDiv.parentNode.insertBefore(loading, mapDiv.nextSibling);
    }
    function hideNearbyLoading() {
        var el = document.getElementById('nearby-loading');
        if (el) el.remove();
    }

    function fetchNearbyPlaces(lat, lon) {
        var radius = 1000;
        var parts = nearbyCategories.map(function(cat) {
            return 'node[' + cat.query + '](around:' + radius + ',' + lat + ',' + lon + ');'
                 + 'way['  + cat.query + '](around:' + radius + ',' + lat + ',' + lon + ');';
        }).join('\n');
        var overpassQuery = '[out:json][timeout:25];(' + parts + ');out center;';
        return fetch('https://overpass-api.de/api/interpreter', {
            method: 'POST',
            body: overpassQuery
        }).then(function(r) { return r.json(); })
          .then(function(data) { return data.elements || []; })
          .catch(function() { return []; });
    }

    function addNearbyMarkers(lat, lon) {
        if (!lat || !lon || lat === 0 || lon === 0) return;
        showNearbyLoading();
        fetchNearbyPlaces(lat, lon).then(function(elements) {
            elements.forEach(function(el) {
                var elLat = el.lat || (el.center && el.center.lat);
                var elLon = el.lon || (el.center && el.center.lon);
                var name  = (el.tags && el.tags.name) ? el.tags.name : 'Sans nom';
                var cat = matchCategory(el.tags);
                if (!cat || !elLat || !elLon) return;
                var icon = L.divIcon({
                    html: '<div style="font-size:20px;filter:drop-shadow(1px 1px 2px rgba(0,0,0,0.4));">' + cat.icon + '</div>',
                    className: '',
                    iconSize: [28, 28],
                    iconAnchor: [14, 14]
                });
                L.marker([elLat, elLon], { icon: icon })
                    .addTo(map)
                    .bindPopup('<strong>' + cat.icon + ' ' + cat.label + '</strong><br>' + name.replace(/</g, '&lt;'));
            });
            if (elements.length > 0) showNearbyLegend();
        }).catch(function() {}).then(function() { hideNearbyLoading(); });
    }
    // --- end Overpass ---

    if (!addr) { if (fallbck) fallbck.style.display = 'block'; return; }

    // Build progressive fallback queries (full → first+last → first part only → governorate only)
    var parts = addr.split(',').map(function(p){ return p.trim(); }).filter(function(p){ return p.length > 0; });
    var queries = [addr];
    if (parts.length > 3) {
        queries.push(parts[0] + ', ' + parts[parts.length - 1]);
    }
    if (parts.length > 0) {
        queries.push(parts[0]);
        queries.push(parts[parts.length - 1]);
    }

    function tryGeocode(i) {
        if (i >= queries.length) {
            if (fallbck) fallbck.style.display = 'block';
            return;
        }
        fetch('https://nominatim.openstreetmap.org/search?q=' + encodeURIComponent(queries[i]) + '&countrycodes=tn&format=json&limit=1', {
            headers: { 'User-Agent': 'SakanApp/1.0 (esprit.tn)' }
        })
        .then(function(r) { return r.json(); })
        .then(function(results) {
            if (results && results.length > 0) {
                var lat = parseFloat(results[0].lat);
                var lng = parseFloat(results[0].lon);
                map.setView([lat, lng], 14);
                L.marker([lat, lng], { draggable: false })
                    .addTo(map)
                    .bindPopup('<strong>' + titre.replace(/</g,'&lt;') + '</strong><br>' + addr.replace(/</g,'&lt;'))
                    .openPopup();
                setTimeout(function() { addNearbyMarkers(lat, lng); }, 1000);
            } else {
                tryGeocode(i + 1);
            }
        })
        .catch(function() {
            tryGeocode(i + 1);
        });
    }
    tryGeocode(0);
})();
</script>
<script type="text/javascript" src="https://platform-api.sharethis.com/js/sharethis.js" defer></script>
{% endblock %}
