{% extends 'layouts/base_owner.html.twig' %}

{% block title %}Créer le Contrat — Sakan{% endblock %}
{% block page_title %}Création du Contrat{% endblock %}
{% block page_subtitle %}Finalisez le bail pour la réservation #{{ reservation.id }}{% endblock %}

{% block content %}
<style>
    .mic-btn { display: inline-flex; align-items: center; gap: 6px; padding: 8px 12px; border-radius: 10px; border: 1px solid #e2e8f0; background: #f8fafc; cursor: pointer; font-size: 13px; font-weight: 600; color: #475569; }
    .mic-btn:hover { background: #eef2ff; border-color: #c7d2fe; color: #4338ca; }
    .mic-btn.is-recording { background: #fef2f2; border-color: #fecaca; color: #b91c1c; animation: pulse 1s infinite; }
    @keyframes pulse { 50% { opacity: 0.85; } }
    .field-row { display: flex; gap: 10px; align-items: flex-start; flex-wrap: wrap; }
    .field-row .sakan-input { flex: 1; min-width: 160px; }
</style>

<div class="glass-card" style="max-width: 840px; margin: 24px auto 0; background: white; padding: 32px; border-radius: 24px;">

    <div style="background: #f8fafc; padding: 20px; border-radius: 16px; margin-bottom: 24px;">
        <div style="display: flex; gap: 20px; align-items: center;">
            <div style="width: 80px; height: 80px; border-radius: 12px; background: url('{{ annonce.photoPrincipale ? asset(annonce.photoPrincipale) : asset('images/default-bien.jpg') }}') center/cover;"></div>
            <div>
                <h3 style="margin: 0 0 4px 0;">{{ annonce.titre }}</h3>
                <p style="margin: 0; color: var(--text-muted); font-size: 14px;">Locataire prévu : <strong>{{ reservation.locataire.nom }}</strong></p>
                <p style="margin: 0; color: var(--text-muted); font-size: 14px;">Email : {{ reservation.locataire.email }}</p>
            </div>
        </div>
    </div>

    {% include 'contrat/_clauses_bail.html.twig' with { annonce: annonce, reservation: reservation } only %}

    <form action="{{ path('owner_reservation_creer_contrat', {id: reservation.id}) }}" method="POST" enctype="multipart/form-data" id="form-contrat-reservation">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('contrat_form') }}" id="csrf-token">
        <input type="hidden" id="cin-verified" name="cin_verified" value="0">

        <h3 style="margin-bottom: 16px; color: var(--blue-dark);"><i class="fa-solid fa-user-tie"></i> Identité du propriétaire (signataire)</h3>
        <p style="font-size: 13px; color: #64748b; margin-bottom: 16px;">Saisissez votre prénom et nom (clavier ou <strong>🎤 Parler</strong>). Ils seront enregistrés sur votre profil.</p>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 24px;">
            <div>
                <label style="font-weight: 600; font-size: 14px; margin-bottom: 8px; display: block;">Prénom *</label>
                <div class="field-row">
                    <input type="text" name="prenom_proprietaire" id="prenom-proprio" class="sakan-input" required autocomplete="given-name" placeholder="Prénom" style="width: 100%; box-sizing: border-box; padding: 12px; border-radius: 8px; border: 1px solid var(--border);">
                    <button type="button" class="mic-btn" id="btn-speech-prenom" title="Dictée vocale"><i class="fa-solid fa-microphone"></i> Parler</button>
                </div>
            </div>
            <div>
                <label style="font-weight: 600; font-size: 14px; margin-bottom: 8px; display: block;">Nom *</label>
                <div class="field-row">
                    <input type="text" name="nom_proprietaire" id="nom-proprio" class="sakan-input" required autocomplete="family-name" placeholder="Nom" style="width: 100%; box-sizing: border-box; padding: 12px; border-radius: 8px; border: 1px solid var(--border);">
                    <button type="button" class="mic-btn" id="btn-speech-nom" title="Dictée vocale"><i class="fa-solid fa-microphone"></i> Parler</button>
                </div>
            </div>
        </div>

        <h3 style="margin-bottom: 16px; color: var(--blue-dark);"><i class="fa-solid fa-file-contract"></i> Conditions du bail</h3>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 24px;">
            <div>
                <label style="font-weight: 600; font-size: 14px; margin-bottom: 8px; display: block;">Date de début *</label>
                <input type="datetime-local" name="date_debut" class="sakan-input" required
                       value="{{ reservation.dateDebut ? reservation.dateDebut|date('Y-m-d\\TH:i') : '' }}"
                       style="width: 100%; box-sizing: border-box;">
            </div>
            <div>
                <label style="font-weight: 600; font-size: 14px; margin-bottom: 8px; display: block;">Date de fin *</label>
                <input type="datetime-local" name="date_fin" class="sakan-input" required
                       value="{{ reservation.dateFin ? reservation.dateFin|date('Y-m-d\\TH:i') : '' }}"
                       style="width: 100%; box-sizing: border-box;">
            </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 24px;">
            <div>
                <label style="font-weight: 600; font-size: 14px; margin-bottom: 8px; display: block;">Loyer mensuel (TND) * <span style="font-weight:400;color:#64748b;">(annonce)</span></label>
                <input type="number" step="0.01" name="montant" class="sakan-input" required
                       value="{{ annonce.prix }}"
                       style="width: 100%; box-sizing: border-box;">
            </div>
            <div>
                <label style="font-weight: 600; font-size: 14px; margin-bottom: 8px; display: block;">Caution (TND) *</label>
                <div class="field-row">
                    <input type="number" step="0.01" name="caution_montant" id="caution-montant" class="sakan-input" required placeholder="ex: 1500"
                           style="width: 100%; box-sizing: border-box;">
                    <button type="button" class="mic-btn" id="btn-speech-caution" title="Dictée du montant"><i class="fa-solid fa-microphone"></i> Parler</button>
                </div>
                <p style="font-size: 12px; color: var(--text-muted); margin-top: 4px;">Saisie clavier ou vocale (ex : « mille cinq cents » sera interprété si possible).</p>
            </div>
        </div>

        <hr style="border-top: 1px solid var(--border); margin: 32px 0;">

        <h3 style="margin-bottom: 16px; color: var(--blue-dark);"><i class="fa-solid fa-gavel"></i> Règles de pénalité de retard</h3>
        <div style="background: #fffbeb; border: 1px solid #fde68a; padding: 16px; border-radius: 12px; margin-bottom: 24px;">
            <div style="margin-bottom: 16px;">
                <label style="font-weight: 600; font-size: 14px; margin-bottom: 8px; display: block;">Délai de grâce (Jours)</label>
                <input type="number" name="penalite_jourRemise" class="sakan-input" value="5" min="0" required style="width: 100%; box-sizing: border-box;">
            </div>
            <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 20px;">
                <div>
                    <label style="font-weight: 600; font-size: 14px; margin-bottom: 8px; display: block;">Montant Fixe (TND)</label>
                    <input type="number" step="0.01" name="penalite_montant" class="sakan-input" value="0" min="0" style="width: 100%; box-sizing: border-box;">
                </div>
                <div>
                    <label style="font-weight: 600; font-size: 14px; margin-bottom: 8px; display: block;">% par jour de retard</label>
                    <input type="number" step="0.01" name="penalite_pourcentage" class="sakan-input" value="0" min="0" style="width: 100%; box-sizing: border-box;">
                </div>
                <div>
                    <label style="font-weight: 600; font-size: 14px; margin-bottom: 8px; display: block;">Plafond Maximum (%)</label>
                    <input type="number" step="0.01" name="penalite_plafond" class="sakan-input" value="10" min="0" max="100" style="width: 100%; box-sizing: border-box;">
                </div>
            </div>
        </div>

        <hr style="border-top: 1px solid var(--border); margin: 32px 0;">

        <h3 style="margin-bottom: 16px; color: var(--blue-dark);"><i class="fa-solid fa-id-card"></i> CIN tunisienne (8 chiffres)</h3>
        <div style="margin-bottom: 16px;">
            <label style="font-weight: 600; font-size: 14px; margin-bottom: 8px; display: block;">Numéro CIN *</label>
            <div class="field-row">
                <input type="text" name="cin_proprietaire" id="cin-input" class="sakan-input" placeholder="8 chiffres"
                       maxlength="8" pattern="\d{8}" inputmode="numeric" required
                       style="width: 100%; box-sizing: border-box; padding: 12px; border-radius: 8px; border: 1px solid var(--border);">
                <button type="button" class="mic-btn" id="btn-speech-cin" title="Dictée des chiffres"><i class="fa-solid fa-microphone"></i> Parler</button>
            </div>
            <p style="font-size: 12px; color: var(--text-muted); margin-top: 4px;">Saisissez les 8 chiffres ou dictez-les ; l’OCR comparera avec la photo.</p>
        </div>

        <div style="background: #fffbeb; border: 1px solid #fde68a; border-radius: 12px; padding: 20px; margin-bottom: 24px;">
            <div style="font-size: 14px; font-weight: 600; color: #92400e; margin-bottom: 12px;">
                <i class="fa-solid fa-camera"></i> Photo / scan du CIN *
            </div>
            <p style="font-size: 13px; color: #a16207; margin-bottom: 16px;">
                Téléchargez une image claire de votre CIN. Les 8 chiffres extraits par OCR doivent correspondre au numéro saisi.
            </p>
            <div style="border: 2px dashed #f59e0b; border-radius: 8px; padding: 16px; text-align: center; background: white; cursor: pointer;"
                 onclick="document.getElementById('cin-file').click()" id="ocr-zone">
                <i class="fa-solid fa-upload" style="font-size: 24px; color: #f59e0b; margin-bottom: 8px;"></i>
                <div style="font-size: 13px; color: #6b7280;" id="cin-file-label">Cliquez pour choisir un fichier</div>
                <input type="file" id="cin-file" name="cin_file_proprietaire" accept="image/*" required
                       style="display: none;" onchange="sakanHandleCINUpload(this)">
            </div>
            <div id="ocr-result" style="margin-top: 12px; display: none;">
                <div style="display: flex; align-items: center; gap: 8px; padding: 12px; border-radius: 8px;" id="ocr-message-box">
                    <i id="ocr-icon" class="fa-solid fa-circle-notch fa-spin" style="font-size: 18px;"></i>
                    <div>
                        <div id="ocr-message" style="font-weight: 600; font-size: 13px;">Analyse en cours...</div>
                        <div id="ocr-cin-detected" style="font-size: 12px; color: #6b7280;"></div>
                    </div>
                </div>
            </div>
        </div>

        <hr style="border-top: 1px solid var(--border); margin: 32px 0;">

        <h3 style="margin-bottom: 16px; color: var(--blue-dark);"><i class="fa-solid fa-signature"></i> Signature électronique</h3>
        <div style="margin-bottom: 24px;">
            <div style="border: 2px dashed var(--border); border-radius: 12px; padding: 16px; background: #fafafa;">
                <canvas id="signature-pad" style="width: 100%; height: 200px; background: white; border-radius: 8px; border: 1px solid #e2e8f0; touch-action: none; cursor: crosshair;"></canvas>
                <input type="hidden" name="signature_data" id="signature_data">
                <div style="text-align: right; margin-top: 12px;">
                    <button type="button" class="btn-secondary" onclick="clearSignature()" style="font-size: 12px; padding: 6px 12px;">Effacer</button>
                </div>
            </div>
        </div>

        <div style="display: flex; gap: 16px; margin-top: 32px;">
            <a href="{{ path('owner_reservations') }}" class="btn-secondary" style="flex: 1; text-align: center; text-decoration: none;">Annuler</a>
            <button type="submit" class="btn-primary" style="flex: 2; justify-content: center; background: linear-gradient(135deg, #2563eb, #3b82f6);">
                <i class="fa-solid fa-check-double"></i> Confirmer le contrat
            </button>
        </div>
    </form>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="https://cdn.jsdelivr.net/npm/signature_pad@4.1.5/dist/signature_pad.umd.min.js"></script>
{% include 'contrat/_js_web_speech_ocr.html.twig' with {
    cin_input_id: 'cin-input',
    cin_verified_id: 'cin-verified',
    verified_ok_value: '1'
} %}
<script>
    var signaturePad;
    document.addEventListener('DOMContentLoaded', function () {
        sakanBindSpeech('btn-speech-prenom', 'prenom-proprio', 'text');
        sakanBindSpeech('btn-speech-nom', 'nom-proprio', 'text');
        sakanBindSpeech('btn-speech-caution', 'caution-montant', 'number');
        sakanBindSpeech('btn-speech-cin', 'cin-input', 'cin8');

        var canvas = document.getElementById('signature-pad');
        function resizeCanvas() {
            var ratio = Math.max(window.devicePixelRatio || 1, 1);
            canvas.width = canvas.offsetWidth * ratio;
            canvas.height = canvas.offsetHeight * ratio;
            canvas.getContext('2d').scale(ratio, ratio);
            if (signaturePad) signaturePad.clear();
        }
        window.addEventListener('resize', resizeCanvas);
        resizeCanvas();
        signaturePad = new SignaturePad(canvas, {
            penColor: 'rgb(0, 0, 0)',
            backgroundColor: 'rgb(255, 255, 255)'
        });

        document.getElementById('form-contrat-reservation').addEventListener('submit', function (e) {
            var cinV = document.getElementById('cin-verified');
            var cinInput = document.getElementById('cin-input');
            var prenom = document.getElementById('prenom-proprio');
            var nom = document.getElementById('nom-proprio');
            if (!prenom.value.trim() || !nom.value.trim()) {
                e.preventDefault();
                alert('Veuillez renseigner votre prénom et nom.');
                return false;
            }
            if (!cinInput.value || cinInput.value.length !== 8) {
                e.preventDefault();
                alert('Le CIN doit comporter exactement 8 chiffres.');
                return false;
            }
            if (cinV.value !== '1') {
                e.preventDefault();
                alert('Veuillez téléverser votre CIN et attendre la validation OCR.');
                return false;
            }
            if (signaturePad.isEmpty()) {
                e.preventDefault();
                alert('Veuillez apposer votre signature.');
                return false;
            }
            document.getElementById('signature_data').value = signaturePad.toDataURL();
        });
    });
    function clearSignature() {
        if (signaturePad) signaturePad.clear();
    }
</script>
{% endblock %}
