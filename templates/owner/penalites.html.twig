{% extends 'layouts/base_owner.html.twig' %}
{% block title %}Pénalités — Sakan{% endblock %}
{% block page_title %}<i class="fa-solid fa-file-invoice-dollar" style="color:#6366f1;"></i> Pénalités et Amendes{% endblock %}
{% block page_subtitle %}Gestion et suivi de vos revenus de pénalités de retard{% endblock %}

{% block content %}
<style>
/* Premium Animations & UI */
.fin-hero-kpis { display:grid; grid-template-columns:repeat(auto-fit, minmax(220px, 1fr)); gap:20px; margin-bottom:30px; }
.fin-kpi-card { background:white; border-radius:20px; padding:24px; box-shadow:0 4px 15px rgba(0,0,0,0.03); display:flex; align-items:center; gap:20px; border:1px solid rgba(229,231,235,0.5); transition:all 0.3s cubic-bezier(0.4, 0, 0.2, 1); cursor:default; position:relative; overflow:hidden; }
.fin-kpi-card::before { content:''; position:absolute; top:0; left:0; width:4px; height:100%; }
.fin-kpi-card.green::before { background:#10b981; }
.fin-kpi-card.blue::before { background:#3b82f6; }
.fin-kpi-card.amber::before { background:#f59e0b; }
.fin-kpi-card.red::before { background:#ef4444; }

.fin-kpi-card:hover { transform:translateY(-5px); box-shadow:0 12px 25px rgba(0,0,0,0.08); }
.fin-kpi-icon { width:56px; height:56px; border-radius:16px; display:flex; justify-content:center; align-items:center; font-size:24px; }
.fin-kpi-icon.green { background:rgba(16,185,129,0.1); color:#10b981; }
.fin-kpi-icon.blue { background:rgba(59,130,246,0.1); color:#3b82f6; }
.fin-kpi-icon.amber { background:rgba(245,158,11,0.1); color:#f59e0b; }
.fin-kpi-icon.red { background:rgba(239,68,68,0.1); color:#ef4444; }

.fin-kpi-title { margin:0; font-size:13px; color:#6b7280; font-weight:700; text-transform:uppercase; letter-spacing:0.5px; }
.fin-kpi-value { margin:4px 0 0; font-size:24px; font-weight:800; color:#111827; }
.fin-kpi-value.small { font-size:15px; margin-top:8px; line-height:1.4; color:#374151; }

.fin-main-card { background:white; border-radius:24px; padding:30px; box-shadow:0 10px 30px rgba(0,0,0,0.04); border:1px solid #f3f4f6; position:relative; }
.fin-header-row { display:flex; justify-content:space-between; align-items:center; margin-bottom:24px; flex-wrap:wrap; gap:16px; }

.fin-search-form { display:flex; gap:10px; background:#f9fafb; padding:8px; border-radius:14px; border:1px solid #e5e7eb; transition:border-color 0.2s; }
.fin-search-form:focus-within { border-color:#6366f1; box-shadow:0 0 0 3px rgba(99,102,241,0.1); }
.fin-search-input { border:none; background:transparent; padding:8px 12px; font-size:13px; width:280px; outline:none; color:#374151; }
.fin-search-btn { padding:8px 20px; border-radius:10px; background:#111827; color:white; border:none; font-weight:600; cursor:pointer; font-size:13px; transition:background 0.2s; }
.fin-search-btn:hover { background:#374151; }

.fin-table { width:100%; border-collapse:separate; border-spacing:0; font-size:13px; }
.fin-table th { text-align:left; font-size:12px; text-transform:uppercase; color:#6b7280; font-weight:700; padding:16px; border-bottom:2px solid #f3f4f6; letter-spacing:0.5px; }
.fin-table td { padding:18px 16px; color:#111827; border-bottom:1px solid #f3f4f6; transition:background 0.2s; }
.fin-table tbody tr:hover td { background:rgba(99,102,241,0.02); }
.fin-table tr:last-child td { border-bottom:none; }

.fin-loc-cell { display:flex; flex-direction:column; gap:4px; }
.fin-loc-name { font-weight:700; font-size:14px; }

.fin-pen-amount { background:rgba(99,102,241,0.1); color:#4f46e5; padding:6px 12px; border-radius:8px; font-weight:800; font-size:14px; display:inline-block; }
.fin-retard-days { color:#ef4444; font-weight:700; background:rgba(239,68,68,0.1); padding:4px 8px; border-radius:6px; font-size:12px; }

.fin-badge { padding:6px 14px; border-radius:12px; font-size:11px; font-weight:800; display:inline-flex; align-items:center; gap:6px; text-transform:uppercase; letter-spacing:0.5px; }
.fin-badge.paye { background:#dcfce7; color:#059669; }
.fin-badge.attente { background:#fef3c7; color:#d97706; }

.fin-pagination { display:flex; justify-content:center; gap:6px; margin-top:30px; }
.fin-page-link { width:36px; height:36px; display:flex; align-items:center; justify-content:center; border-radius:10px; font-size:13px; font-weight:700; background:#f9fafb; color:#4b5563; text-decoration:none; border:1px solid #e5e7eb; transition:all 0.2s; }
.fin-page-link:hover { background:#f3f4f6; color:#111827; border-color:#d1d5db; }
.fin-page-link.active { background:#6366f1; color:white; border-color:#6366f1; box-shadow:0 4px 10px rgba(99,102,241,0.3); }

.fin-empty-state { text-align:center; padding:60px 20px; }
.fin-empty-icon { font-size:48px; color:#d1d5db; margin-bottom:16px; }
.fin-empty-text { color:#6b7280; font-size:15px; font-weight:500; }
</style>

<div style="display:flex; flex-direction:column; gap:20px;">

    {# ── KPIs Pénalités ───────────────────────────────────────── #}
    <div class="fin-hero-kpis">
        <div class="fin-kpi-card green">
            <div class="fin-kpi-icon green"><i class="fa-solid fa-sack-dollar"></i></div>
            <div>
                <p class="fin-kpi-title">Total recouvré</p>
                <p class="fin-kpi-value">{{ totalRecouvre|number_format(3, ',', ' ') }} <span style="font-size:14px;color:#6b7280;font-weight:600;">TND</span></p>
            </div>
        </div>

        <div class="fin-kpi-card blue">
            <div class="fin-kpi-icon blue"><i class="fa-solid fa-calendar-check"></i></div>
            <div>
                <p class="fin-kpi-title">Encaissé ce mois</p>
                <p class="fin-kpi-value">{{ totalMois|number_format(3, ',', ' ') }} <span style="font-size:14px;color:#6b7280;font-weight:600;">TND</span></p>
            </div>
        </div>

        <div class="fin-kpi-card amber">
            <div class="fin-kpi-icon amber"><i class="fa-solid fa-clock-rotate-left"></i></div>
            <div>
                <p class="fin-kpi-title">Retards urgents</p>
                <p class="fin-kpi-value">{{ nbRetards }}</p>
            </div>
        </div>

        <div class="fin-kpi-card red">
            <div class="fin-kpi-icon red"><i class="fa-solid fa-house-circle-exclamation"></i></div>
            <div>
                <p class="fin-kpi-title">Propriété critique</p>
                <p class="fin-kpi-value small">{{ pireBien|default('Aucune alerte active') }}</p>
            </div>
        </div>
    </div>

    {# ── Table Historique des pénalités ───────────────────────── #}
    <div class="fin-main-card">
        <div class="fin-header-row">
            <h3 style="font-size:18px;font-weight:800;margin:0;color:#111827;display:flex;align-items:center;gap:10px;">
                <div style="background:#e0e7ff;color:#4f46e5;width:32px;height:32px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:14px;">
                    <i class="fa-solid fa-list-check"></i>
                </div>
                Registre des Pénalités
            </h3>
            
            <form method="GET" action="{{ path('owner_penalites') }}" class="fin-search-form">
                <i class="fa-solid fa-magnifying-glass" style="color:#9ca3af;margin:10px 0 0 12px;"></i>
                <input type="text" name="search" value="{{ search }}" class="fin-search-input" placeholder="Rechercher par propriété ou locataire...">
                <button type="submit" class="fin-search-btn">Rechercher</button>
            </form>
        </div>

        {% if historique is empty %}
            <div class="fin-empty-state">
                <i class="fa-solid fa-shield-check fin-empty-icon"></i>
                <p class="fin-empty-text">Merveilleux ! Aucune pénalité n'a été trouvée avec ces critères.</p>
                {% if search %}<a href="{{ path('owner_penalites') }}" style="color:#6366f1;font-weight:600;text-decoration:none;margin-top:10px;display:inline-block;"><i class="fa-solid fa-arrow-left"></i> Réinitialiser la recherche</a>{% endif %}
            </div>
        {% else %}
            <div style="overflow-x:auto;">
                <table class="fin-table">
                    <thead>
                        <tr>
                            <th>Locataire</th>
                            <th>Propriété concernée</th>
                            <th>Période</th>
                            <th>Retard</th>
                            <th>Pénalité</th>
                            <th>Statut</th>
                            <th>Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for h in historique %}
                            <tr>
                                <td class="fin-loc-cell">
                                    <span class="fin-loc-name">{{ h.locataire }}</span>
                                </td>
                                <td><span style="background:#f3f4f6;padding:4px 10px;border-radius:6px;font-weight:600;color:#374151;">{{ h.propriete }}</span></td>
                                <td style="color:#6b7280;font-weight:500;">{{ h.periode }}</td>
                                <td><span class="fin-retard-days"><i class="fa-solid fa-arrow-trend-up"></i> {{ h.jours_retard }} j</span></td>
                                <td><div class="fin-pen-amount">+{{ h.penalite|number_format(3, ',', ' ') }} TND</div></td>
                                <td>
                                    {% if h.statut == 'PAYE' %}
                                        <span class="fin-badge paye"><i class="fa-solid fa-check"></i> Encaissée</span>
                                    {% else %}
                                        <span class="fin-badge attente"><i class="fa-solid fa-clock"></i> En attente</span>
                                    {% endif %}
                                </td>
                                <td style="color:#6b7280;font-size:12px;font-weight:600;">{{ h.date_paiement|date('d M. Y') }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            {# Pagination #}
            {% if pages > 1 %}
                <div class="fin-pagination">
                    {% if page > 1 %}
                        <a href="{{ path('owner_penalites', {page: page - 1, search: search}) }}" class="fin-page-link"><i class="fa-solid fa-chevron-left"></i></a>
                    {% endif %}
                    
                    {% for p in 1..pages %}
                        <a href="{{ path('owner_penalites', {page: p, search: search}) }}" class="fin-page-link {% if p == page %}active{% endif %}">
                            {{ p }}
                        </a>
                    {% endfor %}

                    {% if page < pages %}
                        <a href="{{ path('owner_penalites', {page: page + 1, search: search}) }}" class="fin-page-link"><i class="fa-solid fa-chevron-right"></i></a>
                    {% endif %}
                </div>
            {% endif %}
        {% endif %}
    </div>

</div>
{% endblock %}
